// Apps Script web apps cannot read request headers or set an HTTP status, and take only GET and POST. So every call
// is one POST whose body is an envelope:
//   {"method": "GET", "path": "/home", "query": {"lang": "hi"}, "token": "<login token>", "body": null}
// and every answer is HTTP 200 with
//   {"status": <the HTTP status of the answer: 200, 400, 401, ...>, "body": <the answer's JSON>}.
// A write may carry a "request_id": the same id again (the app retrying after a timeout) gets the first answer back;
// for sign-up and login, which carry no token, the same id with the same phone number.
// A GET with no envelope answers /health. appsscript/README.md describes the envelope and every route.

const METHODS_ = ['GET', 'POST', 'PUT', 'DELETE'];
const LOCK_ = true; // the route writes: it runs under the script lock from start to finish
// The route takes the lock itself, around its writes only, and under it looks for the answer a copy of the request (the
// same request id) kept, and keeps its own before letting the lock go (replayed_, keepAnswer_), so two copies arriving
// together write once, as under LOCK_. Its slow steps (a password hash) and its reads of tabs it does not write (who is
// asking, the class, the library) come before the lock, which then holds only the tabs it writes.
const OWN_REPLAY_ = 'own replay';
const REPLAY_S_ = 600; // how long the answer to a write with a request id is kept for a repeat of it
const AUTH_PATHS_ = ['/auth/signup', '/auth/login']; // answered again by the phone number and the request id

class HttpError_ extends Error {
  constructor(status, detail) {
    super(typeof detail === 'string' ? detail : 'validation');
    this.status = status;
    this.detail = detail;
  }
}

/** A plain GET (a browser, an uptime check): the health check, in the envelope. */
function doGet() {
  return reply_(handle_({ method: 'GET', path: '/health', query: {}, token: '', body: null }));
}

function doPost(e) {
  const request = parseEnvelope_(e && e.postData ? e.postData.contents : '');
  return reply_(request.error ? request.error : handle_(request));
}

/** A hand edit to any tab makes the script forget what it cached. */
function onEdit() {
  try {
    bumpCacheGeneration_();
  } catch (err) {
    // a simple trigger must never fail the owner's edit
  }
}

function reply_(envelope) {
  return ContentService.createTextOutput(JSON.stringify(envelope)).setMimeType(ContentService.MimeType.JSON);
}

function parseEnvelope_(text) {
  const bad = (why) => ({ error: { status: 400, body: { detail: 'bad_envelope', why: why } } });
  let env;
  try {
    env = JSON.parse(text || '');
  } catch (err) {
    return bad('not JSON');
  }
  if (env === null || typeof env !== 'object' || Array.isArray(env)) return bad('not an object');
  const method = String(env.method || '').toUpperCase();
  if (METHODS_.indexOf(method) < 0) return bad('method');
  if (typeof env.path !== 'string' || env.path.charAt(0) !== '/') return bad('path');
  const query = {};
  let path = env.path;
  const mark = path.indexOf('?');
  if (mark >= 0) {
    path.slice(mark + 1).split('&').forEach((pair) => {
      if (!pair) return;
      const eq = pair.indexOf('=');
      const key = decodeQuery_(eq < 0 ? pair : pair.slice(0, eq));
      query[key] = decodeQuery_(eq < 0 ? '' : pair.slice(eq + 1));
    });
    path = path.slice(0, mark);
  }
  if (env.query && typeof env.query === 'object') {
    Object.keys(env.query).forEach((key) => {
      let value = env.query[key];
      if (Array.isArray(value)) value = value[value.length - 1];
      if (value !== null && value !== undefined) query[key] = String(value);
    });
  }
  let token = typeof env.token === 'string' ? env.token : '';
  if (token.indexOf('Bearer ') === 0) token = token.slice(7);
  const requestId = typeof env.request_id === 'string' ? env.request_id.trim().slice(0, 64) : '';
  return { method: method, path: path, query: query, token: token.trim(), body: env.body === undefined ? null : env.body, requestId: requestId };
}

function decodeQuery_(text) {
  try {
    return decodeURIComponent(text.replace(/\+/g, ' '));
  } catch (err) {
    return text;
  }
}

function handle_(request) {
  try {
    return { status: 200, body: route_(request) };
  } catch (err) {
    if (err instanceof HttpError_) return { status: err.status, body: { detail: err.detail } };
    console.error('%s %s failed: %s', request.method, request.path, err && err.stack ? err.stack : err);
    return { status: 500, body: { detail: 'Internal Server Error' } };
  }
}

/** [method, path pattern, handler, LOCK_ when the handler writes and holds the lock throughout, or OWN_REPLAY_]. A
 * writing route without LOCK_ takes the lock itself around its writes, to keep a slow step (a password hash) or its
 * reads (a check-in, an intake) out of it; what it writes it reads for the first time under the lock wherever it can. */
function routes_() {
  return [
    ['GET', '/health', health_],
    ['GET', '/studio', studio_],
    ['POST', '/auth/signup', signup_, OWN_REPLAY_],
    ['POST', '/auth/login', login_, OWN_REPLAY_],
    ['POST', '/auth/logout', logout_],
    ['GET', '/me', me_],
    ['POST', '/me', updateMe_, LOCK_],
    ['GET', '/me/intake', myIntake_],
    ['PUT', '/me/intake', saveIntake_],
    ['GET', '/me/practice', myPractice_],
    ['POST', '/me/solo', soloPractice_, OWN_REPLAY_],
    ['GET', '/me/asanas', myItems_],
    ['GET', '/me/asanas/{item}', myItem_],
    ['POST', '/me/shared', shareNote_, OWN_REPLAY_],
    ['POST', '/me/password', changePassword_, OWN_REPLAY_],
    ['GET', '/home', home_],
    ['GET', '/curricula', curricula_],
    ['POST', '/sessions/{session_id}/checkin', checkin_],
    ['POST', '/sessions/{session_id}/practice', sessionPractice_, OWN_REPLAY_],
    ['POST', '/feedback', feedback_, OWN_REPLAY_],
    ['GET', '/teacher/home', teacherHome_],
    ['PUT', '/teacher/sessions/{session_id}', setLink_, LOCK_],
    ['GET', '/teacher/sessions/{session_id}/share', share_],
    ['PUT', '/teacher/sessions/{session_id}/curriculum', setCurriculum_, LOCK_],
    ['PUT', '/teacher/sessions/{session_id}/time', setTime_, LOCK_],
    ['GET', '/teacher/sessions/{session_id}/practice', classReview_],
    ['PUT', '/teacher/settings', updateSettings_, LOCK_],
    ['PUT', '/teacher/batches/{key}', setBatchLink_, LOCK_],
    ['POST', '/teacher/group_code', rotateGroupCode_, LOCK_],
    ['GET', '/teacher/invite', invite_],
    ['GET', '/teacher/students', students_],
    ['POST', '/teacher/students/{user_id}/status', setStatus_, LOCK_],
    ['PUT', '/teacher/students/{user_id}/batch', placeInBatch_, LOCK_],
    ['POST', '/teacher/students/{user_id}/password', resetPassword_, OWN_REPLAY_],
    ['GET', '/teacher/students/{user_id}/asanas', studentItems_],
    ['GET', '/teacher/students/{user_id}/asanas/{item}', studentItem_],
    ['POST', '/teacher/students/{user_id}/feedback', itemFeedback_, LOCK_],
    ['GET', '/teacher/insights', insights_],
    ['GET', '/teacher/shared', sharedNotes_],
  ];
}

function route_(request) {
  const parts = request.path.split('/');
  let pathMatched = false;
  const all = routes_();
  for (let i = 0; i < all.length; i++) {
    const [method, pattern, handler, mode] = all[i];
    const want = pattern.split('/');
    if (want.length !== parts.length) continue;
    const params = {};
    let ok = true;
    for (let j = 0; j < want.length && ok; j++) {
      if (want[j].charAt(0) === '{') {
        params[want[j].slice(1, -1)] = parts[j];
        ok = parts[j] !== '';
      } else {
        ok = want[j] === parts[j];
      }
    }
    if (!ok) continue;
    pathMatched = true;
    if (method !== request.method) continue;
    const ctx = new Context_(request, params);
    if (mode === OWN_REPLAY_) return replayed_(request) || keepingRefusals_(request, () => handler(ctx));
    const run = () => once_(request, () => handler(ctx));
    return mode === LOCK_ ? ctx.lock(run) : run();
  }
  if (pathMatched) throw new HttpError_(405, 'Method Not Allowed');
  throw new HttpError_(404, 'Not Found');
}

/** Runs a write once per request id: a repeat (a retry after a timeout) gets the answer kept from the first time, for
 * REPLAY_S_, instead of writing again. Only answers that succeeded are kept, but for sign-up and login
 * (keepingRefusals_). A route that holds the lock throughout looks inside it, so two copies arriving together write
 * once; an OWN_REPLAY_ route looks again under its own lock. */
function once_(request, fn) {
  return replayed_(request) || keepAnswer_(request, fn());
}

/** Where the answer to a write is kept for a repeat of it: by the login token's hash and the request id; for sign-up
 * and login, which carry no token, by the hash of the phone number, normalised (so "098765 43210" and "+91 98765
 * 43210" are one), and the request id. Null when there is none: a GET, a write without an id, or one without a token
 * other than those two. */
function replayKey_(request) {
  if (request.method === 'GET' || !request.requestId) return null;
  if (AUTH_PATHS_.indexOf(request.path) >= 0) {
    const body = request.body;
    let phone;
    try {
      phone = normalizePhone_(body && typeof body === 'object' && typeof body.phone === 'string' ? body.phone : '');
    } catch (err) {
      return null; // the route answers bad_phone
    }
    return 'req:auth:' + request.path + ':' + sha256Hex_(phone) + ':' + request.requestId;
  }
  return request.token ? 'req:' + sha256Hex_(request.token) + ':' + request.requestId : null;
}

/** The answer kept for a repeat of this request, or null; a refusal kept for it is thrown again. */
function replayed_(request) {
  const key = replayKey_(request);
  const kept = key ? JSON.parse(cache_().get(key) || 'null') : null;
  if (kept && kept.$refused) throw new HttpError_(kept.$refused, kept.detail);
  return kept;
}

/** Sign-up and login keep a refusal for a repeat too (a 4xx, but too_many_attempts, which passes with time; never busy
 * or a 5xx, which may go another way next time), so a retry after a lost answer is not counted as another wrong try. */
function keepingRefusals_(request, fn) {
  try {
    return fn();
  } catch (err) {
    const refusal = err instanceof HttpError_ && err.status >= 400 && err.status < 500 && err.status !== 429;
    if (refusal && AUTH_PATHS_.indexOf(request.path) >= 0) keepAnswer_(request, { $refused: err.status, detail: err.detail });
    throw err;
  }
}

/** Keeps `answer` for a repeat of this request (an OWN_REPLAY_ route does so under its lock, before letting it go);
 * returns it. */
function keepAnswer_(request, answer) {
  const key = replayKey_(request);
  if (key) cache_().put(key, JSON.stringify(answer), REPLAY_S_);
  return answer;
}

/** One request: its inputs, its view of the Sheet (each tab read at most once), the time, and the lock. */
class Context_ {
  constructor(request, params) {
    this.request = request;
    this.params = params;
    CACHE_GENERATION_ = null; // read afresh by each request, as each Apps Script execution starts clean
    this.token = request.token;
    this.db = new Db_();
    this.now = Date.now();
    this.locked = false;
    this._user = null;
  }

  /** Runs `fn` holding the script lock; re-entrant. It flushes first: Apps Script may answer a read of a tab from what
   * this execution read of it before (it fetches more than it is asked for, to answer the reads that follow), so a tab
   * read before the lock could come back under it without the rows another request wrote while this one waited (and
   * sign-ups at once would take the same id); a flush sends the next reads to the Sheet. The tabs read before the
   * lock are then read again (unless `keepReads`, for a lock that writes no tab or reads for the first time the ones
   * it writes), and writes are flushed before the lock is let go. A route that writes a tab reads it for the first
   * time under the lock wherever it can, so as not to rest on the flush alone. */
  lock(fn, keepReads) {
    if (this.locked) return fn();
    const lock = LockService.getScriptLock();
    if (!lock.tryLock(LOCK_WAIT_MS_)) throw new HttpError_(503, 'busy');
    this.locked = true;
    try {
      SpreadsheetApp.flush();
      if (!keepReads) {
        this.db.dropAll();
        CACHE_GENERATION_ = null; // and the cache generation, which a write may have moved on while this request waited
      }
      return fn();
    } finally {
      try {
        SpreadsheetApp.flush();
        if (this.db.changedCache) {
          bumpCacheGeneration_();
          this.db.changedCache = false;
        }
      } finally {
        this.locked = false;
        lock.releaseLock();
      }
    }
  }

  /** Checks the path, query and body against their specs (Validate.gs); all problems in one 422. */
  check(spec) {
    const errors = [];
    const out = {};
    if (spec.path) out.path = validateFields_(spec.path, this.params, ['path'], errors);
    if (spec.query) out.query = validateFields_(spec.query, this.request.query, ['query'], errors);
    if (spec.body) out.body = validateBody_(spec.body, this.request.body, errors);
    if (errors.length) throw new HttpError_(422, errors);
    return out;
  }
}

// ---------- Validate: request checks ----------
//
// A failed check is a 422 whose detail is a list of problems, [{"type", "loc", "msg", "input"}]; the app names the
// field from `loc`. The other errors carry a code it translates. Text is not coerced: a number where text is expected
// is an error. Integers may come as "3". Lengths are counted in code points, as the app counts them; they differ
// from JavaScript's length only for characters outside the BMP, such as an emoji, which is one code point.

const LANGS_ = ['en', 'hi', 'mr'];

const F_ = {
  str: (opts) => Object.assign({ type: 'str' }, opts || {}),
  int: (opts) => Object.assign({ type: 'int' }, opts || {}),
  oneOf: (values, opts) => Object.assign({ type: 'enum', values: values }, opts || {}),
  /** A list of objects, each checked against `fields`. */
  list: (fields, opts) => Object.assign({ type: 'list', fields: fields }, opts || {}),
};
const REQUIRED_ = { required: true };

const BODY_ = {
  signup: {
    name: F_.str({ required: true, min: 1, max: 80 }),
    phone: F_.str(REQUIRED_),
    password: F_.str({ required: true, min: 6, max: 200 }),
    role: F_.oneOf(['student', 'teacher'], { def: 'student' }),
    code: F_.str({ def: '' }),
    lang: F_.oneOf(LANGS_, { def: 'en' }),
  },
  login: { phone: F_.str(REQUIRED_), password: F_.str(REQUIRED_) },
  password: { current_password: F_.str(REQUIRED_), new_password: F_.str({ required: true, min: 6, max: 200 }) },
  me: {
    name: F_.str({ min: 1, max: 80, nullable: true, def: null }),
    lang: F_.oneOf(LANGS_, { nullable: true, def: null }),
  },
  checkin: { phase: F_.oneOf(['before', 'after'], REQUIRED_), mood: F_.int({ required: true, ge: 1, le: 5 }) },
  feedback: { screen: F_.str({ required: true, max: 40 }), text: F_.str({ required: true, min: 1, max: 2000 }) },
  // A batch's everyday link: empty or null removes it.
  link: { meet_link: F_.str({ required: true, nullable: true, max: 500 }) },
  // Left out, the group link stays as it is; empty or null removes it.
  settings: { group_link: F_.str({ nullable: true, max: 500 }) },
  place: { batch: F_.str({ required: true, min: 1, max: 40 }), note: F_.str({ nullable: true, def: null, max: 600 }) },
  intake: {
    age: F_.int({ required: true, ge: 5, le: 100 }),
    height_cm: F_.int({ required: true, ge: 80, le: 230 }),
    weight_kg: F_.int({ required: true, ge: 15, le: 250 }),
    food: F_.oneOf(['vegetarian', 'eggetarian', 'non_vegetarian', 'vegan'], REQUIRED_),
    meals: F_.str({ nullable: true, def: null, max: 600 }),
    pain: F_.str({ nullable: true, def: null, max: 100 }),
    pain_note: F_.str({ nullable: true, def: null, max: 600 }),
    ratings: F_.list({
      item: F_.str({ required: true, min: 1, max: 40 }),
      reaction: F_.int({ nullable: true, def: null, ge: 1, le: 4 }),
      pain: F_.int({ def: 0, ge: 0, le: 1 }),
    }, { required: true, max: 20 }),
  },
  status: { status: F_.oneOf(['approved', 'rejected'], REQUIRED_) },
  shared: { text: F_.str({ required: true, min: 1, max: 1000 }) },
  curriculum: { curriculum: F_.str({ required: true, min: 1, max: 40 }) },
  // A class's own start in India ("18:30"), on its own date, and its length: 10 minutes (after class opens as it
  // starts) to 3 hours.
  time: { time: F_.str({ required: true, min: 1, max: 5 }), duration_min: F_.int({ required: true, ge: 10, le: 180 }) },
  itemFeedback: { item: F_.str({ required: true, min: 1, max: 40 }), text: F_.str({ required: true, min: 1, max: 1000 }) },
  practice: {
    entries: F_.list({
      item: F_.str({ required: true, min: 1, max: 40 }),
      reaction: F_.int({ nullable: true, def: null, ge: 1, le: 4 }),
      pain: F_.int({ def: 0, ge: 0, le: 1 }),
      note: F_.str({ nullable: true, def: null, max: 1000 }),
    }, { required: true, max: 60 }),
  },
  solo: {
    minutes: F_.int({ required: true, ge: 0, le: 240 }),
    // When the practice ended, by the phone's clock (ISO 8601): a send that waited for a connection keeps its day.
    ended_at: F_.str({ nullable: true, def: null, max: 40 }),
    entries: F_.list({
      item: F_.str({ required: true, min: 1, max: 40 }),
      hold_s: F_.int({ nullable: true, def: null, ge: 0 }), // the stopwatch's seconds; over an hour is kept as an hour
      reaction: F_.int({ nullable: true, def: null, ge: 1, le: 4 }),
      pain: F_.int({ def: 0, ge: 0, le: 1 }),
      note: F_.str({ nullable: true, def: null, max: 1000 }),
    }, { required: true, max: 60 }),
  },
};

const QUERY_LANG_ = { lang: F_.oneOf(LANGS_, { def: 'en' }) };
// A 422 names the parameter, so they carry their names.
const PATH_SESSION_ = { session_id: F_.int(REQUIRED_) };
const PATH_USER_ = { user_id: F_.int(REQUIRED_) };
const PATH_BATCH_ = { key: F_.str({ required: true, min: 1, max: 40 }) };
const PATH_ITEM_ = { item: F_.str({ required: true, min: 1, max: 40 }) };

function validateBody_(fields, body, errors) {
  if (body === null || body === undefined) {
    errors.push({ type: 'missing', loc: ['body'], msg: 'Field required', input: null });
    return null;
  }
  if (typeof body !== 'object' || Array.isArray(body)) {
    errors.push({ type: 'model_attributes_type', loc: ['body'], msg: 'Input should be a valid dictionary or object to extract fields from', input: body });
    return null;
  }
  return validateFields_(fields, body, ['body'], errors);
}

function validateFields_(fields, source, loc, errors) {
  const out = {};
  Object.keys(fields).forEach((name) => {
    const field = fields[name];
    const where = loc.concat([name]);
    const has = source && Object.prototype.hasOwnProperty.call(source, name) && source[name] !== undefined;
    if (!has) {
      if (field.required) errors.push({ type: 'missing', loc: where, msg: 'Field required', input: source || null });
      else out[name] = field.def;
      return;
    }
    const value = source[name];
    if (value === null && field.nullable) {
      out[name] = null;
      return;
    }
    if (field.type === 'list') {
      out[name] = validateList_(field, value, where, errors);
      return;
    }
    const fromQuery = loc[0] !== 'body'; // query and path values arrive as text
    const result = coerce_(field, value, fromQuery);
    if (result.error) errors.push(Object.assign({ loc: where, input: value }, result.error));
    else out[name] = result.value;
  });
  return out;
}

function validateList_(field, value, loc, errors) {
  if (!Array.isArray(value)) {
    errors.push({ type: 'list_type', loc: loc, msg: 'Input should be a valid list', input: value });
    return null;
  }
  if (field.max !== undefined && value.length > field.max) {
    errors.push({ type: 'too_long', loc: loc, msg: 'List should have at most ' + plural_(field.max, 'item'), input: value, ctx: { max_length: field.max } });
    return null;
  }
  return value.map((item, i) => {
    if (item === null || typeof item !== 'object' || Array.isArray(item)) {
      errors.push({ type: 'model_type', loc: loc.concat([i]), msg: 'Input should be an object', input: item });
      return null;
    }
    return validateFields_(field.fields, item, loc.concat([i]), errors);
  });
}

function coerce_(field, value, fromText) {
  if (field.type === 'str') {
    if (typeof value !== 'string') return { error: { type: 'string_type', msg: 'Input should be a valid string' } };
    const length = Array.from(value).length;
    if (field.min !== undefined && length < field.min) {
      return { error: { type: 'string_too_short', msg: 'String should have at least ' + plural_(field.min, 'character'), ctx: { min_length: field.min } } };
    }
    if (field.max !== undefined && length > field.max) {
      return { error: { type: 'string_too_long', msg: 'String should have at most ' + plural_(field.max, 'character'), ctx: { max_length: field.max } } };
    }
    return { value: value };
  }
  if (field.type === 'enum') {
    if (field.values.indexOf(value) < 0) {
      const names = field.values.map((v) => "'" + v + "'");
      const msg = 'Input should be ' + (names.length > 1 ? names.slice(0, -1).join(', ') + ' or ' + names[names.length - 1] : names[0]);
      return { error: { type: 'literal_error', msg: msg, ctx: { expected: names.join(', ') } } };
    }
    return { value: value };
  }
  if (field.type === 'int') {
    let number;
    if (typeof value === 'number') {
      if (!isFinite(value)) return { error: { type: 'int_type', msg: 'Input should be a finite number' } };
      if (Math.floor(value) !== value) return { error: { type: 'int_from_float', msg: 'Input should be a valid integer, got a number with a fractional part' } };
      number = value;
    } else if (typeof value === 'boolean' && !fromText) {
      number = value ? 1 : 0;
    } else if (typeof value === 'string' && /^\s*[+-]?\d+\s*$/.test(value)) {
      number = parseInt(value, 10);
    } else if (typeof value === 'string') {
      return { error: { type: 'int_parsing', msg: 'Input should be a valid integer, unable to parse string as an integer' } };
    } else {
      return { error: { type: 'int_type', msg: 'Input should be a valid integer' } };
    }
    if (field.ge !== undefined && number < field.ge) {
      return { error: { type: 'greater_than_equal', msg: 'Input should be greater than or equal to ' + field.ge, ctx: { ge: field.ge } } };
    }
    if (field.le !== undefined && number > field.le) {
      return { error: { type: 'less_than_equal', msg: 'Input should be less than or equal to ' + field.le, ctx: { le: field.le } } };
    }
    return { value: number };
  }
  throw new Error('unknown field type ' + field.type);
}

function plural_(n, word) {
  return n + ' ' + word + (n === 1 ? '' : 's');
}

// ---------- Store: one Sheet tab per table ----------
//
// Each tab has a header row; columns are found by header name, so the owner may add columns of her own. Text is
// written with a leading apostrophe, so Sheets keeps "+919876543210", "2E5K7Q" or "=..." exactly as typed instead of
// reading a number, a date or a formula. Times are real date cells (shown in India time); the API sends them as
// UTC ISO-8601 strings. Writes happen under the script lock. Ids are the largest id + 1, worked out under that lock;
// those other rows point at (a person's, a class's) come from a counter that never goes back (newIds_).
// Two types are for cells the owner types by hand: `clock`, a time of day kept as text ("07:00"), and `count`, the
// number a cell starts with, words after it aside ("5 breaths" is 5), null when there is none.
//
// A column marked LATER_ came after the first Sheets were set up, so a tab may not have it yet: it reads as empty, and
// the first write of a value to it adds its header at the end of the tab's header row (Table_.addColumns_), so a live
// Sheet takes the new code without anyone editing headers by hand. setup() adds it too.

const LATER_ = 'later';

const TABLES_ = {
  // A student's batch (a key of the batches tab) and since when; empty until the teacher places them.
  users: [['id', 'int'], ['name', 'text'], ['phone', 'text'], ['role', 'text'], ['status', 'text'], ['pw_hash', 'text'],
    ['lang', 'text'], ['created_at', 'time'], ['batch', 'text?'], ['batch_since', 'time']],
  tokens: [['token_hash', 'text'], ['user_id', 'int'], ['created_at', 'time']],
  // A class of one batch; its own Meet link and curriculum, when set, win over the batch's. `time_set_by` is "teacher"
  // once the teacher gave the class a time of its own, which the batch's time then no longer moves.
  class_sessions: [['id', 'int'], ['batch', 'text'], ['starts_at', 'time'], ['duration_min', 'int'], ['meet_link', 'text?'],
    ['curriculum', 'text?'], ['updated_at', 'time'], ['time_set_by', 'text?', LATER_]],
  // `class` and `class_date` copy the class's batch name and India date, for the owner's queries; the app uses session_id.
  checkins: [['user_id', 'int'], ['session_id', 'int'], ['phase', 'text'], ['mood', 'int'], ['created_at', 'time'],
    ['class', 'text'], ['class_date', 'date']],
  feedback: [['id', 'int'], ['user_id', 'int'], ['screen', 'text'], ['text', 'text'], ['created_at', 'time']],
  shared_notes: [['id', 'int'], ['user_id', 'int'], ['text', 'text'], ['created_at', 'time']],
  settings: [['key', 'text'], ['value', 'text?']],
  // A student's answers about themselves, for the teacher to place them in a batch: health data, hidden, and on the
  // Dashboard only as counts. `pain` like "knee, back".
  intake: [['user_id', 'int'], ['age', 'int'], ['height_cm', 'int'], ['weight_kg', 'int'], ['food', 'text'], ['meals', 'text?'],
    ['pain', 'text?'], ['pain_note', 'text?'], ['updated_at', 'time']],
  // The intake's self-assessment: how each assessment asana went, 1 (not yet) to 4 (at ease), pain 1 for strain or pain.
  intake_ratings: [['user_id', 'int'], ['item', 'text'], ['reaction', 'int'], ['pain', 'int']],
  // Each placement of a student in a batch, and each move between batches: the review history.
  batch_changes: [['id', 'int'], ['student_id', 'int'], ['from', 'text?'], ['to', 'text'], ['note', 'text?'], ['created_at', 'time']],
  // The batches: seeded by setup() from content/studio.json while the tab is empty, then the owner's to edit. `days`
  // like "mon, tue, wed", `time` like "07:00" in India; `curriculum` is its classes' default.
  batches: [['key', 'text'], ['name', 'text'], ['name_hi', 'text'], ['name_mr', 'text'], ['curriculum', 'text'], ['days', 'text'],
    ['time', 'clock'], ['duration_min', 'int'], ['meet_link', 'text?'], ['about', 'text'], ['about_hi', 'text'], ['about_mr', 'text']],
  // The curriculum: seeded by setup() from content/curriculum.json while the tabs are empty, then the owner's to edit.
  library: [['key', 'text'], ['type', 'text'], ['level', 'int'], ['sanskrit', 'text'], ['name', 'text'], ['english', 'text'],
    ['aliases', 'text'], ['source', 'text']],
  curricula: [['key', 'text'], ['name', 'text'], ['name_hi', 'text'], ['name_mr', 'text'], ['level', 'int'], ['about', 'text'],
    ['about_hi', 'text'], ['about_mr', 'text'], ['source', 'text']],
  curriculum_items: [['curriculum', 'text'], ['position', 'int'], ['item', 'text'], ['dose', 'count'], ['unit', 'text'], ['cue', 'text'],
    ['cue_hi', 'text'], ['cue_mr', 'text']],
  // How each item went for a student, in a class (session_id) or on their own (solo_id): reaction 1 (not yet) to 4
  // (at ease), pain 1 for strain or pain, and on their own the stopwatch's seconds (hold_s). `item_name` and `week`
  // (its Monday) copy the item's name and the week, for the owner's queries.
  practice: [['id', 'int'], ['user_id', 'int'], ['session_id', 'int'], ['item', 'text'], ['reaction', 'int'], ['pain', 'int'],
    ['note', 'text?'], ['created_at', 'time'], ['item_name', 'text'], ['week', 'date'], ['solo_id', 'int'], ['hold_s', 'int']],
  // A student's practice on their own; its items are rows of practice with this solo_id. `request_id`, the phone's id
  // for the send, so one sent again days later (the answer kept for a repeat long gone) is still written once.
  solo_sessions: [['id', 'int'], ['user_id', 'int'], ['started_at', 'time'], ['ended_at', 'time'], ['request_id', 'text?', LATER_]],
  // The teacher's word to one student about one item of the library.
  asana_feedback: [['id', 'int'], ['student_id', 'int'], ['item', 'text'], ['text', 'text'], ['created_at', 'time']],
};

const LOCK_WAIT_MS_ = 20000;
const CACHE_TTL_S_ = 600;

/** The Sheet as one request sees it: each tab read once, on first use, and kept in step with this request's writes. */
class Db_ {
  constructor() {
    this._ss = null;
    this.tables = {};
    this._settings = null;
    this.changedCache = false; // set by writes that make cached values stale; the lock bumps the cache generation
  }

  ss() {
    if (!this._ss) this._ss = SpreadsheetApp.getActiveSpreadsheet();
    return this._ss;
  }

  t(name) {
    if (!this.tables[name]) {
      const sheet = this.ss().getSheetByName(name);
      if (!sheet) throw new HttpError_(500, 'not_set_up');
      this.tables[name] = new Table_(sheet, name);
    }
    return this.tables[name];
  }

  /** Forgets every tab read, and the spreadsheet's handle, so the next use reads afresh. */
  dropAll() {
    this._ss = null;
    this.tables = {};
    this._settings = null;
  }

  /** Reads one tab afresh on its next use: under a lock that keeps the other reads, the tab it writes. */
  forget(name) {
    delete this.tables[name];
  }

  settings() {
    if (this._settings) return this._settings;
    const key = cacheKey_('settings');
    const hit = cacheGet_(key);
    if (hit) {
      this._settings = JSON.parse(hit);
    } else {
      const out = {};
      this.t('settings').rows.forEach((r) => {
        if (r.key && r.value !== null && r.value !== '') out[r.key] = r.value;
      });
      this._settings = out;
      cachePut_(key, JSON.stringify(out));
    }
    return this._settings;
  }

  setting(key) {
    const value = this.settings()[key];
    return value === undefined ? null : value;
  }

  /** Under the lock. */
  setSetting(key, value) {
    const table = this.t('settings');
    const row = table.rows.filter((r) => r.key === key)[0];
    if (row) table.update(row, { value: value });
    else table.insert([{ key: key, value: value }]);
    this.settings()[key] = value;
    this.changedCache = true;
  }
}

class Table_ {
  constructor(sheet, name) {
    this.sheet = sheet;
    this.schema = TABLES_[name];
    const values = sheet.getDataRange().getValues();
    const header = values[0].map((h) => String(h).trim());
    this.width = header.length;
    this.cols = {}; // each column's index, but a LATER_ one the tab does not have yet
    this.schema.forEach(([col, , later]) => {
      const i = header.indexOf(col);
      if (i >= 0) this.cols[col] = i;
      else if (later !== LATER_) throw new HttpError_(500, 'not_set_up');
    });
    this.span_();
    this.lastRow = values.length;
    this.rows = [];
    for (let r = 1; r < values.length; r++) {
      const line = values[r];
      if (line.every((v) => v === '' || v === null)) continue;
      const row = { _row: r + 1 };
      this.schema.forEach(([col, type]) => {
        row[col] = decode_(col in this.cols ? line[this.cols[col]] : '', type);
      });
      this.rows.push(row);
    }
  }

  /** The first and last columns the code uses. */
  span_() {
    const indexes = Object.keys(this.cols).map((col) => this.cols[col]);
    this.first = Math.min.apply(null, indexes);
    this.last = Math.max.apply(null, indexes);
  }

  /** The columns of `cols` the tab does not have yet that a write gives a value (encoded, in `lines`): their headers
   * are added at the end of the header row first. Writes are made under the lock, by routes that read the tab first
   * under it, so two requests never add the same column twice. */
  addColumns_(cols, lines) {
    const missing = cols.filter((col) => !(col in this.cols) && lines.some((values) => values[col] !== '' && values[col] !== undefined));
    if (!missing.length) return;
    const at = Math.max(this.sheet.getLastColumn(), this.width) + 1;
    const end = at + missing.length - 1;
    if (end > this.sheet.getMaxColumns()) this.sheet.insertColumnsAfter(this.sheet.getMaxColumns(), end - this.sheet.getMaxColumns());
    this.sheet.getRange(1, at, 1, missing.length).setValues([missing]).setFontWeight('bold');
    missing.forEach((col, i) => {
      this.cols[col] = at - 1 + i;
    });
    this.width = end;
    this.span_();
  }

  nextId() {
    return this.rows.reduce((top, r) => (r.id > top ? r.id : top), 0) + 1;
  }

  /** Appends rows (objects keyed by column name); returns them as stored. */
  insert(objects) {
    if (!objects.length) return [];
    const encoded = objects.map((o) => {
      const values = {};
      this.schema.forEach(([col, type]) => {
        values[col] = encode_(o[col], type);
      });
      return values;
    });
    this.addColumns_(this.schema.map(([col]) => col), encoded);
    const lines = encoded.map((values) => {
      const line = [];
      for (let i = this.first; i <= this.last; i++) line.push('');
      Object.keys(this.cols).forEach((col) => {
        line[this.cols[col] - this.first] = values[col];
      });
      return line;
    });
    const start = this.lastRow + 1;
    const end = start + lines.length - 1;
    const max = this.sheet.getMaxRows();
    if (end > max) this.sheet.insertRowsAfter(max, end - max + 100);
    this.sheet.getRange(start, this.first + 1, lines.length, this.last - this.first + 1).setValues(lines);
    const added = objects.map((o, i) => {
      const row = { _row: start + i };
      this.schema.forEach(([col, type]) => {
        row[col] = decode_(encode_(o[col], type), type, true);
      });
      return row;
    });
    this.rows = this.rows.concat(added);
    this.lastRow = end;
    return added;
  }

  /** Changes some cells of one row, one setValues for each run of neighbouring columns. */
  update(row, changes) {
    const cols = Object.keys(changes);
    const values = {};
    cols.forEach((col) => {
      values[col] = encode_(changes[col], this.schema.filter(([c]) => c === col)[0][1]);
    });
    this.addColumns_(cols, [values]);
    this.write_([{ n: row._row, values: values }], cols.filter((col) => col in this.cols));
    cols.forEach((col) => {
      row[col] = changes[col];
    });
  }

  /** Writes over rows in place: each [row, object] takes the object's values (as insert() writes them), each [row,
   * null] is emptied, as a deleted row would be but without moving the rows below it (an empty row is skipped when
   * the tab is read, and one at the end of the tab is taken again by the next insert). One setValues for each block
   * of neighbouring rows. */
  rewrite(pairs) {
    const entries = pairs.map(([row, o]) => {
      const values = {};
      this.schema.forEach(([col, type]) => {
        values[col] = o ? encode_(o[col], type) : '';
      });
      return { n: row._row, values: values };
    });
    this.addColumns_(this.schema.map(([col]) => col), entries.map((e) => e.values));
    this.write_(entries, Object.keys(this.cols));
    pairs.forEach(([row, o]) => {
      if (o) {
        this.schema.forEach(([col, type]) => {
          row[col] = decode_(encode_(o[col], type), type, true);
        });
      }
    });
    const emptied = pairs.filter(([, o]) => !o).map(([row]) => row);
    this.rows = this.rows.filter((r) => emptied.indexOf(r) < 0);
  }

  /** Writes `entries` ({n: row number, values: {column: encoded value}}, each with every column of `cols`): one
   * setValues for each block of neighbouring rows and neighbouring columns. */
  write_(entries, cols) {
    const at = (col) => this.cols[col];
    const colRuns = runs_(cols.slice().sort((a, b) => at(a) - at(b)), at);
    runs_(entries.slice().sort((a, b) => a.n - b.n), (e) => e.n).forEach((rows) => {
      colRuns.forEach((run) => {
        this.sheet.getRange(rows[0].n, at(run[0]) + 1, rows.length, run.length).setValues(rows.map((e) => run.map((col) => e.values[col])));
      });
    });
  }

  /** Deletes rows, one deleteRows for each run of neighbours, from the bottom up. Sheets keeps at least one row below
   * the frozen header, so a tab about to lose every row it has gets an empty one added at its end first. */
  remove(rows) {
    const gone = rows.map((r) => r._row).sort((a, b) => b - a);
    if (!gone.length) return;
    if (gone.length >= this.sheet.getMaxRows() - 1) this.sheet.insertRowsAfter(this.sheet.getMaxRows(), 1);
    runs_(gone.slice().reverse(), (n) => n).reverse().forEach((run) => this.sheet.deleteRows(run[0], run.length));
    this.rows = this.rows.filter((r) => gone.indexOf(r._row) < 0);
    this.rows.forEach((r) => {
      r._row -= gone.filter((n) => n < r._row).length;
    });
    this.lastRow -= gone.length;
  }
}

/** `list`, in order, cut into runs whose key goes up by one from each item to the next. */
function runs_(list, key) {
  const out = [];
  list.forEach((x) => {
    const run = out[out.length - 1];
    if (run && key(x) === key(run[run.length - 1]) + 1) run.push(x);
    else out.push([x]);
  });
  return out;
}

/** Under the lock: the first of `n` new ids for the users or class_sessions tab, whose ids other rows point at (a
 * login token, a check-in, a practice entry). They come from a counter in the script properties that never goes back:
 * the larger of it and the tab's largest id, + 1. So an id is never given twice: not to the next person after the
 * owner removes someone (whose token a phone may still hold), nor when this request's read of the tab missed a row
 * another request had just written. A Sheet without the counter yet starts it from its largest id. */
function newIds_(ctx, name, n) {
  if (!ctx.locked) throw new Error('newIds_ outside the lock');
  const props = PropertiesService.getScriptProperties();
  const key = 'last_id:' + name;
  const first = Math.max((Number(props.getProperty(key)) || 0) + 1, ctx.db.t(name).nextId());
  if (n > 0) props.setProperty(key, String(first + n - 1));
  return first;
}

function isDate_(v) {
  return Object.prototype.toString.call(v) === '[object Date]';
}

const TEXT_TYPES_ = ['text', 'text?', 'clock'];

function encode_(value, type) {
  if (value === null || value === undefined) return '';
  if (TEXT_TYPES_.indexOf(type) >= 0) return value === '' ? '' : "'" + String(value);
  if (type === 'int' || type === 'count') return Number(value);
  return new Date(Math.floor(value / 1000) * 1000); // time, date: milliseconds since 1970, kept to the second as the API sends them
}

/** A cell as the app's value: text, a number, or milliseconds for times. `own` marks a value just encoded. */
function decode_(value, type, own) {
  if (own && TEXT_TYPES_.indexOf(type) >= 0 && typeof value === 'string' && value.charAt(0) === "'") value = value.slice(1);
  if (type === 'clock') return clockText_(value);
  if (type === 'count') return countOf_(value);
  if (type === 'text' || type === 'text?') {
    if (value === '' || value === null) return type === 'text?' ? null : '';
    return isDate_(value) ? isoTime_(value.getTime()) : String(value);
  }
  if (type === 'int') return value === '' || value === null ? null : Number(value);
  if (value === '' || value === null) return null;
  if (isDate_(value)) return Math.round(value.getTime() / 1000) * 1000;
  if (typeof value === 'number') return Math.round(((value - 25569) * 86400000 - IST_OFFSET_MS_) / 1000) * 1000; // a serial day number
  const parsed = Date.parse(String(value));
  return isNaN(parsed) ? null : parsed;
}

/** A time of day as the Sheet shows it, "07:00": the text as typed; for a cell Sheets took as a time, the time it
 * shows in the spreadsheet's time zone (a time-only cell is dated 30 December 1899, when India's offset was +5:21:10,
 * so its hours and minutes are never worked out from a fixed offset); for a number, what was typed: 7.15 is 07:15,
 * 17.3 is 17:30 and 7 is 07:00, and a number below 1 is a time kept as a fraction of a day (0.75 is 18:00). */
function clockText_(value) {
  if (isDate_(value)) return Utilities.formatDate(value, SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(), 'HH:mm');
  if (typeof value === 'number') {
    const hours = Math.floor(value);
    const hundredths = Math.round((value - hours) * 100);
    // hours.minutes; past .59, hundredths of an hour (7.75 is 07:45)
    const typed = hours * 60 + (hundredths < 60 ? hundredths : Math.round(hundredths * 0.6));
    return clockOf_((value < 1 ? Math.round(value * 1440) : typed) % 1440);
  }
  return value === null ? '' : String(value);
}

/** The number a count cell typed by hand starts with: 5, "5 breaths", "१० श्वास", 2.5 and "2.5 min" are 5, 5, 10, 2.5
 * and 2.5; null for an empty or worded cell ("slowly"). */
function countOf_(value) {
  if (typeof value === 'number') return value >= 0 ? value : null;
  const m = /^\s*(\d+(?:\.\d+)?)/.exec(latinDigits_(value === null ? '' : value));
  return m ? Number(m[1]) : null;
}

// ---------- the cache ----------
// CacheService keeps login-token lookups and the settings for ten minutes. Every key carries a generation; anything
// that could make a cached value wrong (a settings change, a logout, a password reset, a manual edit) starts a new
// generation after its writes are flushed, so no request reads a value older than the last write.

function cache_() {
  return CacheService.getScriptCache();
}

let CACHE_GENERATION_ = null;

function cacheKey_(suffix) {
  if (CACHE_GENERATION_ === null) {
    let gen = cache_().get('gen');
    if (!gen) {
      gen = Utilities.getUuid().slice(0, 8);
      cache_().put('gen', gen, 21600);
    }
    CACHE_GENERATION_ = gen;
  }
  return CACHE_GENERATION_ + ':' + suffix;
}

function bumpCacheGeneration_() {
  CACHE_GENERATION_ = Utilities.getUuid().slice(0, 8);
  cache_().put('gen', CACHE_GENERATION_, 21600);
}

function cacheGet_(key) {
  return cache_().get(key);
}

function cachePut_(key, value) {
  cache_().put(key, value, CACHE_TTL_S_);
}

// ---------- Auth: passwords, login tokens, codes, phone numbers, and the brakes on guessing ----------

// A password is stored as sha256x$<rounds>$<chars>$<salt>$<hash>: `rounds` SHA-256 digests in a row, each over about
// `chars` characters made from the previous digest, the salt and the password. Apps Script has no PBKDF2 and each
// call into Utilities costs a fixed overhead, so the work is put into long inputs rather than many tiny calls (see
// appsscript/README.md for the measured cost). The rounds and length are stored with each hash, so they can be raised
// later without breaking existing passwords.
const HASH_ROUNDS_ = 100;
const HASH_CHARS_ = 131072;
const DUMMY_HASH_ = 'sha256x$' + HASH_ROUNDS_ + '$' + HASH_CHARS_ + '$' + '0'.repeat(32) + '$' + '0'.repeat(64);
const CODE_ALPHABET_ = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no 0/O or 1/I
const ATTEMPT_LIMIT_ = 5;
const ATTEMPT_WINDOW_S_ = 15 * 60;

function digestBytes_(text) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8).map((b) => b & 255);
}

function hex_(bytes) {
  return bytes.map((b) => (b < 16 ? '0' : '') + b.toString(16)).join('');
}

function sha256Hex_(text) {
  return hex_(digestBytes_(text));
}

/** Random bytes from Utilities.getUuid() (java.util.UUID.randomUUID, a SecureRandom): 366 random bits per digest. */
function randomBytes_(n) {
  let out = [];
  while (out.length < n) out = out.concat(digestBytes_(Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid()));
  return out.slice(0, n);
}

function base64Url_(bytes) {
  const abc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
  let out = '';
  for (let i = 0; i < bytes.length; i += 3) {
    const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);
    out += abc[(n >> 18) & 63] + abc[(n >> 12) & 63];
    if (i + 1 < bytes.length) out += abc[(n >> 6) & 63];
    if (i + 2 < bytes.length) out += abc[n & 63];
  }
  return out;
}

/** 32 random bytes as 43 URL-safe characters. The Sheet keeps only their SHA-256. */
function newToken_() {
  return base64Url_(randomBytes_(32));
}

/** A short code people can read out or type. 32 letters, so each random byte gives one letter without bias. */
function newCode_(length) {
  return randomBytes_(length || 6).map((b) => CODE_ALPHABET_[b & 31]).join('');
}

function stretch_(password, salt, rounds, chars) {
  let h = '';
  for (let i = 0; i < rounds; i++) {
    const block = h + salt + password;
    h = sha256Hex_(block.repeat(Math.max(1, Math.floor(chars / block.length))));
  }
  return h;
}

function hashPassword_(password) {
  const salt = hex_(randomBytes_(16));
  return ['sha256x', HASH_ROUNDS_, HASH_CHARS_, salt, stretch_(password, salt, HASH_ROUNDS_, HASH_CHARS_)].join('$');
}

function checkPassword_(password, stored) {
  const parts = String(stored || '').split('$');
  if (parts.length !== 5 || parts[0] !== 'sha256x') return false;
  const rounds = parseInt(parts[1], 10);
  const chars = parseInt(parts[2], 10);
  if (!(rounds > 0 && rounds <= 10000 && chars > 0 && chars <= 4194304)) return false;
  const candidate = stretch_(password, parts[3], rounds, chars);
  const expected = parts[4];
  if (candidate.length !== expected.length) return false;
  let diff = 0; // compare every character, so the time taken does not tell how much matched
  for (let i = 0; i < candidate.length; i++) diff |= candidate.charCodeAt(i) ^ expected.charCodeAt(i);
  return diff === 0;
}

/**
 * The phone number as +<country><number>, so one person always gets one account however they type it:
 * "98765 43210", "098765 43210", "+91 98765 43210", "+91 098765 43210" and "0091 98765 43210" are all +919876543210.
 * A bare 10-digit number, or 11 digits with the trunk prefix 0, is taken as Indian (+91); a number from abroad starts
 * with + and its country code. Devanagari digits count as digits. With [keepZero], a 0 typed after +91 (or 0091) is
 * kept: "+91 098765 43210" is +9109876543210, as an account may be stored. Throws a 400 bad_phone if it is not a
 * plausible phone number.
 */
function normalizePhone_(raw, keepZero) {
  let digits = latinDigits_(raw).replace(/\D/g, '');
  if (digits.indexOf('00') === 0) digits = digits.slice(2); // international prefix
  else if (digits.length === 11 && digits.charAt(0) === '0') digits = digits.slice(1); // Indian trunk prefix
  if (!keepZero && digits.length === 13 && digits.indexOf('910') === 0) digits = '91' + digits.slice(3); // the trunk 0 after +91
  if (digits.length === 10) digits = '91' + digits;
  if (digits.length < 11 || digits.length > 15 || digits.charAt(0) === '0') throw new HttpError_(400, 'bad_phone');
  return '+' + digits;
}

/** A user's stored number as normalizePhone_ reads it, so an account stored as "+910…" still matches "+91…". */
function phoneOf_(user) {
  try {
    return normalizePhone_(user.phone);
  } catch (err) {
    return user.phone;
  }
}

// After ATTEMPT_LIMIT_ failures for one key (a phone number logging in, the teacher code, a number signing up with a
// group code) within the window, that key is refused until the window has passed. Kept in CacheService: an eviction
// only forgets recent failures. Callers hold the script lock.

function attempts_(key) {
  const raw = cache_().get('fail:' + key);
  const now = Date.now();
  return (raw ? JSON.parse(raw) : []).filter((t) => now - t < ATTEMPT_WINDOW_S_ * 1000);
}

function attemptsBlocked_(key) {
  return attempts_(key).length >= ATTEMPT_LIMIT_;
}

function attemptsFail_(key) {
  const list = attempts_(key);
  list.push(Date.now());
  cache_().put('fail:' + key, JSON.stringify(list), ATTEMPT_WINDOW_S_);
}

function attemptsClear_(key) {
  cache_().remove('fail:' + key);
}

// ---------- one account per number ----------
// The users tab, read under the lock, says whether a number has an account. As a second guard, each sign-up also keeps
// its number in the script properties ("phone:+919876543210" → {"id": 12, "at": <ms>}). A number kept there for an
// account the users tab, as read, does not show is refused for PHONE_TRUST_MS_ (a read that missed a sign-up written
// just before it) and forgotten after (the owner deleted the row by hand). The Sheet's menu forgets the numbers of the
// people it removes.

const PHONE_TRUST_MS_ = 6 * 60000; // how long an Apps Script execution may run: no read can miss an older sign-up

function phoneKey_(phone) {
  return 'phone:' + phone;
}

/** Under the lock, once the users tab has shown no account with `phone` (normalised): whether the number is kept for
 * one. An account the users tab shows (with another number, changed by hand) does not keep it. */
function phoneHeld_(ctx, phone, users) {
  const raw = PropertiesService.getScriptProperties().getProperty(phoneKey_(phone));
  let held = null;
  try {
    held = raw ? JSON.parse(raw) : null;
  } catch (err) {
    return false;
  }
  if (!held) return false;
  if (users.rows.some((u) => u.id === held.id) || ctx.now - held.at >= PHONE_TRUST_MS_) return false;
  console.error('signup: account %s keeps this number, but the users tab as read under the lock has no row with its id; refused as taken',
    held.id);
  return true;
}

/** Under the lock, once the sign-up's row is written: keeps its number for it. */
function holdPhone_(ctx, phone, userId) {
  PropertiesService.getScriptProperties().setProperty(phoneKey_(phone), JSON.stringify({ id: userId, at: ctx.now }));
}

/** Under the lock: forgets the numbers kept for `people` (every number, with `everything`). */
function forgetPhones_(people, everything) {
  const props = PropertiesService.getScriptProperties();
  const ids = {};
  const keys = {};
  people.forEach((u) => {
    ids[u.id] = true;
    keys[phoneKey_(phoneOf_(u))] = true;
  });
  props.getKeys().filter((key) => key.indexOf('phone:') === 0).forEach((key) => {
    let id = null;
    try {
      id = JSON.parse(props.getProperty(key)).id;
    } catch (err) {
      // a value typed by hand: forgotten with its number
    }
    if (everything || keys[key] || ids[id] === true) props.deleteProperty(key);
  });
}

// ---------- who is asking ----------

/** The users row with this id, or null. Two rows sharing an id (a row copied by hand, say: ids from newIds_ never
 * repeat) give null, and the execution log says so, so one person's token or a lookup never reaches another. */
function userById_(users, id) {
  const found = users.filter((u) => u.id === id);
  if (found.length > 1) console.error('users: %s rows share the id %s; none of them is used', found.length, id);
  return found.length === 1 ? found[0] : null;
}

function currentUser_(ctx) {
  if (ctx._user) return ctx._user;
  if (!ctx.token) throw new HttpError_(401, 'signed_out');
  const hash = sha256Hex_(ctx.token);
  const key = cacheKey_('t:' + hash);
  let userId = cacheGet_(key);
  if (userId === null || userId === undefined) {
    const row = ctx.db.t('tokens').rows.filter((r) => r.token_hash === hash)[0];
    if (!row) throw new HttpError_(401, 'signed_out');
    userId = String(row.user_id);
    cachePut_(key, userId);
  }
  const user = userById_(ctx.db.t('users').rows, Number(userId));
  if (!user) throw new HttpError_(401, 'signed_out');
  ctx._user = user;
  return user;
}

function teacher_(ctx) {
  const user = currentUser_(ctx);
  if (user.role !== 'teacher') throw new HttpError_(403, 'teacher_only');
  return user;
}

/** An approved student, or the teacher. */
function member_(ctx) {
  const user = currentUser_(ctx);
  if (user.role === 'student' && user.status !== 'approved') throw new HttpError_(403, 'pending');
  return user;
}

/** Under the lock: a new login token for `user`. */
function signIn_(ctx, user) {
  const token = newToken_();
  ctx.db.t('tokens').insert([{ token_hash: sha256Hex_(token), user_id: user.id, created_at: ctx.now }]);
  return { token: token, user: userJson_(user) };
}

function userJson_(u) {
  return { id: u.id, name: u.name, phone: u.phone, role: u.role, status: u.status, lang: u.lang, batch: u.batch || null,
    batch_since: u.batch_since ? isoTime_(u.batch_since) : null };
}

// ---------- Studio: the classes, the weekly rhythm in India time, and the sums over check-ins ----------

const IST_OFFSET_MS_ = 330 * 60000; // India is UTC+5:30 all year
const DAY_MS_ = 86400000;
const DAYS_ = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
const MONTH_NAMES_ = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const CHECKIN_BEFORE_MIN_ = 60; // how early before class the "before" check-in opens
const MEET_CODE_ = /^[a-z]{3}-[a-z]{4}-[a-z]{3}$/i;

/** UTC ISO-8601 to the second: "2026-11-18T02:30:00Z". */
function isoTime_(ms) {
  return new Date(Math.floor(ms / 1000) * 1000).toISOString().replace('.000Z', 'Z');
}

/** The India date of a moment, as a day number (days since 1 Jan 1970). */
function istDay_(ms) {
  return Math.floor((ms + IST_OFFSET_MS_) / DAY_MS_);
}

/** Midnight in India of a day number, as milliseconds. */
function istMidnight_(day) {
  return day * DAY_MS_ - IST_OFFSET_MS_;
}

function istParts_(ms) {
  const d = new Date(ms + IST_OFFSET_MS_);
  return { day: d.getUTCDate(), month: d.getUTCMonth(), weekday: (d.getUTCDay() + 6) % 7, hour: d.getUTCHours(), minute: d.getUTCMinutes() };
}

/** The India date of a moment as ISO 8601: "2026-11-16". */
function istDate_(ms) {
  return new Date(ms + IST_OFFSET_MS_).toISOString().slice(0, 10);
}

/** A number of two digits at least: 7 is "07". */
function pad2_(n) {
  return (n < 10 ? '0' : '') + n;
}

/** Minutes after midnight as a time of day: 420 is "07:00". */
function clockOf_(minutes) {
  return pad2_(Math.floor(minutes / 60)) + ':' + pad2_(minutes % 60);
}

/** Text with its Devanagari digits written as 0-9: "१०" is "10". */
function latinDigits_(text) {
  return String(text).replace(/[०-९]/g, (d) => String(d.charCodeAt(0) - 0x966));
}

/** strftime("%-I:%M %p") in India time: "8:00 AM". */
function istClock_(ms) {
  const p = istParts_(ms);
  return (p.hour % 12 || 12) + ':' + pad2_(p.minute) + ' ' + (p.hour < 12 ? 'AM' : 'PM');
}

/** One language out of a {"en": ..., "hi": ..., "mr": ...} dict, falling back to English. */
function pick_(text, lang) {
  return text[lang] || text.en;
}

/** A link's parts, with or without its https:// (or http://): the host in small letters, the path ("/" when none),
 * the query string and the fragment as written, the query's values by name, and whether it began with http(s)://;
 * null if it is not a web link. */
function linkParts_(text) {
  const m = /^(https?:\/\/)?([a-z0-9-]+(?:\.[a-z0-9-]+)+)(\/[^?#\s]*)?(?:\?([^#\s]*))?(?:#(\S*))?$/i.exec(text);
  if (!m) return null;
  const values = {};
  (m[4] || '').split('&').forEach((pair) => {
    const eq = pair.indexOf('=');
    if (eq > 0) values[pair.slice(0, eq)] = pair.slice(eq + 1);
  });
  return { scheme: Boolean(m[1]), host: m[2].toLowerCase(), path: m[3] || '/', query: m[4] || '', fragment: m[5] || '', values: values };
}

/** The first word of what was pasted that `clean` makes a link of, the punctuation around it aside ("Join:
 * https://meet.google.com/abc-defg-hij."), a word with its http(s):// before any without; else 400 `detail`. */
function firstLink_(raw, clean, detail) {
  const parts = String(raw).trim().split(/\s+/)
    .map((word) => linkParts_(word.replace(/^[("'<[]+|[)"'>\].,;:!?]+$/g, '')))
    .filter(Boolean);
  const ordered = parts.filter((p) => p.scheme).concat(parts.filter((p) => !p.scheme));
  for (let i = 0; i < ordered.length; i++) {
    const link = clean(ordered[i]);
    if (link) return link;
  }
  throw new HttpError_(400, detail);
}

/** A link to a video call, made plain: Google Meet (its code in small letters; g.co/meet/ too), Zoom (a meeting, /j/
 * with its pwd as given, or a personal room, /my/, on any zoom.us address), Microsoft Teams (a meetup-join link as
 * given, or /meet/<id> with its p) or Jitsi Meet, always https. Else 400 bad_meet_link. */
function cleanMeetLink_(raw) {
  return firstLink_(raw, (p) => {
    const path = p.path.replace(/\/+$/, '');
    let m;
    if (p.host === 'meet.google.com' && (m = /^\/([\w-]+)$/.exec(path)) && MEET_CODE_.test(m[1])) return 'https://meet.google.com/' + m[1].toLowerCase();
    if (p.host === 'g.co' && (m = /^\/meet\/([\w-]+)$/i.exec(path))) {
      return MEET_CODE_.test(m[1]) ? 'https://meet.google.com/' + m[1].toLowerCase() : 'https://g.co/meet/' + m[1];
    }
    if (/^([\w-]+\.)*zoom\.us$/.test(p.host)) {
      const pwd = p.values.pwd ? '?pwd=' + p.values.pwd : '';
      if ((m = /^\/j\/(\d+)$/.exec(path))) return 'https://' + p.host + '/j/' + m[1] + pwd;
      if ((m = /^\/my\/([\w.-]+)$/.exec(path))) return 'https://' + p.host + '/my/' + m[1];
    }
    if (p.host === 'teams.microsoft.com' || p.host === 'teams.live.com') {
      if (/^\/l\/meetup-join\/./.test(path)) return 'https://' + p.host + p.path + (p.query ? '?' + p.query : '');
      if ((m = /^\/meet\/(\d+)$/.exec(path))) return 'https://' + p.host + '/meet/' + m[1] + (p.values.p ? '?p=' + p.values.p : '');
    }
    if (p.host === 'meet.jit.si' && (m = /^\/([\w-]+)$/.exec(path))) return 'https://meet.jit.si/' + m[1];
    return null;
  }, 'bad_meet_link');
}

/** The class group's link: a WhatsApp group invite (its code alone, the rest of the address dropped), or any other
 * link as written (a Telegram or Signal group, say), always https. Its address ends in a name of letters (".com",
 * ".me"); without http(s)://, it needs a path or a fragment too ("t.me/x", "signal.group/#…"), so words like
 * "Mr.Sharma", "e.g." or "7.00" are no link. Else 400 bad_group_link. */
function cleanGroupLink_(raw) {
  return firstLink_(raw, (p) => {
    if (!/\.[a-z]{2,}$/.test(p.host) || (!p.scheme && p.path === '/' && !p.fragment)) return null;
    if (p.host === 'chat.whatsapp.com') {
      const m = /^\/(?:invite\/)?([A-Za-z0-9]+)\/?$/.exec(p.path);
      return m ? 'https://chat.whatsapp.com/' + m[1] : null;
    }
    const rest = (p.query ? '?' + p.query : '') + (p.fragment ? '#' + p.fragment : '');
    return 'https://' + p.host + (p.path === '/' && !rest ? '' : p.path) + rest;
  }, 'bad_group_link');
}

/** The batches, from the batches tab, by key: names and words in each language, the default curriculum, the days
 * ("mon"…), the start in minutes after midnight in India, the length and the everyday Meet link. */
function batches_(ctx) {
  const out = {};
  ctx.db.t('batches').rows.forEach((r) => {
    if (!r.key) return;
    out[r.key] = {
      key: r.key,
      name: { en: r.name, hi: r.name_hi || r.name, mr: r.name_mr || r.name },
      about: { en: r.about, hi: r.about_hi || r.about, mr: r.about_mr || r.about },
      curriculum: r.curriculum,
      days: String(r.days || '').split(',').map((d) => d.trim().toLowerCase().slice(0, 3)).filter((d) => DAYS_.indexOf(d) >= 0),
      start_min: startMinutes_(r.time),
      duration_min: r.duration_min || 55,
      meet_link: r.meet_link,
    };
  });
  return out;
}

/** A batch's time as the owner typed it ("07:00", "7.00", "17", "5:30 pm", "7 am", Devanagari digits too) as minutes
 * after midnight in India; null when it is no time (empty while the owner retypes it, "17h30"). */
function startMinutes_(time) {
  const text = latinDigits_(time === null || time === undefined ? '' : time);
  const bare = /^\s*(\d{1,2})\s*$/.exec(text); // "7", "17": the hour alone
  const m = bare || /(\d{1,2})(?:[:.](\d\d))?\s*([ap])?\.?\s*m?\b/i.exec(text);
  if (!m || (!bare && m[2] === undefined && !m[3])) return null;
  const hour = m[3] ? (Number(m[1]) % 12) + (m[3].toLowerCase() === 'p' ? 12 : 0) : Number(m[1]);
  const minute = Number(m[2] || 0);
  return hour < 24 && minute < 60 ? hour * 60 + minute : null;
}

/** A batch for the app, in `lang`: its key, name, words, days and start ("07:00", or null while its time is no time). */
function batchJson_(batch, key, lang) {
  if (!batch) return { key: key, name: key || '', about: '', days: [], time: null };
  return { key: batch.key, name: pick_(batch.name, lang), about: pick_(batch.about, lang), days: batch.days,
    time: batch.start_min === null ? null : clockOf_(batch.start_min) };
}

/** A session for the app. The link is shown only to approved members; without its own link a session uses its batch's
 * everyday link. */
function sessionJson_(row, lang, showLink, batches) {
  const batch = batches[row.batch];
  const link = row.meet_link || (batch && batch.meet_link);
  return {
    id: row.id,
    starts_at: isoTime_(row.starts_at),
    duration_min: row.duration_min,
    batch: batchJson_(batch, row.batch, lang),
    meet_link: showLink ? link || null : null,
    has_link: Boolean(link),
  };
}

function studioJson_(ctx, lang) {
  const teacher = STUDIO.teacher;
  const batches = batches_(ctx);
  return {
    name: pick_(STUDIO.name, lang),
    tagline: pick_(STUDIO.tagline, lang),
    since: STUDIO.since,
    teacher: { name: teacher.name, title: pick_(teacher.title, lang), bio: pick_(teacher.bio, lang) },
    batches: Object.keys(batches).map((key) => batchJson_(batches[key], key, lang)),
  };
}

/** Each batch's classes on its days, over the 7 days from `now`'s India date; none for a batch whose time is no time. */
function weekStarts_(now, batches) {
  const today = istDay_(now);
  const out = [];
  for (let offset = 0; offset < 7; offset++) {
    const day = today + offset;
    const weekday = DAYS_[(day + 3) % 7]; // 1 Jan 1970 was a Thursday
    Object.keys(batches).forEach((key) => {
      const b = batches[key];
      if (b.start_min !== null && b.days.indexOf(weekday) >= 0) {
        out.push({ batch: key, starts_at: istMidnight_(day) + b.start_min * 60000, duration_min: b.duration_min });
      }
    });
  }
  return out;
}

/** Makes the next 7 days' classes match the batches, one class per batch per day. A day without its class gets one.
 * A class whose time or length no longer matches the batch's (the owner changed it) is moved in its row, keeping its
 * id, its own link and its curriculum, when nobody has checked in to it and both its old and its new start are more
 * than an hour away (out of its check-in window, perhaps after its message was shared); otherwise it stays as it is,
 * and the day gets no second class. A class the teacher gave a time of its own (setTime_) keeps it. A class is removed only on a day its batch no longer meets, under the same
 * conditions. A batch whose time is no time (being retyped, say) is left as it is.
 *
 * The classes and check-ins are read for this only under the lock, for the first time in the request: read before
 * it, they could come back under it without the classes another request had just added, which would be added again
 * with the same ids. So that most visits take no lock, a mark in the cache says the week was made, for the day, the
 * batches' days, times and lengths, and the cache generation (which a hand edit or the Sheet's menu moves on); it
 * lasts as the cache does, so a class row deleted by hand (which fires no onEdit) comes back within ten minutes. A
 * visit that cannot have the lock goes on with the classes as they are, rather than answer busy. */
function ensureWeek_(ctx) {
  const batches = batches_(ctx);
  const wanted = weekStarts_(ctx.now, batches);
  const today = istDay_(ctx.now);
  const dayOf = (r) => r.batch + '@' + istDay_(r.starts_at);
  const away = (ms) => ms - ctx.now > CHECKIN_BEFORE_MIN_ * 60000;
  const changes = (table) => {
    const joined = {};
    ctx.db.t('checkins').rows.forEach((c) => {
      joined[c.session_id] = true;
    });
    const free = (r) => away(r.starts_at) && !joined[r.id];
    const byDay = {};
    table.rows.forEach((r) => {
      const day = istDay_(r.starts_at);
      const timed = !batches[r.batch] || batches[r.batch].start_min !== null;
      if (timed && day >= today && day < today + 7) (byDay[dayOf(r)] || (byDay[dayOf(r)] = [])).push(r);
    });
    const todo = { missing: [], moved: [], stale: [] };
    const want = {};
    wanted.forEach((w) => {
      want[dayOf(w)] = true;
      const rows = byDay[dayOf(w)] || [];
      const row = rows[0];
      if (!row) todo.missing.push(w);
      else if (rows.length === 1 && !row.time_set_by && free(row) && away(w.starts_at) &&
        (row.starts_at !== w.starts_at || row.duration_min !== w.duration_min)) {
        todo.moved.push([row, w]);
      }
    });
    Object.keys(byDay).forEach((key) => {
      if (!want[key]) todo.stale = todo.stale.concat(byDay[key].filter(free));
    });
    return todo;
  };
  const shape = Object.keys(batches).sort()
    .map((key) => [key, batches[key].days.join(' '), batches[key].start_min, batches[key].duration_min].join('/')).join(';');
  const mark = () => cacheKey_('week:' + today + ':' + sha256Hex_(shape));
  if (cacheGet_(mark())) return;
  const make = () => {
    CACHE_GENERATION_ = null; // read again: it may have moved on while this request waited
    if (cacheGet_(mark())) return; // made by a request that had the lock first
    ctx.db.forget('class_sessions');
    ctx.db.forget('checkins');
    const table = ctx.db.t('class_sessions');
    const todo = changes(table);
    todo.moved.forEach(([row, w]) => table.update(row, { starts_at: w.starts_at, duration_min: w.duration_min, updated_at: ctx.now }));
    if (todo.stale.length) table.remove(todo.stale);
    if (todo.missing.length) {
      let id = newIds_(ctx, 'class_sessions', todo.missing.length);
      table.insert(todo.missing.map((w) => ({
        id: id++, batch: w.batch, starts_at: w.starts_at, duration_min: w.duration_min, meet_link: null, updated_at: ctx.now,
      })));
    }
    SpreadsheetApp.flush(); // the classes are in the Sheet before the mark says so
    cachePut_(mark(), '1');
  };
  try {
    ctx.lock(make, true);
  } catch (err) {
    if (!(err instanceof HttpError_) || err.status !== 503) throw err;
    // The lock was busy: this visit goes on with the classes as they are, and a later one makes the week.
  }
}

/** Whether a class's after-class window is open at [now]: from 10 minutes before its end to 12 hours after it. */
function afterOpen_(session, now) {
  const end = session.starts_at + session.duration_min * 60000;
  return end - 10 * 60000 <= now && now <= end + 12 * 3600000;
}

/** Sessions that have not ended yet, soonest first: [batch]'s, or every batch's. */
function upcoming_(ctx, limit, batch) {
  ensureWeek_(ctx);
  const from = ctx.now - 2 * 3600000;
  return ctx.db.t('class_sessions').rows
    .filter((r) => (!batch || r.batch === batch) && r.starts_at >= from && r.starts_at + r.duration_min * 60000 > ctx.now)
    .sort((a, b) => a.starts_at - b.starts_at || String(a.batch).localeCompare(String(b.batch)))
    .slice(0, limit);
}

function sessionRow_(ctx, id) {
  const row = ctx.db.t('class_sessions').rows.filter((r) => r.id === id)[0];
  if (!row) throw new HttpError_(404, 'no_session');
  return row;
}

function sessionsById_(ctx) {
  const out = {};
  ctx.db.t('class_sessions').rows.forEach((r) => {
    out[r.id] = r;
  });
  return out;
}

/** The average mood change over (before, after) pairs of the given check-ins: [average or null, pairs]. A class
 * attended with no mood before (said how it went without checking in first) makes no pair. */
function moodChange_(checkins) {
  const after = {};
  checkins.forEach((c) => {
    if (c.phase === 'after' && c.mood !== null) after[c.user_id + ':' + c.session_id] = c.mood;
  });
  let sum = 0;
  let pairs = 0;
  checkins.forEach((c) => {
    const key = c.user_id + ':' + c.session_id;
    if (c.phase === 'before' && c.mood !== null && Object.prototype.hasOwnProperty.call(after, key)) {
      sum += after[key] - c.mood;
      pairs++;
    }
  });
  return [pairs ? sum / pairs : null, pairs];
}

/** Which classes are a student's: a test of a class, true when they were in its batch at some moment while it ran
 * (placed before its end, not moved out before its start). Their batches come from their placements and moves in
 * batch_changes, and from the users tab: a batch set there by hand, with no change logged, is their batch now, from
 * its batch_since (from always when that is empty), but never from before the last change logged. */
function ownClasses_(ctx, user) {
  const changes = ctx.db.t('batch_changes').rows.filter((c) => c.student_id === user.id).sort((a, b) => a.created_at - b.created_at);
  const steps = [{ at: -Infinity, batch: changes.length ? changes[0].from : null }].concat(changes.map((c) => ({ at: c.created_at, batch: c.to })));
  const last = steps[steps.length - 1];
  if (user.batch !== last.batch) steps.push({ at: Math.max(user.batch_since === null ? 0 : user.batch_since, last.at), batch: user.batch });
  return (session) => {
    const end = session.starts_at + session.duration_min * 60000;
    return steps.some((step, i) => step.batch === session.batch && step.at < end && (i === steps.length - 1 || steps[i + 1].at > session.starts_at));
  };
}

/** Classes joined, the run of classes in a row the student came to, and the average mood change. The run goes back
 * through the classes of the batch the student was in at the time of each ([ownClasses_]; a move starts no new count), and any
 * other they joined; one checked in to counts at once. A class still to come or under way does not break it, nor
 * one nobody came to: it was probably not held. Sent as streak_days. */
function practiceStats_(ctx, user) {
  const sessions = ctx.db.t('class_sessions').rows;
  const checkins = ctx.db.t('checkins').rows;
  const held = {};
  const mine = {};
  checkins.forEach((c) => {
    if (c.phase !== 'before') return;
    held[c.session_id] = true;
    if (c.user_id === user.id) mine[c.session_id] = true;
  });
  const own = ownClasses_(ctx, user);
  const ended = (s) => s.starts_at + s.duration_min * 60000 <= ctx.now;
  const run = sessions
    .filter((s) => mine[s.id] || (held[s.id] && ended(s) && own(s)))
    .sort((a, b) => b.starts_at - a.starts_at);
  let streak = 0;
  while (streak < run.length && mine[run[streak].id]) streak++;
  const [change, pairs] = moodChange_(checkins.filter((c) => c.user_id === user.id));
  return { classes_joined: sessions.filter((s) => mine[s.id]).length, streak_days: streak, mood_change: change, mood_pairs: pairs };
}

/** Rounds to one decimal, a tie to the even digit as Python's round() does: 2.25 is 2.2 and 2.75 is 2.8. Among averages
 * of moods the only exact ties are the quarters. */
function round1_(x) {
  const tenths = x * 10;
  if (Number.isInteger(x * 4) && !Number.isInteger(x * 2)) {
    const low = Math.floor(tenths);
    return (low % 2 === 0 ? low : low + 1) / 10;
  }
  return Number(x.toFixed(1));
}

function average1_(values) {
  return values.length ? round1_(values.reduce((a, b) => a + b, 0) / values.length) : null;
}

/** The student's classes over the last `days` days (1 to 90), with the sums done: classes joined, average mood
 * before and after (a class attended with no mood before counts in neither), and the same per class, class names in
 * `lang`. */
function practiceSummary_(ctx, userId, days, lang) {
  days = Math.max(1, Math.min(days, 90));
  const sessions = sessionsById_(ctx);
  const batches = batches_(ctx);
  const mine = ctx.db.t('checkins').rows.filter((c) => c.user_id === userId);
  const afterBySession = {};
  mine.forEach((c) => {
    if (c.phase === 'after') afterBySession[c.session_id] = c.mood;
  });
  const from = ctx.now - days * DAY_MS_;
  const rows = mine
    .filter((c) => c.phase === 'before' && sessions[c.session_id])
    .map((c) => ({ session: sessions[c.session_id], before: c.mood,
      after: Object.prototype.hasOwnProperty.call(afterBySession, c.session_id) ? afterBySession[c.session_id] : null }))
    .filter((r) => r.session.starts_at >= from && r.session.starts_at <= ctx.now)
    .sort((a, b) => a.session.starts_at - b.session.starts_at);
  const classes = [];
  const byClass = {};
  const plan = sessionCurricula_(ctx);
  rows.forEach((r) => {
    const name = batchJson_(batches[r.session.batch], r.session.batch, lang).name;
    classes.push({ date: istDate_(r.session.starts_at), at: isoTime_(r.session.starts_at), class: name, curriculum: plan[r.session.id],
      mood_before: r.before, mood_after: r.after });
    const entry = byClass[name] || (byClass[name] = { times: 0, before: [], after: [] });
    entry.times += 1;
    if (r.before !== null) entry.before.push(r.before);
    if (r.after !== null) entry.after.push(r.after);
  });
  const summary = {};
  Object.keys(byClass).forEach((name) => {
    const e = byClass[name];
    summary[name] = { times: e.times, average_mood_before: average1_(e.before), average_mood_after: average1_(e.after) };
  });
  const library = curriculum_(ctx).library;
  const itemsBySolo = {};
  ctx.db.t('practice').rows.forEach((p) => {
    if (p.user_id === userId && p.solo_id !== null) (itemsBySolo[p.solo_id] || (itemsBySolo[p.solo_id] = [])).push(p);
  });
  const mySolo = ctx.db.t('solo_sessions').rows.filter((s) => s.user_id === userId);
  const solo = mySolo
    .filter((s) => s.started_at >= from && s.started_at <= ctx.now)
    .sort((a, b) => a.started_at - b.started_at)
    .map((s) => ({ id: s.id, date: istDate_(s.started_at), at: isoTime_(s.started_at), minutes: Math.round((s.ended_at - s.started_at) / 60000),
      items: (itemsBySolo[s.id] || []).sort((a, b) => a.id - b.id).map((p) => itemTitle_(library[p.item], p.item, lang)) }));
  // The items practised most in the period, in class and on one's own apart, so neither is taken for the other: how
  // often, the average reaction, strain or pain.
  const soloById = {};
  mySolo.forEach((s) => {
    soloById[s.id] = s;
  });
  const inClass = {};
  const onOwn = {};
  ctx.db.t('practice').rows.forEach((p) => {
    if (p.user_id !== userId) return;
    const alone = p.solo_id !== null;
    const at = alone ? (soloById[p.solo_id] || {}).started_at : (sessions[p.session_id] || {}).starts_at;
    if (at === undefined || at < from || at > ctx.now) return;
    const byItem = alone ? onOwn : inClass;
    const e = byItem[p.item] || (byItem[p.item] = { times: 0, reactions: [], pain: 0 });
    e.times += 1;
    if (p.reaction !== null) e.reactions.push(p.reaction);
    e.pain += p.pain;
  });
  const most = (byItem) => Object.keys(byItem).sort((a, b) => byItem[b].times - byItem[a].times || a.localeCompare(b)).slice(0, 5)
    .map((item) => ({ asana: itemTitle_(library[item], item, lang), times: byItem[item].times,
      average_reaction: average1_(byItem[item].reactions), pain_times: byItem[item].pain }));
  return {
    period_days: days,
    classes_joined: classes.length,
    average_mood_before: average1_(rows.filter((r) => r.before !== null).map((r) => r.before)),
    average_mood_after: average1_(rows.filter((r) => r.after !== null).map((r) => r.after)),
    by_class: summary,
    classes: classes,
    solo: solo,
    items_in_class: most(inClass),
    items_on_own: most(onOwn),
  };
}

/** An item's name for people: transliterated in English, Devanagari in Hindi and Marathi. */
function itemTitle_(entry, key, lang) {
  if (!entry) return key;
  return lang === 'en' ? entry.name : entry.sanskrit;
}

/** The message for one session, for the teacher to share with the class. */
function shareFor_(ctx, row, lang) {
  const batch = batches_(ctx)[row.batch];
  const link = row.meet_link || (batch && batch.meet_link);
  if (!link) throw new HttpError_(400, 'no_link');
  const name = batchJson_(batch, row.batch, lang).name;
  return { text: classMessage_(name, row.starts_at, row.duration_min, link, lang) };
}

/** What a check-in row copies from its class for the owner's queries: the batch's name and the India date. */
function checkinCopy_(ctx, session) {
  return { class: batchJson_(batches_(ctx)[session.batch], session.batch, 'en').name, class_date: istMidnight_(istDay_(session.starts_at)) };
}

// ---------- messages for the class ----------
// The app reads no chat. The teacher shares from the app through Android's share sheet, to the class's group on
// WhatsApp or anywhere else; the messages are plain text, for any app or an SMS.

const TEXT_ = {
  class: {
    en: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} min)\n🔗 Join: {link}\n\nOpen the app to check in before class.',
    hi: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} मिनट)\n🔗 जुड़ें: {link}\n\nकक्षा से पहले ऐप में चेक-इन करें।',
    mr: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} मिनिटे)\n🔗 सामील व्हा: {link}\n\nवर्गापूर्वी ॲपमध्ये चेक-इन करा.',
  },
  invite: {
    en: '🙏 Join {studio} in the app.\n{app}Sign up with your phone number and this group code: {code}',
    hi: '🙏 ऐप में {studio} से जुड़ें।\n{app}अपने फ़ोन नंबर और इस ग्रुप कोड से साइन अप करें: {code}',
    mr: '🙏 ॲपमध्ये {studio} मध्ये सामील व्हा.\n{app}तुमचा फोन नंबर आणि हा ग्रुप कोड वापरून साइन अप करा: {code}',
  },
  get_app: {
    en: '📲 Get the app: {link}\n',
    hi: '📲 ऐप यहाँ से लें: {link}\n',
    mr: '📲 ॲप इथून घ्या: {link}\n',
  },
  // In a class review, for one whose row the owner deleted from the users tab.
  former_student: { en: 'A former student', hi: 'एक पूर्व विद्यार्थी', mr: 'एक माजी विद्यार्थी' },
};
const DAY_NAMES_ = {
  en: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
  hi: ['सोम', 'मंगल', 'बुध', 'गुरु', 'शुक्र', 'शनि', 'रवि'],
  mr: ['सोम', 'मंगळ', 'बुध', 'गुरु', 'शुक्र', 'शनि', 'रवि'],
};

function fill_(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, key) => (Object.prototype.hasOwnProperty.call(values, key) ? String(values[key]) : all));
}

function classMessage_(className, startsAt, minutes, link, lang) {
  const p = istParts_(startsAt);
  const day = DAY_NAMES_[lang][p.weekday] + ' ' + p.day + ' ' + MONTH_NAMES_[p.month];
  return fill_(pick_(TEXT_.class, lang), { studio: pick_(STUDIO.name, lang), name: className, day: day, time: istClock_(startsAt),
    minutes: minutes, link: link });
}

/** The invite: the group code, and where to get the app when the settings tab has an app_link. */
function inviteMessage_(code, appLink, lang) {
  const app = appLink ? fill_(pick_(TEXT_.get_app, lang), { link: appLink }) : '';
  return fill_(pick_(TEXT_.invite, lang), { studio: pick_(STUDIO.name, lang), app: app, code: code });
}

// ---------- Practice: the curriculum, each class's plan, how each item went, and each student's history ----------
// The curriculum lives in three tabs (library, curricula, curriculum_items), so the owner can change it in the Sheet.
// The teacher picks one curriculum per class; students react to its items after class, one tap each, and practise
// on their own with a stopwatch; the teacher reads each student's history per item and can write feedback on an
// item, which the student sees with it.

const MAX_HOLD_S_ = 3600; // the app's stopwatch stops at an hour

/** The library tab by key. */
function library_(ctx) {
  const library = {};
  ctx.db.t('library').rows.forEach((r) => {
    if (r.key) library[r.key] = r;
  });
  return library;
}

/** The curriculum as the Sheet holds it: the library by key, the curricula in tab order, each one's items in order. */
function curriculum_(ctx) {
  const library = library_(ctx);
  const items = {};
  ctx.db.t('curriculum_items').rows
    .filter((r) => r.curriculum && library[r.item])
    .sort((a, b) => a.position - b.position)
    .forEach((r) => {
      (items[r.curriculum] || (items[r.curriculum] = [])).push(r);
    });
  return { library: library, curricula: ctx.db.t('curricula').rows.filter((r) => r.key), items: items };
}

/** Each session's curriculum by session id: its own, else its batch's, else the first in the curricula tab. */
function sessionCurricula_(ctx) {
  const known = {};
  const keys = ctx.db.t('curricula').rows.filter((r) => r.key).map((r) => r.key);
  keys.forEach((k) => {
    known[k] = true;
  });
  const batches = batches_(ctx);
  const out = {};
  ctx.db.t('class_sessions').rows.forEach((r) => {
    const batch = batches[r.batch];
    out[r.id] = (known[r.curriculum] && r.curriculum) || (batch && known[batch.curriculum] && batch.curriculum) || keys[0] || null;
  });
  return out;
}

/** The library and the curricula in the student's language (the Devanagari names serve Hindi and Marathi). An item's
 * dose is always a whole number, rounded down (2.5 is 2), 0 when its cell holds none (the app then shows the unit or
 * the cue alone); a count that is not whole comes as written in dose_label too ("2.5"). */
function curricula_(ctx) {
  currentUser_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const local = (row, col) => (query.lang === 'en' ? row[col] : row[col + '_' + query.lang]) || row[col];
  const c = curriculum_(ctx);
  return {
    library: Object.keys(c.library).map((key) => {
      const r = c.library[key];
      return { key: r.key, type: r.type, level: r.level, sanskrit: r.sanskrit, name: r.name, english: r.english,
        aliases: r.aliases.split(',').map((a) => a.trim()).filter((a) => a) };
    }),
    curricula: c.curricula.map((r) => ({
      key: r.key, name: local(r, 'name'), level: r.level, about: local(r, 'about'),
      items: (c.items[r.key] || []).map((i) => {
        const item = { item: i.item, dose: Math.floor(i.dose || 0), unit: i.unit, cue: local(i, 'cue') };
        if (i.dose !== null && !Number.isInteger(i.dose)) item.dose_label = String(i.dose); // "2.5"
        return item;
      }),
    })),
  };
}

function setCurriculum_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.curriculum });
  const row = sessionRow_(ctx, path.session_id);
  if (!ctx.db.t('curricula').rows.some((r) => r.key === body.curriculum)) throw new HttpError_(400, 'no_curriculum');
  ctx.db.t('class_sessions').update(row, { curriculum: body.curriculum, updated_at: ctx.now });
  return { ok: true, curriculum: body.curriculum };
}

/** After class, how each item went for this student. Open while the "after" check-in is, to one who checked in or
 * whose class it is ([ownClasses_]); a second send replaces the first. Entries with no reaction, no pain and no note
 * are not kept. Who is asking, the class, whose class it is and the library are read before the lock, as a class sends
 * this all at once; under it, only the tabs it writes, read there for the first time: the check-ins (whether the
 * student checked in) and the practice entries. */
function sessionPractice_(ctx) {
  const user = currentUser_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.practice });
  if (user.status !== 'approved') throw new HttpError_(403, 'pending');
  const row = sessionRow_(ctx, path.session_id);
  if (!afterOpen_(row, ctx.now)) throw new HttpError_(400, 'checkin_closed');
  const own = ownClasses_(ctx, user)(row);
  const library = library_(ctx);
  const copy = checkinCopy_(ctx, row);
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this send, with its request id, that had the lock first
    if (kept) return kept;
    const checkins = ctx.db.t('checkins');
    const joined = checkins.rows.some((c) => c.user_id === user.id && c.session_id === row.id && c.phase === 'before');
    if (!(joined || own)) throw new HttpError_(400, 'checkin_closed');
    const said = saidEntries_(body.entries, library);
    // Saying how it went records coming to the class, with no mood before, for one who did not check in.
    if (!joined && said.length) {
      checkins.insert([Object.assign({ user_id: user.id, session_id: row.id, phase: 'before', mood: null, created_at: ctx.now }, copy)]);
    }
    const table = ctx.db.t('practice');
    table.remove(table.rows.filter((r) => r.user_id === user.id && r.session_id === row.id));
    let id = table.nextId();
    table.insert(said.map((e) => ({ id: id++, user_id: user.id, session_id: row.id, item: e.item, reaction: e.reaction, pain: e.pain,
      note: e.note, created_at: ctx.now, item_name: library[e.item].name, week: mondayOf_(row.starts_at) })));
    return keepAnswer_(ctx.request, { ok: true, saved: said.length });
  }, true);
}

/** Practice on the student's own: each item with the stopwatch's seconds (an hour at most: a longer hold is kept as
 * an hour), how it went, strain or pain and a note. It ended at the phone's `ended_at` (soloEnd_) and began `minutes`
 * before. Items with nothing timed or said are not kept. Who is asking and the library are read before the lock;
 * under it, only the two tabs it writes, read there for the first time. A send with a request id is written once
 * however late it comes again: the row keeps the id, and a repeat gets the first answer from it. */
function soloPractice_(ctx) {
  const user = member_(ctx);
  const { body } = ctx.check({ body: BODY_.solo });
  const library = library_(ctx);
  const said = saidEntries_(body.entries, library);
  if (!said.length) throw new HttpError_(400, 'nothing_said');
  const ended = soloEnd_(body.ended_at, ctx.now);
  const started = ended - body.minutes * 60000;
  const requestId = ctx.request.requestId || null;
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this send, with its request id, that had the lock first
    if (kept) return kept;
    const solo = ctx.db.t('solo_sessions');
    const table = ctx.db.t('practice');
    const before = requestId && solo.rows.filter((r) => r.user_id === user.id && r.request_id === requestId)[0];
    if (before) {
      return keepAnswer_(ctx.request, { ok: true, id: before.id, saved: table.rows.filter((r) => r.solo_id === before.id).length });
    }
    const row = solo.insert([{ id: solo.nextId(), user_id: user.id, started_at: started, ended_at: ended, request_id: requestId }])[0];
    let id = table.nextId();
    table.insert(said.map((e) => ({ id: id++, user_id: user.id, solo_id: row.id, item: e.item, hold_s: Math.min(e.hold_s || 0, MAX_HOLD_S_) || null,
      reaction: e.reaction, pain: e.pain, note: e.note, created_at: ctx.now, item_name: library[e.item].name, week: mondayOf_(started) })));
    return keepAnswer_(ctx.request, { ok: true, id: row.id, saved: said.length });
  }, true);
}

const SOLO_SKEW_MS_ = 5 * 60000; // how far ahead of the server's clock a phone's may run
const SOLO_LATE_MS_ = 3 * DAY_MS_; // how late a practice may still come with the phone's time

/** When a practice on one's own ended: the phone's time for it (it may have waited days for a connection), when that is
 * a time, not later than now but for a phone's clock running a little ahead, nor older than three days; else now. */
function soloEnd_(endedAt, now) {
  const at = endedAt === null ? NaN : Date.parse(endedAt);
  if (isNaN(at) || at > now + SOLO_SKEW_MS_ || at < now - SOLO_LATE_MS_) return now;
  return Math.min(at, now);
}

/** The entries worth keeping, one per item (the last wins), notes trimmed: those with a reaction, strain or pain, a
 * note or a timed hold. An item outside the library is 400 unknown_item. */
function saidEntries_(entries, library) {
  const byItem = {};
  entries.forEach((e) => {
    if (!library[e.item]) throw new HttpError_(400, 'unknown_item');
    byItem[e.item] = e;
  });
  return Object.keys(byItem).map((k) => byItem[k])
    .map((e) => Object.assign({}, e, { note: e.note === null ? null : e.note.trim() || null }))
    .filter((e) => e.reaction !== null || e.pain === 1 || e.note !== null || Boolean(e.hold_s));
}

/** The Monday (midnight in India) of the week a moment falls in. */
function mondayOf_(ms) {
  const day = istDay_(ms);
  return istMidnight_(day - ((day + 3) % 7));
}

/** How a class went, item by item, for the teacher: the reactions counted (not yet, with effort, steady, at ease),
 * items with strain or pain first, each with who and what they wrote, then the other notes. One whose row the owner
 * deleted is named "A former student", in `lang`. */
function classReview_(ctx) {
  teacher_(ctx);
  const { path, query } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_ });
  const row = sessionRow_(ctx, path.session_id);
  const names = {};
  ctx.db.t('users').rows.forEach((u) => {
    names[u.id] = u.name;
  });
  const nameOf = (id) => names[id] || pick_(TEXT_.former_student, query.lang);
  const plan = sessionCurricula_(ctx)[row.id];
  const entries = ctx.db.t('practice').rows.filter((r) => r.session_id === row.id).sort((a, b) => a.id - b.id);
  const order = (curriculum_(ctx).items[plan] || []).map((i) => i.item);
  entries.forEach((e) => {
    if (order.indexOf(e.item) < 0) order.push(e.item);
  });
  const items = order.map((item) => {
    const mine = entries.filter((e) => e.item === item);
    return {
      item: item,
      reactions: [1, 2, 3, 4].map((n) => mine.filter((e) => e.reaction === n).length),
      pain: mine.filter((e) => e.pain === 1).map((e) => ({ name: nameOf(e.user_id), note: e.note })),
      notes: mine.filter((e) => e.pain !== 1 && e.note).map((e) => ({ name: nameOf(e.user_id), text: e.note })),
    };
  });
  const answered = {};
  entries.forEach((e) => {
    answered[e.user_id] = true;
  });
  return {
    id: row.id,
    starts_at: isoTime_(row.starts_at),
    curriculum: plan,
    joined: ctx.db.t('checkins').rows.filter((c) => c.session_id === row.id && c.phase === 'before').length,
    answered: Object.keys(answered).length,
    items: items.filter((i) => i.pain.length).concat(items.filter((i) => !i.pain.length)),
  };
}

// ---------- each student's history per item, and the teacher's feedback on it ----------

/** How one student's practice of one item has gone, worked out in code from its rows: the times in class and on their
 * own, the reaction trend (the first reactions against the latest, up to three of each), the holds timed on their own,
 * strain or pain, the teacher's latest feedback, the student's notes, and every entry and piece of feedback, newest
 * first. [when] gives a row's moment: its class's start, or its solo session's. */
function itemProgress_(item, rows, feedback, when) {
  const entries = rows
    .map((r) => ({ at: when(r), solo: r.solo_id !== null, hold: r.hold_s, reaction: r.reaction, pain: r.pain === 1, note: r.note }))
    .filter((e) => e.at !== null)
    .sort((a, b) => a.at - b.at);
  const holds = entries.filter((e) => e.hold).map((e) => e.hold);
  const said = feedback.slice().sort((a, b) => a.created_at - b.created_at || a.id - b.id);
  const reactions = entries.filter((e) => e.reaction !== null).map((e) => e.reaction);
  const k = Math.min(3, Math.floor(reactions.length / 2));
  const pains = entries.filter((e) => e.pain);
  const latest = said[said.length - 1];
  return {
    item: item,
    in_class: entries.filter((e) => !e.solo).length,
    solo: entries.filter((e) => e.solo).length,
    first: entries.length ? istDate_(entries[0].at) : null,
    last: entries.length ? istDate_(entries[entries.length - 1].at) : null,
    reaction_trend: k ? { early_average: average1_(reactions.slice(0, k)), recent_average: average1_(reactions.slice(-k)), each: k } : null,
    holds: holds.length ? { recent_seconds: holds[holds.length - 1], longest_seconds: Math.max.apply(null, holds) } : null,
    strain_or_pain: { times: pains.length, last: pains.length ? istDate_(pains[pains.length - 1].at) : null },
    teacher_said: latest ? { date: istDate_(latest.created_at), text: latest.text } : null,
    your_notes: entries.filter((e) => e.note).slice(-5).map((e) => ({ date: istDate_(e.at), text: e.note })),
    entries: entries.slice().reverse().map((e) => ({ date: istDate_(e.at), at: isoTime_(e.at), kind: e.solo ? 'solo' : 'class', hold_s: e.hold,
      reaction: e.reaction, pain: e.pain ? 1 : 0, note: e.note })),
    feedback: said.slice().reverse().map((f) => ({ date: istDate_(f.created_at), at: isoTime_(f.created_at), text: f.text })),
  };
}

/** Each item one student has practised or had feedback on: {item: progress}. */
function progressByItem_(ctx, userId) {
  const rows = {};
  const feedback = {};
  ctx.db.t('practice').rows.forEach((r) => {
    if (r.user_id === userId) (rows[r.item] || (rows[r.item] = [])).push(r);
  });
  ctx.db.t('asana_feedback').rows.forEach((f) => {
    if (f.student_id === userId) (feedback[f.item] || (feedback[f.item] = [])).push(f);
  });
  const sessions = sessionsById_(ctx);
  const solos = {};
  ctx.db.t('solo_sessions').rows.forEach((s) => {
    if (s.user_id === userId) solos[s.id] = s;
  });
  const when = (r) => {
    const at = r.solo_id !== null ? solos[r.solo_id] && solos[r.solo_id].started_at : sessions[r.session_id] && sessions[r.session_id].starts_at;
    return at === undefined ? null : at;
  };
  const out = {};
  Object.keys(rows).concat(Object.keys(feedback)).forEach((item) => {
    if (!out[item]) out[item] = itemProgress_(item, rows[item] || [], feedback[item] || [], when);
  });
  return out;
}

/** For the Practice tab: each item with its counts and trend. What needs attention comes first: items with strain or
 * pain, then those the teacher wrote on (the latest first), then the rest, the most practised first. */
function itemList_(ctx, userId) {
  const all = progressByItem_(ctx, userId);
  return {
    items: Object.keys(all).map((item) => {
      const p = all[item];
      return { item: item, in_class: p.in_class, solo: p.solo, last: p.last, reaction_trend: p.reaction_trend,
        pain_times: p.strain_or_pain.times, teacher_said: p.teacher_said ? p.teacher_said.date : null };
    }).sort((a, b) => (b.pain_times > 0) - (a.pain_times > 0) || (b.teacher_said || '').localeCompare(a.teacher_said || '') ||
      b.in_class + b.solo - a.in_class - a.solo || a.item.localeCompare(b.item)),
  };
}

function oneItem_(ctx, userId, item) {
  return progressByItem_(ctx, userId)[item] || itemProgress_(item, [], [], () => null);
}

/** The student the teacher asks about, or 404 no_student (also when two rows share the id: userById_). */
function studentRow_(ctx, id) {
  const student = userById_(ctx.db.t('users').rows, id);
  if (!student || student.role !== 'student') throw new HttpError_(404, 'no_student');
  return student;
}

function myItems_(ctx) {
  return itemList_(ctx, member_(ctx).id);
}

function myItem_(ctx) {
  const user = member_(ctx);
  const { path } = ctx.check({ path: PATH_ITEM_ });
  return oneItem_(ctx, user.id, path.item);
}

function studentItems_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: PATH_USER_ });
  return itemList_(ctx, studentRow_(ctx, path.user_id).id);
}

function studentItem_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: Object.assign({}, PATH_USER_, PATH_ITEM_) });
  return oneItem_(ctx, studentRow_(ctx, path.user_id).id, path.item);
}

/** The teacher's word to one student about one item; the student sees it with that item's history. */
function itemFeedback_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.itemFeedback });
  const student = studentRow_(ctx, path.user_id);
  if (!curriculum_(ctx).library[body.item]) throw new HttpError_(400, 'unknown_item');
  const table = ctx.db.t('asana_feedback');
  const row = table.insert([{ id: table.nextId(), student_id: student.id, item: body.item, text: body.text.trim(), created_at: ctx.now }])[0];
  return { ok: true, id: row.id };
}

// ---------- Intake: a student's answers about themselves, for the teacher to place them in a batch ----------
// Age, height, weight, food habits, pain or conditions, and a self-assessment of a few asanas (in content/studio.json).
// Health data: only the student and the teacher read it, its tabs are hidden, and the Dashboard shows it only as
// counts.

const PAIN_AREAS_ = ['knee', 'back', 'neck', 'shoulder', 'hip', 'other'];

/** A student's intake for the app, with the batch it points to; null before they fill it. */
function intakeOf_(ctx, userId) {
  const row = ctx.db.t('intake').rows.filter((r) => r.user_id === userId)[0];
  if (!row) return null;
  const ratings = ctx.db.t('intake_ratings').rows.filter((r) => r.user_id === userId)
    .map((r) => ({ item: r.item, reaction: r.reaction, pain: r.pain }));
  const pain = painAreas_(row.pain);
  return {
    age: row.age, height_cm: row.height_cm, weight_kg: row.weight_kg, food: row.food, meals: row.meals, pain: pain, pain_note: row.pain_note,
    ratings: ratings, updated_at: isoTime_(row.updated_at), suggested_batch: suggestedBatch_(ctx, pain, ratings),
  };
}

function painAreas_(text) {
  return String(text || '').split(',').map((a) => a.trim().toLowerCase()).filter((a) => a);
}

/** The batch the answers point to, for the teacher to confirm: any pain, Pain management; four or more poses of the
 * self-assessment steady or at ease, Intermediate; else Beginner. Never Advanced, which is the teacher's call. The
 * first batch when the owner has renamed these. */
function suggestedBatch_(ctx, pain, ratings) {
  const batches = batches_(ctx);
  const easy = ratings.filter((r) => r.reaction !== null && r.reaction >= 3).length;
  const key = pain.length || ratings.some((r) => r.pain === 1) ? 'pain_management' : easy >= 4 ? 'intermediate' : 'beginner';
  return batches[key] ? key : Object.keys(batches)[0] || null;
}

function myIntake_(ctx) {
  return { intake: intakeOf_(ctx, currentUser_(ctx).id) };
}

/** A student's intake, after sign-up (pending) or later from Me; a second send replaces the first. Only its writes
 * hold the lock: the two intake tabs, read there for the first time in the request, the student's row changed in
 * place and their self-assessment rows written over in place (emptied when there are fewer, added at the end when
 * there are more), a handful of calls with no row deleted, so a class sending theirs at once is not kept waiting. */
function saveIntake_(ctx) {
  const user = currentUser_(ctx);
  if (user.role !== 'student') throw new HttpError_(403, 'students_only');
  const { body } = ctx.check({ body: BODY_.intake });
  const pain = painAreas_(body.pain);
  if (pain.some((a) => PAIN_AREAS_.indexOf(a) < 0)) throw new HttpError_(400, 'bad_pain_area');
  const asked = STUDIO.intake.assessment.map((a) => a.item);
  const byItem = {};
  body.ratings.forEach((r) => {
    if (asked.indexOf(r.item) < 0) throw new HttpError_(400, 'unknown_item');
    byItem[r.item] = r;
  });
  const trimmed = (text) => (text === null ? null : text.trim() || null);
  const values = { age: body.age, height_cm: body.height_cm, weight_kg: body.weight_kg, food: body.food, meals: trimmed(body.meals),
    pain: pain.join(', ') || null, pain_note: trimmed(body.pain_note), updated_at: ctx.now };
  const said = Object.keys(byItem).map((k) => byItem[k]).filter((r) => r.reaction !== null || r.pain === 1)
    .map((r) => ({ user_id: user.id, item: r.item, reaction: r.reaction, pain: r.pain }));
  ctx.lock(() => {
    const table = ctx.db.t('intake');
    const row = table.rows.filter((r) => r.user_id === user.id)[0];
    if (row) table.update(row, values);
    else table.insert([Object.assign({ user_id: user.id }, values)]);
    const ratings = ctx.db.t('intake_ratings');
    const before = ratings.rows.filter((r) => r.user_id === user.id);
    ratings.rewrite(before.map((r, i) => [r, said[i] || null]));
    ratings.insert(said.slice(before.length));
  }, true);
  return { intake: intakeOf_(ctx, user.id) };
}

// ---------- Routes: one function per route ----------
// Each checks who is asking first, then the inputs, then the rules: a signed-out request is a 401 whatever its inputs,
// and a bad input is a 422 before any rule is applied. Routes marked LOCK_ in routes_() run entirely under the script
// lock; the others take it only around their writes, so a slow password hash never holds up everyone else, and read
// the tabs they write for the first time under it wherever they can (Context_.lock says why).

// ---------- public ----------

/** ok, with two fields no other answer has, so the app can tell the health check from a call's own answer: what the
 * redirect's one-time target gives when it is fetched a second time. */
function health_() {
  return { ok: true, assistant: 'off', model: null };
}

function studio_(ctx) {
  const { query } = ctx.check({ query: QUERY_LANG_ });
  return studioJson_(ctx, query.lang);
}

/** One teacher, with the teacher code, which then works no more; students with the group code, which the teacher
 * gives with the invite, and who then wait for the teacher to place them in a batch. The code is checked first, under
 * its brake on guessing, then the slow password hash is done; the users tab is read only under the lock after it, so a
 * sign-up another request has just written cannot be missed, and a number already taken costs one hash. One number,
 * one account: the users tab says so, and the numbers kept in the script properties (phoneHeld_) say it again. */
function signup_(ctx) {
  const { body } = ctx.check({ body: BODY_.signup });
  const phone = normalizePhone_(body.phone);
  // A code copied from a message may bring spaces, stars or a full stop with it.
  const code = body.code.replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g, '').toUpperCase();
  const teacher = body.role === 'teacher';
  const key = teacher ? 'login:teacher-code' : 'group-code:' + phone;
  ctx.lock(() => {
    if (attemptsBlocked_(key)) throw new HttpError_(429, 'too_many_attempts');
    if (!codeMatches_(ctx, code, teacher ? 'teacher_code' : 'group_code')) {
      attemptsFail_(key);
      throw new HttpError_(400, teacher ? 'bad_teacher_code' : 'bad_group_code');
    }
  }, true);
  const pwHash = hashPassword_(body.password);
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this sign-up, with its request id, that had the lock first
    if (kept) return kept;
    const users = ctx.db.t('users');
    if (teacher && users.rows.some((u) => u.role === 'teacher')) throw new HttpError_(409, 'teacher_exists');
    if (users.rows.some((u) => phoneOf_(u) === phone) || phoneHeld_(ctx, phone, users)) throw new HttpError_(409, 'phone_taken');
    const user = users.insert([{
      id: newIds_(ctx, 'users', 1), name: body.name.trim(), phone: phone, role: body.role, status: teacher ? 'approved' : 'pending',
      pw_hash: pwHash, lang: body.lang, created_at: ctx.now,
    }])[0];
    holdPhone_(ctx, phone, user.id);
    return keepAnswer_(ctx.request, signIn_(ctx, user));
  });
}

/** Teacher and group codes are compared in capitals, so "yoga2024" and "YOGA2024" are the same code. */
function codeMatches_(ctx, code, key) {
  const want = (ctx.db.setting(key) || '').trim().toUpperCase();
  return want !== '' && code === want;
}

function login_(ctx) {
  const { body } = ctx.check({ body: BODY_.login });
  const phone = normalizePhone_(body.phone);
  const key = 'login:' + phone;
  // Counted as a failure until the password proves right, so parallel guesses cannot slip past the limit.
  ctx.lock(() => {
    if (attemptsBlocked_(key)) throw new HttpError_(429, 'too_many_attempts');
    attemptsFail_(key);
  }, true);
  // The account stored with the number exactly as typed first (two may be stored, with and without a 0 after +91),
  // then the one whose number reads the same. Read before the lock, for the slow password check; read again under it.
  const users = ctx.db.t('users').rows;
  const typed = normalizePhone_(body.phone, true);
  const user = users.filter((u) => u.phone === typed)[0] || users.filter((u) => phoneOf_(u) === phone)[0];
  const ok = checkPassword_(body.password, user ? user.pw_hash : DUMMY_HASH_); // the same work for an unknown number
  if (!user || !ok) throw new HttpError_(401, 'bad_login');
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this login, with its request id, that had the lock first
    // The users tab is read again under the lock: an account removed from the Sheet's menu, or given a new password,
    // while this one was checked gets no token.
    const still = userById_(ctx.db.t('users').rows, user.id);
    if (!kept && (!still || still.pw_hash !== user.pw_hash)) throw new HttpError_(401, 'bad_login');
    attemptsClear_(key);
    return kept || keepAnswer_(ctx.request, signIn_(ctx, still));
  });
}

// ---------- signed in ----------

/** Forgets this login's token. The tokens tab is read only under the lock: rows are deleted by their number, and one
 * read before it could point at another person's row by then. */
function logout_(ctx) {
  if (!ctx.token) return { ok: true };
  const hash = sha256Hex_(ctx.token);
  ctx.lock(() => {
    const tokens = ctx.db.t('tokens');
    const mine = tokens.rows.filter((r) => r.token_hash === hash);
    if (!mine.length) return;
    tokens.remove(mine);
    ctx.db.changedCache = true;
  });
  return { ok: true };
}

function me_(ctx) {
  const user = currentUser_(ctx);
  return { user: userJson_(user), stats: practiceStats_(ctx, user) };
}

/** A student (or the teacher) changing their own password: the current one first, under the login's brake on
 * guessing. This login stays signed in; every other is signed out. Who is asking is read before the lock, for the slow
 * password check; the rows written are those of the users and tokens tabs as read again under it. */
function changePassword_(ctx) {
  const user = currentUser_(ctx);
  const { body } = ctx.check({ body: BODY_.password });
  const key = 'login:' + phoneOf_(user);
  // Counted as a failure until the password proves right, as at login.
  ctx.lock(() => {
    if (attemptsBlocked_(key)) throw new HttpError_(429, 'too_many_attempts');
    attemptsFail_(key);
  }, true);
  if (!checkPassword_(body.current_password, user.pw_hash)) {
    // A copy of this change may have changed it after this one looked for its answer: that copy kept its answer
    // before its write could be read.
    const kept = replayed_(ctx.request);
    if (kept) return kept;
    throw new HttpError_(400, 'bad_password');
  }
  const pwHash = hashPassword_(body.new_password);
  const mine = sha256Hex_(ctx.token);
  return ctx.lock(() => {
    attemptsClear_(key);
    const kept = replayed_(ctx.request); // a copy of this change, with its request id, that had the lock first
    if (kept) return kept;
    const users = ctx.db.t('users');
    const me = userById_(users.rows, user.id);
    if (!me) throw new HttpError_(401, 'signed_out');
    users.update(me, { pw_hash: pwHash });
    const tokens = ctx.db.t('tokens');
    tokens.remove(tokens.rows.filter((r) => r.user_id === user.id && r.token_hash !== mine));
    ctx.db.changedCache = true;
    return keepAnswer_(ctx.request, { ok: true });
  });
}

function updateMe_(ctx) {
  const user = currentUser_(ctx);
  const { body } = ctx.check({ body: BODY_.me });
  const changes = {};
  if (body.name !== null) changes.name = body.name.trim();
  if (body.lang !== null) changes.lang = body.lang;
  ctx.db.t('users').update(user, changes);
  return { user: userJson_(user) };
}

/** What the get_my_practice tool on the phone hands Gemma: this student's classes over the last `days` days. */
function myPractice_(ctx) {
  const user = member_(ctx);
  const { query } = ctx.check({ query: { days: F_.int({ def: 7 }), lang: QUERY_LANG_.lang } });
  return practiceSummary_(ctx, user.id, query.days, query.lang);
}

/** One note the student chose to share with the teacher. Sharing the same words again returns the same note. The lock
 * holds the shared notes alone. */
function shareNote_(ctx) {
  const user = member_(ctx);
  const { body } = ctx.check({ body: BODY_.shared });
  if (user.role !== 'student') throw new HttpError_(403, 'pending');
  const text = body.text.trim();
  if (!text) throw new HttpError_(422, 'empty_note');
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this share, with its request id, that had the lock first
    if (kept) return kept;
    const notes = ctx.db.t('shared_notes');
    let row = notes.rows.filter((n) => n.user_id === user.id && n.text === text)[0];
    if (!row) row = notes.insert([{ id: notes.nextId(), user_id: user.id, text: text, created_at: ctx.now }])[0];
    return keepAnswer_(ctx.request, { ok: true, id: row.id });
  }, true);
}

/** Everything the student's Today tab needs in one call. */
function home_(ctx) {
  const user = currentUser_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const lang = query.lang;
  const member = user.status === 'approved';
  // A student sees only their batch's classes, once placed. Made first, so the classes this call adds have their
  // curriculum below.
  const coming = member && user.batch ? upcoming_(ctx, 7, user.batch) : [];
  const batches = batches_(ctx);
  const checkins = ctx.db.t('checkins').rows.filter((c) => c.user_id === user.id);
  const joined = {};
  const answered = {};
  checkins.forEach((c) => {
    if (c.phase === 'before') joined[c.session_id] = true;
    else answered[c.session_id] = true;
  });
  ctx.db.t('practice').rows.forEach((p) => {
    if (p.user_id === user.id) answered[p.session_id] = true;
  });
  const plan = sessionCurricula_(ctx);
  const sessions = coming.map((r) => {
    const s = sessionJson_(r, lang, member, batches);
    s.checked_in = Boolean(joined[r.id]);
    s.curriculum = plan[r.id];
    return s;
  });
  // The class to say how it went: the latest whose after-class window is open, with what was said about it so far
  // (null before an answer), so it can be said or changed. `after_checkin` is one the student checked in to;
  // `after_class` may also be one of theirs (ownClasses_) that they did not check in to (having joined
  // from the class's message), with `checked_in` saying which.
  const all = ctx.db.t('class_sessions').rows;
  const latest = (list) => list.filter((s) => afterOpen_(s, ctx.now)).sort((a, b) => b.starts_at - a.starts_at)[0];
  const said = (open) => {
    if (!open) return null;
    const out = sessionJson_(open, lang, false, batches);
    out.curriculum = plan[open.id];
    out.checked_in = Boolean(joined[open.id]);
    const mood = checkins.filter((c) => c.session_id === open.id && c.phase === 'after').map((c) => c.mood)[0];
    out.said = !answered[open.id] ? null : {
      mood: mood === undefined ? null : mood,
      items: ctx.db.t('practice').rows.filter((p) => p.user_id === user.id && p.session_id === open.id)
        .map((p) => ({ item: p.item, reaction: p.reaction, pain: p.pain, note: p.note })),
    };
    return out;
  };
  const own = ownClasses_(ctx, user);
  const afterJoined = latest(all.filter((s) => joined[s.id]));
  const afterOwn = latest(all.filter((s) => joined[s.id] || own(s)));
  // Classes are for approved students only: one waiting or removed gets none, nor a class to say how it went.
  return {
    user: userJson_(user),
    batch: member && user.batch ? batchJson_(batches[user.batch], user.batch, lang) : null,
    studio: studioJson_(ctx, lang),
    sessions: sessions,
    after_checkin: member ? said(afterJoined) : null,
    after_class: member ? said(afterOwn) : null,
    group_link: member ? ctx.db.setting('group_link') : null,
  };
}

/** A mood before class ("before", from an hour before it to its end) or after it ("after", in the after-class
 * window). Many students check in as class starts, so everything but the check-ins tab is read before the lock, and
 * under it only that tab, read afresh, and the one write. */
function checkin_(ctx) {
  const user = currentUser_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.checkin });
  if (user.status !== 'approved') throw new HttpError_(403, 'pending');
  const row = sessionRow_(ctx, path.session_id);
  // A class is the student's when they were in its batch at some moment while it ran ([ownClasses_]); one checked in
  // to can be answered after it in any case.
  const own = ownClasses_(ctx, user)(row);
  if (body.phase === 'before' && user.role === 'student' && !own) throw new HttpError_(403, 'other_batch');
  const start = row.starts_at;
  const end = start + row.duration_min * 60000;
  const entry = (phase, mood) => Object.assign({ user_id: user.id, session_id: row.id, phase: phase, mood: mood, created_at: ctx.now },
    checkinCopy_(ctx, row));
  const before = entry('before', body.phase === 'before' ? body.mood : null);
  const after = entry('after', body.mood);
  ctx.lock(() => {
    ctx.db.forget('checkins');
    const checkins = ctx.db.t('checkins');
    const mine = (phase) => checkins.rows.filter((c) => c.user_id === user.id && c.session_id === row.id && c.phase === phase)[0];
    const joined = mine('before');
    const open = body.phase === 'before'
      ? start - CHECKIN_BEFORE_MIN_ * 60000 <= ctx.now && ctx.now <= end
      : afterOpen_(row, ctx.now) && Boolean(joined || own);
    if (!open) throw new HttpError_(400, 'checkin_closed');
    const existing = mine(body.phase);
    if (existing) checkins.update(existing, { mood: body.mood });
    else if (body.phase === 'before') checkins.insert([before]);
    // Saying how class went with no check-in before it (having joined from the class's message) records coming to
    // it, with no mood before.
    else checkins.insert(joined ? [after] : [before, after]);
  }, true);
  return { ok: true, stats: practiceStats_(ctx, user) };
}

/** Feedback on the app. The lock holds the feedback tab alone. */
function feedback_(ctx) {
  const user = currentUser_(ctx);
  const { body } = ctx.check({ body: BODY_.feedback });
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this message, with its request id, that had the lock first
    if (kept) return kept;
    const table = ctx.db.t('feedback');
    table.insert([{ id: table.nextId(), user_id: user.id, screen: body.screen, text: body.text.trim(), created_at: ctx.now }]);
    return keepAnswer_(ctx.request, { ok: true });
  }, true);
}

// ---------- teacher ----------

/** The teacher's day: the classes of the next day that has some left (today, or tomorrow once today's are over),
 * every batch's, each with its curriculum and link; today's classes already over (`earlier`), to give one a later time;
 * the batches with their everyday links; the settings. */
function teacherHome_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const ahead = upcoming_(ctx, 100); // first, so the classes this call adds have their curriculum below
  const batches = batches_(ctx);
  const joined = {};
  ctx.db.t('checkins').rows.forEach((c) => {
    if (c.phase === 'before') joined[c.session_id] = (joined[c.session_id] || 0) + 1;
  });
  const plan = sessionCurricula_(ctx);
  const day = ahead.length ? istDay_(ahead[0].starts_at) : null;
  const today = istDay_(ctx.now);
  const show = (r) => teacherSession_(ctx, r, query.lang, batches, joined, plan);
  const earlier = ctx.db.t('class_sessions').rows
    .filter((r) => istDay_(r.starts_at) === today && r.starts_at + r.duration_min * 60000 <= ctx.now && batches[r.batch])
    .sort((a, b) => a.starts_at - b.starts_at || String(a.batch).localeCompare(String(b.batch)));
  return {
    sessions: ahead.filter((r) => istDay_(r.starts_at) === day).map(show),
    earlier: earlier.map(show),
    batches: Object.keys(batches).map((key) => Object.assign(batchJson_(batches[key], key, query.lang), { meet_link: batches[key].meet_link })),
    settings: { group_link: ctx.db.setting('group_link'), group_code: ctx.db.setting('group_code') },
    pending_students: ctx.db.t('users').rows.filter((u) => u.status === 'pending').length,
  };
}

/** A batch's everyday Meet link, for its classes without their own; an empty one removes it. */
function setBatchLink_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_BATCH_, body: BODY_.link });
  const row = ctx.db.t('batches').rows.filter((r) => r.key === path.key)[0];
  if (!row) throw new HttpError_(404, 'no_batch');
  ctx.db.t('batches').update(row, { meet_link: (body.meet_link || '').trim() ? cleanMeetLink_(body.meet_link) : null });
  return { ok: true, meet_link: row.meet_link };
}

/** One class's own link, and the message to share it. */
function setLink_(ctx) {
  teacher_(ctx);
  const { path, query, body } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_, body: BODY_.link });
  const row = sessionRow_(ctx, path.session_id);
  const link = cleanMeetLink_(body.meet_link || '');
  ctx.db.t('class_sessions').update(row, { meet_link: link, updated_at: ctx.now });
  return shareFor_(ctx, row, query.lang);
}

/** A class's own time, on its own India date: its start ("18:30") and length, set by the teacher, which the batch's time
 * then no longer moves (ensureWeek_). A class already over today may start again later today. Refused for a class of
 * an earlier day (class_past), one that would overlap another class of its batch (class_overlap), and one with
 * after-class answers or practice said about it (class_answered), which belong to the time it was held; check-ins
 * before it move with it. The class as the teacher's day shows it. */
function setTime_(ctx) {
  teacher_(ctx);
  const { path, query, body } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_, body: BODY_.time });
  const clock = /^(\d{1,2}):(\d\d)$/.exec(latinDigits_(body.time).trim());
  if (!clock || Number(clock[1]) > 23 || Number(clock[2]) > 59) throw new HttpError_(400, 'bad_time');
  const row = sessionRow_(ctx, path.session_id);
  const day = istDay_(row.starts_at);
  if (day < istDay_(ctx.now)) throw new HttpError_(400, 'class_past');
  const start = istMidnight_(day) + (Number(clock[1]) * 60 + Number(clock[2])) * 60000;
  const end = start + body.duration_min * 60000;
  const classes = ctx.db.t('class_sessions');
  if (classes.rows.some((r) => r.id !== row.id && r.batch === row.batch && r.starts_at < end && start < r.starts_at + r.duration_min * 60000)) {
    throw new HttpError_(400, 'class_overlap');
  }
  const answered = ctx.db.t('checkins').rows.some((c) => c.session_id === row.id && c.phase === 'after') ||
    ctx.db.t('practice').rows.some((p) => p.session_id === row.id);
  if (answered) throw new HttpError_(400, 'class_answered');
  classes.update(row, { starts_at: start, duration_min: body.duration_min, time_set_by: 'teacher', updated_at: ctx.now });
  return teacherSession_(ctx, row, query.lang, batches_(ctx));
}

/** A class as the teacher's day shows it: with whether it has its own link, how many checked in, its curriculum, and
 * whether the teacher gave it a time of its own. */
function teacherSession_(ctx, row, lang, batches, joined, plan) {
  const s = sessionJson_(row, lang, true, batches);
  s.own_link = row.meet_link !== null && row.meet_link !== '';
  s.joined = joined ? joined[row.id] || 0 : ctx.db.t('checkins').rows.filter((c) => c.session_id === row.id && c.phase === 'before').length;
  s.curriculum = (plan || sessionCurricula_(ctx))[row.id];
  s.time_set = Boolean(row.time_set_by);
  return s;
}

function share_(ctx) {
  teacher_(ctx);
  const { path, query } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_ });
  return shareFor_(ctx, sessionRow_(ctx, path.session_id), query.lang);
}

/** The class group's link, optional: given, it is checked before it is saved; empty or null, it is removed. */
function updateSettings_(ctx) {
  teacher_(ctx);
  const { body } = ctx.check({ body: BODY_.settings });
  if (body.group_link !== undefined) {
    ctx.db.setSetting('group_link', (body.group_link || '').trim() ? cleanGroupLink_(body.group_link) : null);
  }
  return { group_link: ctx.db.setting('group_link'), group_code: ctx.db.setting('group_code') };
}

function rotateGroupCode_(ctx) {
  teacher_(ctx);
  ctx.db.setSetting('group_code', newCode_());
  return { group_code: ctx.db.setting('group_code') };
}

function invite_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  return { text: inviteMessage_(ctx.db.setting('group_code'), ctx.db.setting('app_link'), query.lang) };
}

function students_(ctx) {
  teacher_(ctx);
  const joined = {};
  ctx.db.t('checkins').rows.forEach((c) => {
    if (c.phase === 'before') joined[c.user_id] = (joined[c.user_id] || 0) + 1;
  });
  const rows = ctx.db.t('users').rows
    .filter((u) => u.role === 'student')
    .sort((a, b) => (b.status === 'pending') - (a.status === 'pending') || b.created_at - a.created_at || a.id - b.id);
  return { students: rows.map((u) => Object.assign(userJson_(u), { joined: joined[u.id] || 0, intake: intakeOf_(ctx, u.id) })) };
}

/** Removes a student, or takes a removed one back into their batch; placing a new student is placeInBatch_. */
function setStatus_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.status });
  const student = studentRow_(ctx, path.user_id);
  if (body.status === 'approved' && !student.batch) throw new HttpError_(400, 'needs_batch');
  ctx.db.t('users').update(student, { status: body.status });
  return { ok: true };
}

/** Places a student in a batch: a new one ("Approve into a batch"), or one moving after a review. Each is logged in
 * batch_changes, with the teacher's note. */
function placeInBatch_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.place });
  const student = studentRow_(ctx, path.user_id);
  if (!batches_(ctx)[body.batch]) throw new HttpError_(400, 'no_batch');
  const changes = ctx.db.t('batch_changes');
  changes.insert([{ id: changes.nextId(), student_id: student.id, from: student.batch || null, to: body.batch,
    note: body.note === null ? null : body.note.trim() || null, created_at: ctx.now }]);
  ctx.db.t('users').update(student, { batch: body.batch, batch_since: ctx.now, status: 'approved' });
  return { ok: true, student: userJson_(student) };
}

/** A new temporary password for a student who forgot theirs, for the teacher to pass on however the class keeps in
 * touch; the student can change it from the Me tab. Signs the student out everywhere. A copy of the request (the
 * teacher's second confirm, or a retry, with the same request id) gets the same password, even arriving together. */
function resetPassword_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: PATH_USER_ });
  const password = newCode_(8);
  const pwHash = hashPassword_(password);
  return ctx.lock(() => {
    const kept = replayed_(ctx.request); // a copy of this request that had the lock first
    if (kept) return kept;
    const users = ctx.db.t('users');
    const student = studentRow_(ctx, path.user_id);
    users.update(student, { pw_hash: pwHash });
    const tokens = ctx.db.t('tokens');
    tokens.remove(tokens.rows.filter((r) => r.user_id === student.id));
    ctx.db.changedCache = true;
    return keepAnswer_(ctx.request, { password: password });
  });
}

/** How the last two weeks of classes went, from the students' one-tap check-ins and feedback. */
function insights_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const batches = batches_(ctx);
  const now = ctx.now;
  const checkins = ctx.db.t('checkins').rows;
  const bySession = {};
  checkins.forEach((c) => {
    (bySession[c.session_id] || (bySession[c.session_id] = [])).push(c);
  });
  const mean = (values) => (values.length ? values.reduce((a, b) => a + b, 0) / values.length : null);
  const sessions = ctx.db.t('class_sessions').rows
    .filter((s) => s.starts_at >= now - 14 * DAY_MS_ && s.starts_at <= now)
    .sort((a, b) => b.starts_at - a.starts_at)
    .map((s) => {
      const list = bySession[s.id] || [];
      const before = list.filter((c) => c.phase === 'before');
      const moods = (rows) => rows.map((c) => c.mood).filter((m) => m !== null); // one who came with no mood before has none
      return { id: s.id, starts_at: isoTime_(s.starts_at), class: batchJson_(batches[s.batch], s.batch, query.lang).name, joined: before.length,
        mood_before: mean(moods(before)), mood_after: mean(moods(list.filter((c) => c.phase === 'after'))) };
    });
  const [change, pairs] = moodChange_(checkins);
  const users = ctx.db.t('users').rows;
  const count = (status) => users.filter((u) => u.role === 'student' && u.status === status).length;
  const names = {};
  users.forEach((u) => {
    names[u.id] = u.name;
  });
  const feedback = ctx.db.t('feedback').rows
    .filter((f) => Object.prototype.hasOwnProperty.call(names, f.user_id))
    .sort((a, b) => b.created_at - a.created_at || a.id - b.id) // equal times in the order written
    .slice(0, 20)
    .map((f) => ({ screen: f.screen, text: f.text, created_at: isoTime_(f.created_at), name: names[f.user_id] }));
  return {
    students: { approved: count('approved') },
    mood_change: change,
    mood_pairs: pairs,
    sessions: sessions,
    feedback: feedback,
  };
}

/** The notes students chose to share, newest first (the last 50). */
function sharedNotes_(ctx) {
  teacher_(ctx);
  const names = {};
  ctx.db.t('users').rows.forEach((u) => {
    names[u.id] = u.name;
  });
  const all = ctx.db.t('shared_notes').rows
    .filter((n) => Object.prototype.hasOwnProperty.call(names, n.user_id))
    .sort((a, b) => b.created_at - a.created_at || b.id - a.id);
  // The newest 50 to read; the count is of them all.
  const shared = all.slice(0, 50)
    .map((n) => ({ id: n.id, user_id: n.user_id, name: names[n.user_id], text: n.text, created_at: isoTime_(n.created_at) }));
  return { shared: shared, count: all.length };
}

// ---------- Setup: the tabs, the codes and the Dashboard ----------
// Run setup() once from the script editor (it asks for permission the first time). Running it again is safe: it adds
// what is missing and leaves the data, the codes, the batches, the curriculum and an existing Dashboard alone.

const DATA_TABS_ = ['users', 'class_sessions', 'checkins', 'practice', 'solo_sessions', 'asana_feedback', 'batch_changes', 'intake',
  'intake_ratings', 'feedback', 'shared_notes', 'tokens', 'settings'];
const CURRICULUM_TABS_ = ['library', 'curricula', 'curriculum_items'];
const OWNER_TABS_ = ['batches'].concat(CURRICULUM_TABS_); // the owner's to edit: no warning on hand edits
const HIDDEN_TABS_ = ['intake', 'intake_ratings', 'tokens', 'settings']; // health answers, login-token hashes, the codes
const SETTING_NOTES_ = [
  ['teacher_code', 'The one-time code the teacher signs up with. It stops working once the teacher has an account.'],
  ['group_code', 'Students sign up with this code, which the teacher gives them with the invite; the teacher then places them in a batch. The teacher can change it in the app.'],
  ['group_link', 'Optional: the link to the class\'s group (WhatsApp, Telegram, Signal or any other), set by the teacher in the app. Students see it on the Today tab.'],
  ['app_link', 'Optional: where students get the app, typed here by hand (a download link). When set, the invite the teacher shares says where to get it.'],
];
const TIME_FORMAT_ = 'yyyy-mm-dd hh:mm:ss';
const DATE_FORMAT_ = 'yyyy-mm-dd';

function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  let codes;
  try {
    ss.setSpreadsheetTimeZone('Asia/Kolkata');
    DATA_TABS_.concat(OWNER_TABS_).forEach((name) => ensureTab_(ss, name));
    seedBatches_(ss);
    plainTextTimes_(ss);
    seedCurriculum_(ss);
    codes = ensureSettings_(ss);
    if (!ss.getSheetByName('Dashboard')) writeDashboard_(ss);
    arrangeTabs_(ss);
    SpreadsheetApp.flush();
    bumpCacheGeneration_();
  } finally {
    lock.releaseLock();
  }
  const message = 'Set up. Teacher sign-up code: ' + codes.teacher_code + ' (for ' + STUDIO.teacher.short.en + ', used once). Group code: ' +
    codes.group_code + '. Both are kept in the hidden "settings" tab (View > Hidden sheets). ' +
    'Next: Deploy > New deployment > Web app, Execute as Me, Who has access Anyone.';
  Logger.log(message);
  return message;
}

/** A tab with its header row; columns the code needs and the tab lacks are added at the end. */
function ensureTab_(ss, name) {
  const columns = TABLES_[name];
  let sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  const width = Math.max(sheet.getLastColumn(), 1);
  const header = sheet.getRange(1, 1, 1, width).getValues()[0].map((h) => String(h).trim());
  const empty = header.every((h) => h === '');
  const missing = columns.map(([c]) => c).filter((c) => header.indexOf(c) < 0);
  if (missing.length) {
    const at = empty ? 1 : width + 1;
    if (at + missing.length - 1 > sheet.getMaxColumns()) sheet.insertColumnsAfter(sheet.getMaxColumns(), at + missing.length - 1 - sheet.getMaxColumns());
    sheet.getRange(1, at, 1, missing.length).setValues([missing]);
  }
  const names = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map((h) => String(h).trim());
  sheet.getRange(1, 1, 1, names.length).setFontWeight('bold');
  sheet.setFrozenRows(1);
  columns.forEach(([col, type]) => {
    if (type !== 'time' && type !== 'date') return;
    const rows = sheet.getMaxRows() - 1;
    if (rows > 0) sheet.getRange(2, names.indexOf(col) + 1, rows, 1).setNumberFormat(type === 'time' ? TIME_FORMAT_ : DATE_FORMAT_);
  });
  return sheet;
}

/** The batches tab, filled from content/studio.json while it is empty; after that the Sheet's rows are the batches. */
function seedBatches_(ss) {
  const table = new Table_(ss.getSheetByName('batches'), 'batches');
  if (table.rows.length) return;
  table.insert(STUDIO.batches.map((b) => ({ key: b.key, name: b.name.en, name_hi: b.name.hi, name_mr: b.name.mr, curriculum: b.curriculum,
    days: b.days.join(', '), time: b.time, duration_min: b.duration_min, meet_link: null, about: b.about.en, about_hi: b.about.hi,
    about_mr: b.about.mr })));
}

/** The batches tab's time column as plain text, so a time the owner types stays as typed ("07:00", not a time of day
 * on 30 December 1899, nor the number 7.15). A cell Sheets already took as a time or a number is written back as the
 * time it stands for ("07:15"), so what the owner meant is kept. */
function plainTextTimes_(ss) {
  const sheet = ss.getSheetByName('batches');
  const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map((h) => String(h).trim());
  const column = header.indexOf('time') + 1;
  const range = sheet.getRange(2, column, sheet.getMaxRows() - 1, 1);
  const values = range.getValues();
  range.setNumberFormat('@');
  values.forEach(([value], i) => {
    if (isDate_(value) || typeof value === 'number') sheet.getRange(i + 2, column).setValue(clockText_(value));
  });
}

/** The curriculum tabs, filled from content/curriculum.json while they are empty, with "{teacher}" in its text
 * written as the studio names the teacher; after that the Sheet's rows are the curriculum. The curricula tab's first
 * cell notes where the mock curriculum comes from. */
function seedCurriculum_(ss) {
  const pick = (text) => LANGS_.map((lang) => fill_(text[lang], { teacher: STUDIO.teacher.short[lang] }));
  const rows = {
    library: CURRICULUM.library.map((i) => ({ key: i.key, type: i.type, level: i.level, sanskrit: i.sanskrit, name: i.name,
      english: i.english, aliases: i.aliases.join(', '), source: i.source })),
    curricula: CURRICULUM.curricula.map((c) => {
      const [name, nameHi, nameMr] = pick(c.name);
      const [about, aboutHi, aboutMr] = pick(c.about);
      return { key: c.key, name: name, name_hi: nameHi, name_mr: nameMr, level: c.level, about: about, about_hi: aboutHi,
        about_mr: aboutMr, source: c.source };
    }),
    curriculum_items: CURRICULUM.curricula.reduce((all, c) => all.concat(c.items.map((it, i) => {
      const [cue, cueHi, cueMr] = pick(it.cue);
      return { curriculum: c.key, position: i + 1, item: it.item, dose: it.dose, unit: it.unit, cue: cue, cue_hi: cueHi, cue_mr: cueMr };
    })), []),
  };
  CURRICULUM_TABS_.forEach((name) => {
    const table = new Table_(ss.getSheetByName(name), name);
    if (!table.rows.length) table.insert(rows[name]);
  });
  ss.getSheetByName('curricula').getRange(1, 1).setNote(fill_(CURRICULUM.about, { teacher: STUDIO.teacher.short.en }));
}

/** The teacher and group codes, made once, and a row (with a note) for each setting. */
function ensureSettings_(ss) {
  const sheet = ss.getSheetByName('settings');
  if (sheet.getRange(1, 3).getValue() === '') sheet.getRange(1, 3).setValue('about').setFontWeight('bold');
  const table = new Table_(sheet, 'settings');
  const have = {};
  table.rows.forEach((r) => {
    have[r.key] = r;
  });
  if (!have.teacher_code || !have.teacher_code.value) setRow_(table, have, 'teacher_code', newCode_(8));
  if (!have.group_code || !have.group_code.value) setRow_(table, have, 'group_code', newCode_());
  SETTING_NOTES_.forEach(([key, note]) => {
    if (!have[key]) setRow_(table, have, key, null);
    sheet.getRange(have[key]._row, 3).setValue(encode_(note, 'text'));
  });
  return { teacher_code: have.teacher_code.value, group_code: have.group_code.value };
}

function setRow_(table, have, key, value) {
  if (have[key]) table.update(have[key], { value: value });
  else have[key] = table.insert([{ key: key, value: value }])[0];
}

function arrangeTabs_(ss) {
  const ours = { Dashboard: true };
  DATA_TABS_.concat(OWNER_TABS_).forEach((name) => {
    ours[name] = true;
  });
  const dashboard = ss.getSheetByName('Dashboard');
  ss.setActiveSheet(dashboard);
  ss.moveActiveSheet(1);
  DATA_TABS_.forEach((name) => {
    const sheet = ss.getSheetByName(name);
    if (HIDDEN_TABS_.indexOf(name) >= 0) sheet.hideSheet();
    if (sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET).length === 0) {
      sheet.protect().setDescription('Written by the app: Sheets asks before a hand edit').setWarningOnly(true);
    }
  });
  ss.getSheets().forEach((sheet) => {
    if (!ours[sheet.getName()] && sheet.getLastRow() === 0 && sheet.getLastColumn() === 0) ss.deleteSheet(sheet); // the empty Sheet1
  });
}

/** Column letters of a tab by header name, as the tab is now. */
function columnLetters_(ss, name) {
  const sheet = ss.getSheetByName(name);
  const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const out = {};
  header.forEach((h, i) => {
    out[String(h).trim()] = columnLetter_(i + 1);
  });
  out._last = columnLetter_(header.length);
  return out;
}

function columnLetter_(n) {
  let s = '';
  while (n > 0) {
    const m = (n - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    n = Math.floor((n - 1) / 26);
  }
  return s;
}

/** The Dashboard's blocks: [the cell its formula starts in (the title goes above), title, note, formula, number formats]. */
function dashboardBlocks_(ss) {
  const u = columnLetters_(ss, 'users');
  const c = columnLetters_(ss, 'checkins');
  const f = columnLetters_(ss, 'feedback');
  const n = columnLetters_(ss, 'shared_notes');
  const p = columnLetters_(ss, 'practice');
  const m = columnLetters_(ss, 'batch_changes');
  const k = columnLetters_(ss, 'intake');
  const users = 'users!A1:' + u._last;
  const checkins = 'checkins!A1:' + c._last;
  const col = (tab, letter) => tab + '!' + letter + '2:' + letter;
  const names = '{' + col('users', u.id) + ', ' + col('users', u.name) + '}';
  const nameOf = (tab, letter) => 'ARRAYFORMULA(IFERROR(VLOOKUP(' + col(tab, letter) + ', ' + names + ', 2, FALSE), ""))';
  return [
    ['A5', 'Students by status', 'Students only, not the teacher.',
      '=IFERROR(QUERY(' + users + ', "select ' + u.status + ', count(' + u.id + ') where ' + u.role + " = 'student' group by " +
        u.status + ' label ' + u.status + " 'status', count(" + u.id + ") 'students'\", 1), \"No students yet\")", {}],
    ['H5', 'Students per batch', 'Approved students in each batch.',
      '=IFERROR(QUERY(' + users + ', "select ' + u.batch + ', count(' + u.id + ') where ' + u.role + " = 'student' and " + u.status +
        " = 'approved' group by " + u.batch + ' label ' + u.batch + " 'batch', count(" + u.id + ") 'students'\", 1), \"No students yet\")", {}],
    ['K5', 'Batch changes', 'The latest 8 placements and moves, newest first; the batch_changes tab has them all.',
      '=IFERROR(QUERY({' + [col('batch_changes', m.created_at), nameOf('batch_changes', m.student_id), col('batch_changes', m.from),
        col('batch_changes', m.to), col('batch_changes', m.note)].join(', ') + "}, \"select Col1, Col2, Col3, Col4, Col5 where Col1 is not " +
        "null order by Col1 desc limit 8 label Col1 'when', Col2 'student', Col3 'from', Col4 'to', Col5 'note'\", 0), \"No batch changes yet\")",
      { 'K6:K13': 'yyyy-mm-dd' }],
    ['Q5', 'Pain areas', 'How many students named each in their intake. Counts only: the answers themselves stay in the hidden tabs.',
      '=IFERROR(QUERY({' + PAIN_AREAS_.map((a) => '"' + a + '", COUNTIF(' + col('intake', k.pain) + ', "*' + a + '*")').join('; ') +
        "}, \"select Col1, Col2 label Col1 'pain area', Col2 'students'\", 0), \"No intake yet\")", {}],
    ['D5', 'Mood per class', 'Average mood after and before class, all classes so far. 1 very low to 5 great.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class + ', avg(' + c.mood + ') where ' + c.user_id + ' is not null group by ' +
        c.class + ' pivot ' + c.phase + '", 1), "No check-ins yet")', { 'E6:F13': '0.0' }],
    ['A16', 'Students', 'Every student, newest first, with their batch and the number of classes they came to: checked in ' +
      'before, or said after class how it went.',
      '=IFERROR(QUERY({' + [col('users', u.name), col('users', u.phone), col('users', u.status), col('users', u.batch), col('users', u.lang),
        'ARRAYFORMULA(IF(' + col('users', u.id) + ' = "", , COUNTIFS(' + col('checkins', c.user_id) + ', ' + col('users', u.id) + ', ' +
          col('checkins', c.phase) + ', "before")))', col('users', u.created_at), col('users', u.role)].join(', ') +
        "}, \"select Col1, Col2, Col3, Col4, Col5, Col6, Col7 where Col8 = 'student' order by Col7 desc label Col1 'name', Col2 'phone', " +
        "Col3 'status', Col4 'batch', Col5 'language', Col6 'classes joined', Col7 'signed up'\", 0), \"No students yet\")", { 'G17:G': DATE_FORMAT_ }],
    ['H16', 'Attendance per class', 'Everyone who came to each class, newest first: who checked in before it, and who said ' +
      'after it how it went without checking in.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class_date + ', ' + c.class + ', count(' + c.user_id + ') where ' + c.phase +
        " = 'before' group by " + c.class_date + ', ' + c.class + ' order by ' + c.class_date + ' desc label count(' + c.user_id +
        ") 'joined'\", 1), \"No check-ins yet\")", { 'H17:H': 'ddd d mmm yyyy' }],
    ['L16', 'Mood by class and date', 'Average mood after and before each class, newest first.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class_date + ', ' + c.class + ', avg(' + c.mood + ') where ' + c.user_id +
        ' is not null group by ' + c.class_date + ', ' + c.class + ' pivot ' + c.phase + ' order by ' + c.class_date +
        ' desc", 1), "No check-ins yet")', { 'L17:L': 'ddd d mmm yyyy', 'N17:O': '0.0' }],
    ['Q16', 'Feedback', 'What students wrote from the app, newest first.',
      '=IFERROR(QUERY({' + [col('feedback', f.created_at), nameOf('feedback', f.user_id), col('feedback', f.screen),
        col('feedback', f.text)].join(', ') + "}, \"select Col1, Col2, Col3, Col4 where Col1 is not null order by Col1 desc " +
        "label Col1 'when', Col2 'student', Col3 'screen', Col4 'feedback'\", 0), \"No feedback yet\")", { 'Q17:Q': 'yyyy-mm-dd hh:mm' }],
    ['V16', 'Shared notes', 'Notes students chose to share with the teacher from the companion, newest first.',
      '=IFERROR(QUERY({' + [col('shared_notes', n.created_at), nameOf('shared_notes', n.user_id), col('shared_notes', n.text)].join(', ') +
        "}, \"select Col1, Col2, Col3 where Col1 is not null order by Col1 desc label Col1 'when', Col2 'student', Col3 'note'\", 0), " +
        '"No shared notes yet")', { 'V17:V': 'yyyy-mm-dd hh:mm' }],
    ['Z16', 'Strain or pain, last 14 days', 'Items a student marked "felt strain or pain", after class or on their own, newest first.',
      '=IFERROR(QUERY({' + [col('practice', p.created_at), nameOf('practice', p.user_id), col('practice', p.item_name),
        col('practice', p.note), col('practice', p.pain)].join(', ') + "}, \"select Col1, Col2, Col3, Col4 where Col5 = 1 and Col1 >= " +
        "datetime '\" & TEXT(TODAY() - 14, \"yyyy-mm-dd hh:mm:ss\") & \"' order by Col1 desc label Col1 'when', Col2 'student', " +
        "Col3 'item', Col4 'note'\", 0), \"No strain or pain in the last 14 days\")", { 'Z17:Z': 'yyyy-mm-dd hh:mm' }],
    ['AE16', 'Reactions per item, week by week', 'Average reaction, after class or on their own: 1 not yet, 2 with effort, 3 steady, 4 at ease. ' +
      'One column per week, headed by its Monday.',
      '=IFERROR(QUERY(practice!A1:' + p._last + ', "select ' + p.item_name + ', avg(' + p.reaction + ') where ' + p.reaction +
        ' is not null group by ' + p.item_name + ' pivot ' + p.week + '", 1), "No reactions yet")', { 'AF17:CB': '0.0', 'AF16:CB16': 'd mmm' }],
  ];
}

function writeDashboard_(ss) {
  const sheet = ss.insertSheet('Dashboard');
  if (sheet.getMaxColumns() < 80) sheet.insertColumnsAfter(sheet.getMaxColumns(), 80 - sheet.getMaxColumns());
  sheet.getRange('A1').setValue('Satt Chitt Anand: the studio at a glance').setFontWeight('bold').setFontSize(14);
  sheet.getRange('A2').setValue('Each block is one formula over the tabs; click its first cell to read or change it. Times are ' +
    'India time. Add blocks of your own anywhere: setup() never rewrites this tab (delete it and run setup again for a fresh one).');
  dashboardBlocks_(ss).forEach(([cell, title, note, formula, formats]) => {
    const anchor = sheet.getRange(cell);
    const row = anchor.getRow();
    const column = anchor.getColumn();
    sheet.getRange(row - 1, column).setValue(title).setFontWeight('bold');
    sheet.getRange(row - 1, column).setNote(note);
    sheet.getRange(row, column).setFormula(formula);
    Object.keys(formats).forEach((range) => sheet.getRange(range).setNumberFormat(formats[range]));
  });
}

// ---------- Reset: the Sheet's own menu, to clear test people or start the studio again ----------
// onOpen adds a "Satt Chitt Anand" menu to the Sheet. Each item says first what it removes and what stays, and asks;
// then it deletes rows under the script lock, as the app's writes do, and makes the app forget what it cached, so a
// removed person's phone is signed out at its next request, and the numbers it kept for them (phoneHeld_), so they can
// sign up again at once. Ids are never given again (newIds_): after a reset the next person's id follows the last one
// given, not 1. Rows are deleted whole, so every tab keeps its header and
// the Dashboard's formulas go on reading it. A person's rows are found by the person column of each tab in TABLES_
// (personTabs_), so a tab added later with a user_id or student_id column is cleared with the rest.

const TEST_NAME_ = 'TEST';
// How the dialogs name a row of each tab: [one, many].
const ROW_WORDS_ = {
  tokens: ['sign-in', 'sign-ins'],
  checkins: ['check-in', 'check-ins'],
  feedback: ['feedback message from the app', 'feedback messages from the app'],
  shared_notes: ['shared note', 'shared notes'],
  intake: ['intake', 'intakes'],
  intake_ratings: ['intake self-assessment answer', 'intake self-assessment answers'],
  batch_changes: ['batch placement or move', 'batch placements and moves'],
  practice: ['practice item (after class or on their own)', 'practice items (after class or on their own)'],
  solo_sessions: ['practice on their own', 'practices on their own'],
  asana_feedback: ['note from the teacher on an item', 'notes from the teacher on items'],
};

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Satt Chitt Anand')
    .addItem('Remove test people…', 'removeTestPeople')
    .addItem('Reset the studio…', 'resetStudio')
    .addSeparator()
    .addItem('New group code…', 'newGroupCode')
    .addToUi();
}

/** Every tab whose rows are one person's, with the column naming them: [[tab, column]]. */
function personTabs_() {
  return Object.keys(TABLES_)
    .map((name) => [name, TABLES_[name].map(([col]) => col).filter((col) => col === 'user_id' || col === 'student_id')[0]])
    .filter(([, col]) => col);
}

/** A name starting with TEST, in any case, spaces before it aside. */
function isTestName_(name) {
  return String(name === null || name === undefined ? '' : name).trim().toUpperCase().indexOf(TEST_NAME_) === 0;
}

/** What removing the people `pick` chooses would delete: their users rows, and their rows of each person tab. With
 * `everything`, every row of the person tabs, so rows left by someone deleted from users by hand go too. */
function removal_(db, pick, everything) {
  const people = db.t('users').rows.filter(pick);
  const ids = {};
  people.forEach((u) => {
    ids[u.id] = true;
  });
  const rows = {};
  personTabs_().forEach(([name, col]) => {
    rows[name] = db.t(name).rows.filter((r) => everything || ids[r[col]] === true);
  });
  return { people: people, rows: rows };
}

/** A removal as counts: {people, teacher (one of them is the teacher), rows: {tab: count}, total}. */
function removalCounts_(removal) {
  const rows = {};
  let total = 0;
  Object.keys(removal.rows).forEach((name) => {
    rows[name] = removal.rows[name].length;
    total += rows[name];
  });
  return { people: removal.people.length, teacher: removal.people.some((u) => u.role === 'teacher'), rows: rows, total: total };
}

/** Runs `fn` under the script lock with the Sheet read afresh (a flush first, as Context_.lock does), then flushes and
 * starts a new cache generation, so no request goes on using a login token or setting cached before. */
function menuLock_(db, fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('The app is busy writing to the Sheet. Try again in a minute.');
  try {
    SpreadsheetApp.flush();
    db.dropAll();
    return fn();
  } finally {
    try {
      SpreadsheetApp.flush();
      bumpCacheGeneration_();
    } finally {
      db.dropAll();
      lock.releaseLock();
    }
  }
}

/** Under the lock: removes the people `pick` chooses and their rows (every row of the person tabs, with
 * `everything`); the counts. Their numbers are forgotten first, then their sign-ins and their other rows go, and their
 * users rows last, so a removal cut short leaves no one signed in and can simply be run again. */
function removePeople_(db, pick, everything) {
  return menuLock_(db, () => removeLocked_(db, pick, everything));
}

function removeLocked_(db, pick, everything) {
  const removal = removal_(db, pick, everything);
  forgetPhones_(removal.people, everything);
  personTabs_().forEach(([name]) => db.t(name).remove(removal.rows[name]));
  db.t('users').remove(removal.people);
  return removalCounts_(removal);
}

/** Under the lock: what the teacher set on the batches and the classes put back as setup() leaves it: each batch's
 * everyday Meet link emptied, and each class's own link and curriculum, and a time the teacher gave a class back to its
 * batch's on the class's date, so a class follows its batch again. The batches' names, days and times, the curriculum
 * tabs and the settings stay. The rows changed. */
function clearTeacherSettings_(db) {
  let changed = 0;
  const table = db.t('batches');
  table.rows.filter((r) => r.meet_link).forEach((r) => {
    table.update(r, { meet_link: null });
    changed++;
  });
  const batches = batches_({ db: db });
  const classes = db.t('class_sessions');
  classes.rows.filter((r) => r.meet_link || r.curriculum || r.time_set_by).forEach((r) => {
    const changes = { meet_link: null, curriculum: null };
    const batch = batches[r.batch];
    if (r.time_set_by) {
      changes.time_set_by = null;
      if (batch && batch.start_min !== null) {
        changes.starts_at = istMidnight_(istDay_(r.starts_at)) + batch.start_min * 60000;
        changes.duration_min = batch.duration_min;
      }
    }
    classes.update(r, changes);
    changed++;
  });
  return changed;
}

/** Everyone whose name starts with TEST, and every row of theirs; the counts. */
function removeTestPeople_(db) {
  return removePeople_(db, (u) => isTestName_(u.name));
}

/** Everyone, the teacher too, and every row of the person tabs, and what the teacher set on the batches and classes
 * (clearTeacherSettings_); the counts, with `cleared`, the batch and class rows put back. The batches, the curriculum,
 * the classes, the settings and the Dashboard stay, as setup() left them, so the teacher code works again. */
function resetStudio_(db) {
  return menuLock_(db, () => Object.assign(removeLocked_(db, () => true, true), { cleared: clearTeacherSettings_(db) }));
}

/** A new group code, as the teacher can make from the app; the code. */
function newGroupCode_(db) {
  return menuLock_(db, () => {
    const code = newCode_();
    db.setSetting('group_code', code);
    return code;
  });
}

function count_(n, one, many) {
  return n + ' ' + (n === 1 ? one : many);
}

/** "4 sign-ins, 10 check-ins and 2 shared notes", the tabs with any. */
function rowsText_(counts) {
  const parts = Object.keys(counts.rows).filter((name) => counts.rows[name]).map((name) => {
    const words = ROW_WORDS_[name] || [name + ' row', name + ' rows'];
    return count_(counts.rows[name], words[0], words[1]);
  });
  return parts.length > 1 ? parts.slice(0, -1).join(', ') + ' and ' + parts[parts.length - 1] : parts.join('');
}

// ---------- the menu's items: thin wrappers that ask, then call the functions above ----------

/** The menu's "Remove test people…". */
function removeTestPeople() {
  const ui = SpreadsheetApp.getUi();
  const title = 'Remove test people';
  const db = new Db_();
  const removal = removal_(db, (u) => isTestName_(u.name));
  const plan = removalCounts_(removal);
  if (!plan.people) {
    ui.alert(title, 'No one\'s name starts with TEST, so there is no one to remove.', ui.ButtonSet.OK);
    return;
  }
  const list = removal.people.map((u) => '• ' + u.name + ' (' + u.phone + (u.role === 'teacher' ? ', the teacher' : '') + ')').join('\n');
  const text = 'Remove ' + count_(plan.people, 'person whose name starts', 'people whose names start') + ' with TEST' +
    (plan.total ? ', and the ' + count_(plan.total, 'row', 'rows') + ' that are theirs?' : '? They have no other rows.') + '\n\n' +
    list + '\n\n' + (plan.total ? 'Their rows: ' + rowsText_(plan) + '.\n\n' : '') +
    'Everyone else and their rows stay, as do the batches, the curriculum, the classes and the settings. ' +
    'A phone signed in as one of these people is signed out.' +
    (plan.teacher ? ' The teacher code works again, for the teacher to sign up anew.' : '') + '\n\nThis cannot be undone.';
  if (ui.alert(title, text, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  const done = removeTestPeople_(db);
  ui.alert(title, 'Removed ' + count_(done.people, 'person', 'people') + ' and ' + count_(done.total, 'row', 'rows') + '.', ui.ButtonSet.OK);
}

/** The menu's "Reset the studio…": asks twice, the second time for RESET typed in. */
function resetStudio() {
  const ui = SpreadsheetApp.getUi();
  const title = 'Reset the studio';
  const plan = removalCounts_(removal_(new Db_(), () => true, true));
  if (!plan.people && !plan.total) {
    ui.alert(title, 'No one has signed up and there are no rows of anyone\'s: the studio is as setup left it.', ui.ButtonSet.OK);
    return;
  }
  const text = 'This removes everyone signed up (' + count_(plan.people, 'person', 'people') +
    (plan.teacher ? ', the teacher among them' : '') + ') and every row they made (' + count_(plan.total, 'row', 'rows') + ')' +
    (plan.total ? ': ' + rowsText_(plan) : '') + '. Every phone is signed out.\n\n' +
    'The Meet links the teacher set go too, each batch\'s and each class\'s own, and the curriculum and the time chosen ' +
    'for a class, so each class follows its batch again, as setup left them.\n\n' +
    'What stays: the batches (their names, days and times), the curriculum (library, curricula, curriculum_items), the ' +
    'classes (class_sessions), the settings (the teacher code, the group code, the group link and the app link) and the ' +
    'Dashboard. Afterwards the teacher signs up again with the same teacher code, and students with the same group ' +
    'code.\n\nThis cannot be undone. Go on?';
  if (ui.alert(title, text, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  const typed = ui.prompt(title, 'To remove ' + count_(plan.people, 'person', 'people') + ' and ' + count_(plan.total, 'row', 'rows') +
    ', type RESET and click OK.', ui.ButtonSet.OK_CANCEL);
  if (typed.getSelectedButton() !== ui.Button.OK) return;
  if (typed.getResponseText().trim() !== 'RESET') {
    ui.alert(title, 'Nothing was removed: the box did not say RESET.', ui.ButtonSet.OK);
    return;
  }
  const done = resetStudio_(new Db_());
  ui.alert(title, 'The studio is reset: ' + count_(done.people, 'person', 'people') + ' and ' + count_(done.total, 'row', 'rows') +
    ' were removed, and the Meet links, curricula and class times the teacher set cleared. The teacher can sign up again with the ' +
    'teacher code (in the hidden settings tab), and students with the group code.', ui.ButtonSet.OK);
}

/** The menu's "New group code…". */
function newGroupCode() {
  const ui = SpreadsheetApp.getUi();
  const title = 'New group code';
  const ask = 'Make a new group code? Students sign up with it. The current code stops working, so an invite already ' +
    'sent with it no longer lets anyone sign up; everyone already signed up stays signed in.';
  if (ui.alert(title, ask, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  const code = newGroupCode_(new Db_());
  ui.alert(title, 'The new group code is ' + code + '. The teacher sees it in the app, and the invite shared from the app carries it.',
    ui.ButtonSet.OK);
}
