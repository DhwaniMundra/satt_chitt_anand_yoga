const QUERY_LANG_ = { lang: F_.oneOf(LANGS_, { def: 'en' }) };
// A 422 names the parameter, so they carry their names.
const PATH_SESSION_ = { session_id: F_.int(REQUIRED_) };
const PATH_USER_ = { user_id: F_.int(REQUIRED_) };
