  "curricula": [
    {
      "key": "beginner",
      "level": 1,
      "name": {
        "en": "Beginner",
        "hi": "शुरुआती",
        "mr": "नवशिके"
      },
      "about": {
        "en": "Foundations: the breath, simple postures held steady, then stillness.",
        "hi": "बुनियाद: साँस, स्थिर रखे सरल आसन, फिर स्थिरता।",
        "mr": "पाया: श्वास, स्थिर ठेवलेली सोपी आसने, मग स्थिरता."
      },
      "source": "Common Yoga Protocol (Ministry of AYUSH), in its order",
      "items": [
        {
          "item": "sectional_breathing",
          "dose": 3,
          "unit": "minutes",
          "cue": {
            "en": "Breathe into the belly, ribs, then chest; out in the same order.",
            "hi": "पेट, पसलियों, फिर छाती में साँस भरें; उसी क्रम में छोड़ें।",
            "mr": "पोट, बरगड्या, मग छातीत श्वास भरा; त्याच क्रमाने सोडा."
          }
        },
        {
          "item": "omkar",
          "dose": 3,
          "unit": "rounds",
          "cue": {
            "en": "A long, easy Om; feel it in the chest.",
            "hi": "लंबा, सहज ॐ; छाती में कंपन महसूस करें।",
            "mr": "लांब, सहज ॐ; छातीत कंपन अनुभवा."
          }
        },
        {
          "item": "tadasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Weight even on both feet; lengthen through the crown.",
            "hi": "दोनों पैरों पर बराबर वज़न; सिर के ऊपर तक लंबे हों।",
            "mr": "दोन्ही पायांवर समान भार; डोक्यापर्यंत उंच व्हा."
          }
        },
        {
          "item": "vrikshasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Each side. Foot on the calf or thigh, never the knee.",
            "hi": "दोनों ओर। पैर पिंडली या जाँघ पर, घुटने पर कभी नहीं।",
            "mr": "दोन्ही बाजूंनी. पाय पोटरीवर किंवा मांडीवर, गुडघ्यावर कधीच नाही."
          }
        },
        {
          "item": "padahastasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Bend the knees as needed; let the head hang.",
            "hi": "ज़रूरत हो तो घुटने मोड़ें; सिर ढीला छोड़ें।",
            "mr": "गरज असल्यास गुडघे वाकवा; डोके सैल सोडा."
          }
        },
        {
          "item": "ardha_chakrasana",
          "dose": 3,
          "unit": "breaths",
          "cue": {
            "en": "Hands support the lower back; look up, not back.",
            "hi": "हाथ कमर को सहारा दें; ऊपर देखें, पीछे नहीं।",
            "mr": "हात कमरेला आधार देतात; वर पाहा, मागे नाही."
          }
        },
        {
          "item": "trikonasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Each side. Hand to the shin, not the floor; both sides of the waist long.",
            "hi": "दोनों ओर। हाथ पिंडली पर, ज़मीन पर नहीं; कमर के दोनों ओर लंबे।",
            "mr": "दोन्ही बाजूंनी. हात पोटरीवर, जमिनीवर नाही; कमरेच्या दोन्ही बाजू लांब."
          }
        },
        {
          "item": "vajrasana",
          "dose": 1,
          "unit": "minutes",
          "cue": {
            "en": "A cushion under the ankles if they ache; come out at any knee pain.",
            "hi": "टखनों में दर्द हो तो नीचे गद्दी; घुटने में दर्द हो तो बाहर आएँ।",
            "mr": "घोटे दुखल्यास खाली उशी; गुडघा दुखल्यास बाहेर या."
          }
        },
        {
          "item": "shashankasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Forehead down, arms long; breathe into the back.",
            "hi": "माथा नीचे, बाँहें लंबी; पीठ में साँस भरें।",
            "mr": "कपाळ खाली, हात लांब; पाठीत श्वास भरा."
          }
        },
        {
          "item": "vakrasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Each side. Turn from the waist; spine tall.",
            "hi": "दोनों ओर। कमर से मुड़ें; रीढ़ सीधी।",
            "mr": "दोन्ही बाजूंनी. कमरेतून वळा; पाठीचा कणा ताठ."
          }
        },
        {
          "item": "makarasana",
          "dose": 1,
          "unit": "minutes",
          "cue": {
            "en": "Rest on the forearms; let the belly soften.",
            "hi": "कोहनियों पर आराम; पेट ढीला छोड़ें।",
            "mr": "कोपरांवर विसावा; पोट सैल सोडा."
          }
        },
        {
          "item": "bhujangasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Three times. Elbows close; lift with the back, not the hands.",
            "hi": "तीन बार। कोहनियाँ पास; हाथों से नहीं, पीठ से उठें।",
            "mr": "तीन वेळा. कोपर जवळ; हातांनी नाही, पाठीने उचला."
          }
        },
        {
          "item": "shalabhasana",
          "dose": 3,
          "unit": "breaths",
          "cue": {
            "en": "One leg at a time, each side; hips stay down.",
            "hi": "एक-एक पैर, दोनों ओर; कूल्हे ज़मीन पर।",
            "mr": "एका वेळी एक पाय, दोन्ही बाजूंनी; नितंब जमिनीवर."
          }
        },
        {
          "item": "setu_bandhasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Twice. Feet hip-width; lift the hips, not the neck.",
            "hi": "दो बार। पैर कूल्हों जितने खुले; कूल्हे उठाएँ, गर्दन नहीं।",
            "mr": "दोन वेळा. पाय नितंबांइतक्या अंतरावर; नितंब उचला, मान नाही."
          }
        },
        {
          "item": "pavanamuktasana",
          "dose": 5,
          "unit": "breaths",
          "cue": {
            "en": "Each side, then both knees; the head can stay down.",
            "hi": "दोनों ओर, फिर दोनों घुटने; सिर नीचे रह सकता है।",
            "mr": "दोन्ही बाजूंनी, मग दोन्ही गुडघे; डोके खाली राहू शकते."
          }
        },
        {
          "item": "nadi_shodhana",
          "dose": 5,
          "unit": "rounds",
          "cue": {
            "en": "Slow and even; no holding the breath.",
            "hi": "धीमी और बराबर; साँस न रोकें।",
            "mr": "संथ आणि समान; श्वास रोखू नका."
          }
        },
        {
          "item": "bhramari",
          "dose": 5,
          "unit": "rounds",
          "cue": {
            "en": "Hum softly on the out-breath; jaw relaxed.",
            "hi": "छोड़ती साँस पर धीमी गुनगुनाहट; जबड़ा ढीला।",
            "mr": "सोडत्या श्वासावर हळू गुंजन; जबडा सैल."
          }
        },
        {
          "item": "shavasana",
          "dose": 5,
          "unit": "minutes",
          "cue": {
            "en": "Let the body be heavy; watch the breath.",
            "hi": "शरीर को भारी होने दें; साँस को देखें।",
            "mr": "शरीर जड होऊ द्या; श्वास पाहा."
          }
        },
        {
          "item": "dhyana",
          "dose": 3,
          "unit": "minutes",
          "cue": {
            "en": "Sit tall and still; return to the breath.",
            "hi": "सीधे और स्थिर बैठें; साँस पर लौटें।",
            "mr": "ताठ आणि स्थिर बसा; श्वासाकडे परत या."
          }
        }
      ]
    },
