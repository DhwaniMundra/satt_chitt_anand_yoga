const LOCK_WAIT_MS_ = 20000;
const CACHE_TTL_S_ = 600;

/** The Sheet as one request sees it: each tab read once, on first use, and kept in step with this request's writes. */
class Db_ {
  constructor() {
    this._ss = null;
    this.tables = {};
    this._settings = null;
    this.changedCache = false; // set by writes that make cached values stale; the lock bumps the cache generation
  }

  ss() {
    if (!this._ss) this._ss = SpreadsheetApp.getActiveSpreadsheet();
    return this._ss;
  }

  t(name) {
    if (!this.tables[name]) {
      const sheet = this.ss().getSheetByName(name);
      if (!sheet) throw new HttpError_(500, 'not_set_up');
      this.tables[name] = new Table_(sheet, name);
    }
    return this.tables[name];
  }

  dropAll() {
    this.tables = {};
    this._settings = null;
  }

  settings() {
    if (this._settings) return this._settings;
    const key = cacheKey_('settings');
    const hit = cacheGet_(key);
    if (hit) {
      this._settings = JSON.parse(hit);
    } else {
      const out = {};
      this.t('settings').rows.forEach((r) => {
        if (r.key && r.value !== null && r.value !== '') out[r.key] = r.value;
      });
      this._settings = out;
      cachePut_(key, JSON.stringify(out));
    }
    return this._settings;
  }

  setting(key) {
    const value = this.settings()[key];
    return value === undefined ? null : value;
  }

  /** Under the lock. */
  setSetting(key, value) {
    const table = this.t('settings');
    const row = table.rows.filter((r) => r.key === key)[0];
    if (row) table.update(row, { value: value });
    else table.insert([{ key: key, value: value }]);
    this.settings()[key] = value;
    this.changedCache = true;
  }
}

class Table_ {
  constructor(sheet, name) {
    this.sheet = sheet;
    this.schema = TABLES_[name];
    const values = sheet.getDataRange().getValues();
    const header = values[0].map((h) => String(h).trim());
    this.cols = {};
    this.schema.forEach(([col]) => {
      const i = header.indexOf(col);
      if (i < 0) throw new HttpError_(500, 'not_set_up');
      this.cols[col] = i;
    });
    const indexes = this.schema.map(([col]) => this.cols[col]);
    this.first = Math.min.apply(null, indexes);
    this.last = Math.max.apply(null, indexes);
    this.lastRow = values.length;
    this.rows = [];
    for (let r = 1; r < values.length; r++) {
      const line = values[r];
      if (line.every((v) => v === '' || v === null)) continue;
      const row = { _row: r + 1 };
      this.schema.forEach(([col, type]) => {
        row[col] = decode_(line[this.cols[col]], type);
      });
      this.rows.push(row);
    }
  }

  nextId() {
    return this.rows.reduce((top, r) => (r.id > top ? r.id : top), 0) + 1;
  }

  /** Appends rows (objects keyed by column name); returns them as stored. */
  insert(objects) {
    if (!objects.length) return [];
    const lines = objects.map((o) => {
      const line = [];
      for (let i = this.first; i <= this.last; i++) line.push('');
      this.schema.forEach(([col, type]) => {
        line[this.cols[col] - this.first] = encode_(o[col], type);
      });
      return line;
    });
    const start = this.lastRow + 1;
    const end = start + lines.length - 1;
    const max = this.sheet.getMaxRows();
    if (end > max) this.sheet.insertRowsAfter(max, end - max + 100);
    this.sheet.getRange(start, this.first + 1, lines.length, this.last - this.first + 1).setValues(lines);
    const added = objects.map((o, i) => {
      const row = { _row: start + i };
      this.schema.forEach(([col, type]) => {
        row[col] = decode_(encode_(o[col], type), type, true);
      });
      return row;
    });
    this.rows = this.rows.concat(added);
    this.lastRow = end;
    return added;
  }

  update(row, changes) {
    Object.keys(changes).forEach((col) => {
      const type = this.schema.filter(([c]) => c === col)[0][1];
      this.sheet.getRange(row._row, this.cols[col] + 1).setValue(encode_(changes[col], type));
      row[col] = changes[col];
    });
  }

  remove(rows) {
    const gone = rows.map((r) => r._row).sort((a, b) => b - a);
    gone.forEach((n) => this.sheet.deleteRow(n));
    this.rows = this.rows.filter((r) => gone.indexOf(r._row) < 0);
    this.rows.forEach((r) => {
      r._row -= gone.filter((n) => n < r._row).length;
    });
    this.lastRow -= gone.length;
  }
}

function isDate_(v) {
  return Object.prototype.toString.call(v) === '[object Date]';
}

function encode_(value, type) {
  if (value === null || value === undefined) return '';
  if (type === 'text' || type === 'text?') return value === '' ? '' : "'" + String(value);
  if (type === 'int') return Number(value);
  return new Date(Math.floor(value / 1000) * 1000); // time, date: milliseconds since 1970, kept to the second as the API sends them
}

/** A cell as the app's value: text, a number, or milliseconds for times. `own` marks a value just encoded. */
function decode_(value, type, own) {
  if (own && (type === 'text' || type === 'text?') && typeof value === 'string' && value.charAt(0) === "'") value = value.slice(1);
  if (type === 'text' || type === 'text?') {
    if (value === '' || value === null) return type === 'text?' ? null : '';
    return isDate_(value) ? isoTime_(value.getTime()) : String(value);
  }
  if (type === 'int') return value === '' || value === null ? null : Number(value);
  if (value === '' || value === null) return null;
  if (isDate_(value)) return Math.round(value.getTime() / 1000) * 1000;
  if (typeof value === 'number') return Math.round(((value - 25569) * 86400000 - IST_OFFSET_MS_) / 1000) * 1000; // a serial day number
  const parsed = Date.parse(String(value));
  return isNaN(parsed) ? null : parsed;
}

// ---------- the cache ----------
// CacheService keeps login-token lookups and the settings for ten minutes. Every key carries a generation; anything
// that could make a cached value wrong (a settings change, a logout, a password reset, a manual edit) starts a new
// generation after its writes are flushed, so no request reads a value older than the last write.

function cache_() {
  return CacheService.getScriptCache();
}

let CACHE_GENERATION_ = null;

function cacheKey_(suffix) {
  if (CACHE_GENERATION_ === null) {
    let gen = cache_().get('gen');
    if (!gen) {
      gen = Utilities.getUuid().slice(0, 8);
      cache_().put('gen', gen, 21600);
    }
    CACHE_GENERATION_ = gen;
  }
  return CACHE_GENERATION_ + ':' + suffix;
}

function bumpCacheGeneration_() {
  CACHE_GENERATION_ = Utilities.getUuid().slice(0, 8);
  cache_().put('gen', CACHE_GENERATION_, 21600);
}

function cacheGet_(key) {
  return cache_().get(key);
}

function cachePut_(key, value) {
  cache_().put(key, value, CACHE_TTL_S_);
}

// ---------- Auth: passwords, login tokens, codes, phone numbers, and the brakes on guessing ----------

// A password is stored as sha256x$<rounds>$<chars>$<salt>$<hash>: `rounds` SHA-256 digests in a row, each over about
// `chars` characters made from the previous digest, the salt and the password. Apps Script has no PBKDF2 and each
// call into Utilities costs a fixed overhead, so the work is put into long inputs rather than many tiny calls (see
// appsscript/README.md for the measured cost). The rounds and length are stored with each hash, so they can be raised
// later without breaking existing passwords.
const HASH_ROUNDS_ = 100;
const HASH_CHARS_ = 131072;
const DUMMY_HASH_ = 'sha256x$' + HASH_ROUNDS_ + '$' + HASH_CHARS_ + '$' + '0'.repeat(32) + '$' + '0'.repeat(64);
const CODE_ALPHABET_ = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no 0/O or 1/I
const ATTEMPT_LIMIT_ = 5;
const ATTEMPT_WINDOW_S_ = 15 * 60;

function digestBytes_(text) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8).map((b) => b & 255);
}

function hex_(bytes) {
  return bytes.map((b) => (b < 16 ? '0' : '') + b.toString(16)).join('');
}

function sha256Hex_(text) {
  return hex_(digestBytes_(text));
}

/** Random bytes from Utilities.getUuid() (java.util.UUID.randomUUID, a SecureRandom): 366 random bits per digest. */
function randomBytes_(n) {
  let out = [];
  while (out.length < n) out = out.concat(digestBytes_(Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid()));
  return out.slice(0, n);
}

function base64Url_(bytes) {
  const abc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
  let out = '';
  for (let i = 0; i < bytes.length; i += 3) {
    const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);
    out += abc[(n >> 18) & 63] + abc[(n >> 12) & 63];
    if (i + 1 < bytes.length) out += abc[(n >> 6) & 63];
    if (i + 2 < bytes.length) out += abc[n & 63];
  }
  return out;
}

/** 32 random bytes as 43 URL-safe characters. The Sheet keeps only their SHA-256. */
function newToken_() {
  return base64Url_(randomBytes_(32));
}

/** A short code people can read out or type. 32 letters, so each random byte gives one letter without bias. */
function newCode_(length) {
  return randomBytes_(length || 6).map((b) => CODE_ALPHABET_[b & 31]).join('');
}

function stretch_(password, salt, rounds, chars) {
  let h = '';
  for (let i = 0; i < rounds; i++) {
    const block = h + salt + password;
    h = sha256Hex_(block.repeat(Math.max(1, Math.floor(chars / block.length))));
  }
  return h;
}

function hashPassword_(password) {
  const salt = hex_(randomBytes_(16));
  return ['sha256x', HASH_ROUNDS_, HASH_CHARS_, salt, stretch_(password, salt, HASH_ROUNDS_, HASH_CHARS_)].join('$');
}

function checkPassword_(password, stored) {
  const parts = String(stored || '').split('$');
  if (parts.length !== 5 || parts[0] !== 'sha256x') return false;
  const rounds = parseInt(parts[1], 10);
  const chars = parseInt(parts[2], 10);
  if (!(rounds > 0 && rounds <= 10000 && chars > 0 && chars <= 4194304)) return false;
  const candidate = stretch_(password, parts[3], rounds, chars);
  const expected = parts[4];
  if (candidate.length !== expected.length) return false;
  let diff = 0; // compare every character, so the time taken does not tell how much matched
  for (let i = 0; i < candidate.length; i++) diff |= candidate.charCodeAt(i) ^ expected.charCodeAt(i);
  return diff === 0;
}

/**
 * The WhatsApp number as +<country><number>, so one person always gets one account however they type it:
 * "98765 43210", "098765 43210", "+91 98765 43210" and "0091 98765 43210" are the same number. A bare 10-digit
 * number, or 11 digits with the trunk prefix 0, is taken as Indian (+91). Devanagari digits count as digits.
 * Throws a 400 bad_phone if it is not a plausible phone number.
 */
function normalizePhone_(raw) {
  let digits = String(raw)
    .replace(/[०-९]/g, (d) => String(d.charCodeAt(0) - 0x966))
    .replace(/\D/g, '');
  if (digits.indexOf('00') === 0) digits = digits.slice(2); // international prefix
  else if (digits.length === 11 && digits.charAt(0) === '0') digits = digits.slice(1); // Indian trunk prefix
  if (digits.length === 10) digits = '91' + digits;
  if (digits.length < 11 || digits.length > 15 || digits.charAt(0) === '0') throw new HttpError_(400, 'bad_phone');
  return '+' + digits;
}

// After ATTEMPT_LIMIT_ failures for one key (a phone number, the teacher code, a user entering a group code) within
// the window, that key is refused until the window has passed. Kept in CacheService: an eviction only forgets recent
// failures. Callers hold the script lock.

function attempts_(key) {
  const raw = cache_().get('fail:' + key);
  const now = Date.now();
  return (raw ? JSON.parse(raw) : []).filter((t) => now - t < ATTEMPT_WINDOW_S_ * 1000);
}

function attemptsBlocked_(key) {
  return attempts_(key).length >= ATTEMPT_LIMIT_;
}

function attemptsFail_(key) {
  const list = attempts_(key);
  list.push(Date.now());
  cache_().put('fail:' + key, JSON.stringify(list), ATTEMPT_WINDOW_S_);
}

function attemptsClear_(key) {
  cache_().remove('fail:' + key);
}

// ---------- who is asking ----------

function currentUser_(ctx) {
  if (ctx._user) return ctx._user;
  if (!ctx.token) throw new HttpError_(401, 'signed_out');
  const hash = sha256Hex_(ctx.token);
  const key = cacheKey_('t:' + hash);
  let userId = cacheGet_(key);
  if (userId === null || userId === undefined) {
    const row = ctx.db.t('tokens').rows.filter((r) => r.token_hash === hash)[0];
    if (!row) throw new HttpError_(401, 'signed_out');
    userId = String(row.user_id);
    cachePut_(key, userId);
  }
  const user = ctx.db.t('users').rows.filter((u) => u.id === Number(userId))[0];
  if (!user) throw new HttpError_(401, 'signed_out');
  ctx._user = user;
  return user;
}

function teacher_(ctx) {
  const user = currentUser_(ctx);
  if (user.role !== 'teacher') throw new HttpError_(403, 'teacher_only');
  return user;
}

/** An approved student, or the teacher. */
function member_(ctx) {
  const user = currentUser_(ctx);
  if (user.role === 'student' && user.status !== 'approved') throw new HttpError_(403, 'pending');
  return user;
}

/** Under the lock: a new login token for `user`. */
function signIn_(ctx, user) {
  const token = newToken_();
  ctx.db.t('tokens').insert([{ token_hash: sha256Hex_(token), user_id: user.id, created_at: ctx.now }]);
  return { token: token, user: userJson_(user) };
}

function userJson_(u) {
  return { id: u.id, name: u.name, phone: u.phone, role: u.role, status: u.status, lang: u.lang, batch: u.batch || null,
    batch_since: u.batch_since ? isoTime_(u.batch_since) : null };
}

// ---------- Studio: the classes, the weekly rhythm in India time, and the sums over check-ins ----------

const IST_OFFSET_MS_ = 330 * 60000; // India is UTC+5:30 all year
const DAY_MS_ = 86400000;
const DAYS_ = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
const WEEKDAY_NAMES_ = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const MONTH_NAMES_ = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const CHECKIN_BEFORE_MIN_ = 60; // how early before class the "before" check-in opens
const MEET_LINK_ = /^https:\/\/(meet\.google\.com\/[a-z]{3}-[a-z]{4}-[a-z]{3}|([\w-]+\.)?zoom\.us\/j\/\d+(\?pwd=[\w.-]+)?)$/;
const GROUP_LINK_ = /^https:\/\/chat\.whatsapp\.com\/[A-Za-z0-9]+$/;

/** UTC ISO-8601 to the second: "2026-11-18T02:30:00Z". */
function isoTime_(ms) {
  return new Date(Math.floor(ms / 1000) * 1000).toISOString().replace('.000Z', 'Z');
}

/** The India date of a moment, as a day number (days since 1 Jan 1970). */
function istDay_(ms) {
  return Math.floor((ms + IST_OFFSET_MS_) / DAY_MS_);
}

/** Midnight in India of a day number, as milliseconds. */
function istMidnight_(day) {
  return day * DAY_MS_ - IST_OFFSET_MS_;
}

function istParts_(ms) {
  const d = new Date(ms + IST_OFFSET_MS_);
  return { day: d.getUTCDate(), month: d.getUTCMonth(), weekday: (d.getUTCDay() + 6) % 7, hour: d.getUTCHours(), minute: d.getUTCMinutes() };
}

/** The India date of a moment as ISO 8601: "2026-11-16". */
function istDate_(ms) {
  return new Date(ms + IST_OFFSET_MS_).toISOString().slice(0, 10);
}

/** strftime("%-I:%M %p") in India time: "8:00 AM". */
function istClock_(ms) {
  const p = istParts_(ms);
  return (p.hour % 12 || 12) + ':' + (p.minute < 10 ? '0' : '') + p.minute + ' ' + (p.hour < 12 ? 'AM' : 'PM');
}

/** One language out of a {"en": ..., "hi": ..., "mr": ...} dict, falling back to English. */
function pick_(text, lang) {
  return text[lang] || text.en;
}

function cleanLink_(raw, pattern, detail) {
  let link = raw.trim();
  if (link.indexOf('https://') !== 0) link = 'https://' + (link.indexOf('http://') === 0 ? link.slice(7) : link);
  if (!pattern.test(link)) throw new HttpError_(400, detail);
  return link;
}

/** A Google Meet or Zoom link, with https:// added when it was left off; else 400 bad_meet_link. */
function cleanMeetLink_(raw) {
  return cleanLink_(raw, MEET_LINK_, 'bad_meet_link');
}

/** A WhatsApp group invite link, with https:// added when it was left off; else 400 bad_group_link. */
function cleanGroupLink_(raw) {
  return cleanLink_(raw, GROUP_LINK_, 'bad_group_link');
}

/** The batches, from the batches tab, by key: names and words in each language, the default curriculum, the days
 * ("mon"…), the start in minutes after midnight in India, the length and the everyday Meet link. */
function batches_(ctx) {
  const out = {};
  ctx.db.t('batches').rows.forEach((r) => {
    if (!r.key) return;
    out[r.key] = {
      key: r.key,
      name: { en: r.name, hi: r.name_hi || r.name, mr: r.name_mr || r.name },
      about: { en: r.about, hi: r.about_hi || r.about, mr: r.about_mr || r.about },
      curriculum: r.curriculum,
      days: String(r.days || '').split(',').map((d) => d.trim().toLowerCase().slice(0, 3)).filter((d) => DAYS_.indexOf(d) >= 0),
      start_min: startMinutes_(r.time),
      duration_min: r.duration_min || 55,
      meet_link: r.meet_link,
    };
  });
  return out;
}

/** "07:00" (or a time the owner typed, which Sheets keeps as a time of day) as minutes after midnight in India. */
function startMinutes_(time) {
  const text = String(time || '');
  const iso = /T(\d\d):(\d\d)/.exec(text); // a time-of-day cell, read back as a UTC moment
  if (iso) return (Number(iso[1]) * 60 + Number(iso[2]) + IST_OFFSET_MS_ / 60000) % 1440;
  const plain = /(\d{1,2})[:.](\d\d)/.exec(text);
  return plain ? Number(plain[1]) * 60 + Number(plain[2]) : 0;
}

/** A batch for the app, in `lang`: its key, name, words, days and start ("07:00"). */
function batchJson_(batch, key, lang) {
  if (!batch) return { key: key, name: key || '', about: '', days: [], time: null };
  const h = Math.floor(batch.start_min / 60);
  const m = batch.start_min % 60;
  return { key: batch.key, name: pick_(batch.name, lang), about: pick_(batch.about, lang), days: batch.days,
    time: (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m };
}

/** A session for the app. The link is shown only to approved members; without its own link a session uses its batch's
 * everyday link. */
function sessionJson_(row, lang, showLink, batches) {
  const batch = batches[row.batch];
  const link = row.meet_link || (batch && batch.meet_link);
  return {
    id: row.id,
    starts_at: isoTime_(row.starts_at),
    duration_min: row.duration_min,
    batch: batchJson_(batch, row.batch, lang),
    meet_link: showLink ? link || null : null,
    has_link: Boolean(link),
  };
}

function studioJson_(ctx, lang) {
  const teacher = STUDIO.teacher;
  const batches = batches_(ctx);
  return {
    name: pick_(STUDIO.name, lang),
    tagline: pick_(STUDIO.tagline, lang),
    since: STUDIO.since,
    teacher: { name: teacher.name, title: pick_(teacher.title, lang), bio: pick_(teacher.bio, lang) },
    batches: Object.keys(batches).map((key) => batchJson_(batches[key], key, lang)),
  };
}

/** Each batch's classes on its days, over the 7 days from `now`'s India date. */
function weekStarts_(now, batches) {
  const today = istDay_(now);
  const out = [];
  for (let offset = 0; offset < 7; offset++) {
    const day = today + offset;
    const weekday = DAYS_[(day + 3) % 7]; // 1 Jan 1970 was a Thursday
    Object.keys(batches).forEach((key) => {
      const b = batches[key];
      if (b.days.indexOf(weekday) >= 0) out.push({ batch: key, starts_at: istMidnight_(day) + b.start_min * 60000, duration_min: b.duration_min });
    });
  }
  return out;
}

/** Makes the next 7 days' classes match the batches: adds each one missing and removes one outside the schedule (after
 * the owner changed a batch's days or time) that has not begun and nobody has checked in to. Takes the lock only
 * when there is something to change. */
function ensureWeek_(ctx) {
  const wanted = weekStarts_(ctx.now, batches_(ctx));
  const keyOf = (r) => r.batch + '@' + r.starts_at;
  const want = {};
  wanted.forEach((w) => {
    want[keyOf(w)] = true;
  });
  const horizon = istMidnight_(istDay_(ctx.now) + 7);
  const changes = (table) => {
    const present = {};
    table.rows.forEach((r) => {
      present[keyOf(r)] = true;
    });
    const joined = {};
    ctx.db.t('checkins').rows.forEach((c) => {
      joined[c.session_id] = true;
    });
    return {
      missing: wanted.filter((w) => !present[keyOf(w)]),
      stale: table.rows.filter((r) => r.starts_at > ctx.now && r.starts_at < horizon && !want[keyOf(r)] && !joined[r.id]),
    };
  };
  let todo = changes(ctx.db.t('class_sessions'));
  if (!todo.missing.length && !todo.stale.length) return;
  ctx.lock(() => {
    const table = ctx.db.t('class_sessions');
    todo = changes(table);
    if (todo.stale.length) table.remove(todo.stale);
    let id = table.nextId();
    table.insert(todo.missing.map((w) => ({
      id: id++, batch: w.batch, starts_at: w.starts_at, duration_min: w.duration_min, meet_link: null, updated_at: ctx.now,
    })));
  });
}

/** Whether a class's after-class window is open at [now]: from 10 minutes before its end to 12 hours after it. */
function afterOpen_(session, now) {
  const end = session.starts_at + session.duration_min * 60000;
  return end - 10 * 60000 <= now && now <= end + 12 * 3600000;
}

/** Sessions that have not ended yet, soonest first: [batch]'s, or every batch's. */
function upcoming_(ctx, limit, batch) {
  ensureWeek_(ctx);
  const from = ctx.now - 2 * 3600000;
  return ctx.db.t('class_sessions').rows
    .filter((r) => (!batch || r.batch === batch) && r.starts_at >= from && r.starts_at + r.duration_min * 60000 > ctx.now)
    .sort((a, b) => a.starts_at - b.starts_at || String(a.batch).localeCompare(String(b.batch)))
    .slice(0, limit);
}

function sessionRow_(ctx, id) {
  const row = ctx.db.t('class_sessions').rows.filter((r) => r.id === id)[0];
  if (!row) throw new HttpError_(404, 'no_session');
  return row;
}

function sessionsById_(ctx) {
  const out = {};
  ctx.db.t('class_sessions').rows.forEach((r) => {
    out[r.id] = r;
  });
  return out;
}

/** The average mood change over (before, after) pairs of the given check-ins: [average or null, pairs]. */
function moodChange_(checkins) {
  const after = {};
  checkins.forEach((c) => {
    if (c.phase === 'after') after[c.user_id + ':' + c.session_id] = c.mood;
  });
  let sum = 0;
  let pairs = 0;
  checkins.forEach((c) => {
    const key = c.user_id + ':' + c.session_id;
    if (c.phase === 'before' && Object.prototype.hasOwnProperty.call(after, key)) {
      sum += after[key] - c.mood;
      pairs++;
    }
  });
  return [pairs ? sum / pairs : null, pairs];
}

/** Classes joined, the current run of consecutive days with a class, and the average mood change. */
function practiceStats_(ctx, userId) {
  const sessions = sessionsById_(ctx);
  const mine = ctx.db.t('checkins').rows.filter((c) => c.user_id === userId);
  const today = istDay_(ctx.now);
  const seen = {};
  mine.forEach((c) => {
    if (c.phase === 'before' && sessions[c.session_id]) seen[istDay_(sessions[c.session_id].starts_at)] = true;
  });
  // a check-in for a later class does not count yet
  const days = Object.keys(seen).map(Number).filter((d) => d <= today).sort((a, b) => b - a);
  let streak = 0;
  let expected = today;
  if (days.length && days[0] < expected) expected -= 1; // today's class may not have happened yet
  for (let i = 0; i < days.length; i++) {
    if (days[i] !== expected) break;
    streak++;
    expected--;
  }
  const [change, pairs] = moodChange_(mine);
  return { classes_joined: days.length, streak_days: streak, mood_change: change, mood_pairs: pairs };
}

/** Rounds to one decimal, a tie to the even digit as Python's round() does: 2.25 is 2.2 and 2.75 is 2.8. Among averages
 * of moods the only exact ties are the quarters. */
function round1_(x) {
  const tenths = x * 10;
  if (Number.isInteger(x * 4) && !Number.isInteger(x * 2)) {
    const low = Math.floor(tenths);
    return (low % 2 === 0 ? low : low + 1) / 10;
  }
  return Number(x.toFixed(1));
}

function average1_(values) {
  return values.length ? round1_(values.reduce((a, b) => a + b, 0) / values.length) : null;
}

/** The student's classes over the last `days` days (1 to 90), with the sums done: classes joined, average mood
 * before and after, and the same per class, class names in `lang`. */
function practiceSummary_(ctx, userId, days, lang) {
  days = Math.max(1, Math.min(days, 90));
  const sessions = sessionsById_(ctx);
  const batches = batches_(ctx);
  const mine = ctx.db.t('checkins').rows.filter((c) => c.user_id === userId);
  const afterBySession = {};
  mine.forEach((c) => {
    if (c.phase === 'after') afterBySession[c.session_id] = c.mood;
  });
  const from = ctx.now - days * DAY_MS_;
  const rows = mine
    .filter((c) => c.phase === 'before' && sessions[c.session_id])
    .map((c) => ({ session: sessions[c.session_id], before: c.mood,
      after: Object.prototype.hasOwnProperty.call(afterBySession, c.session_id) ? afterBySession[c.session_id] : null }))
    .filter((r) => r.session.starts_at >= from && r.session.starts_at <= ctx.now)
    .sort((a, b) => a.session.starts_at - b.session.starts_at);
  const classes = [];
  const byClass = {};
  const plan = sessionCurricula_(ctx);
  rows.forEach((r) => {
    const name = batchJson_(batches[r.session.batch], r.session.batch, lang).name;
    classes.push({ date: istDate_(r.session.starts_at), class: name, curriculum: plan[r.session.id], mood_before: r.before, mood_after: r.after });
    const entry = byClass[name] || (byClass[name] = { times: 0, before: [], after: [] });
    entry.times += 1;
    entry.before.push(r.before);
    if (r.after !== null) entry.after.push(r.after);
  });
  const summary = {};
  Object.keys(byClass).forEach((name) => {
    const e = byClass[name];
    summary[name] = { times: e.times, average_mood_before: average1_(e.before), average_mood_after: average1_(e.after) };
  });
  const library = curriculum_(ctx).library;
  const itemsBySolo = {};
  ctx.db.t('practice').rows.forEach((p) => {
    if (p.user_id === userId && p.solo_id !== null) (itemsBySolo[p.solo_id] || (itemsBySolo[p.solo_id] = [])).push(p);
  });
  const solo = ctx.db.t('solo_sessions').rows
    .filter((s) => s.user_id === userId && s.started_at >= from && s.started_at <= ctx.now)
    .sort((a, b) => a.started_at - b.started_at)
    .map((s) => ({ date: istDate_(s.started_at), minutes: Math.round((s.ended_at - s.started_at) / 60000),
      items: (itemsBySolo[s.id] || []).sort((a, b) => a.id - b.id).map((p) => itemTitle_(library[p.item], p.item, lang)) }));
  return {
    period_days: days,
    classes_joined: classes.length,
    mood_scale: '1 very low to 5 great',
    average_mood_before: average1_(rows.map((r) => r.before)),
    average_mood_after: average1_(rows.filter((r) => r.after !== null).map((r) => r.after)),
    by_class: summary,
    classes: classes,
    solo: solo,
  };
}

/** An item's name for people: transliterated in English, Devanagari in Hindi and Marathi. */
function itemTitle_(entry, key, lang) {
  if (!entry) return key;
  return lang === 'en' ? entry.name : entry.sanskrit;
}

/** The WhatsApp message for one session, its wa.me link, and the group to post it in. */
function shareFor_(ctx, row, lang) {
  const batch = batches_(ctx)[row.batch];
  const link = row.meet_link || (batch && batch.meet_link);
  if (!link) throw new HttpError_(400, 'no_link');
  const name = batchJson_(batch, row.batch, lang).name;
  const text = classMessage_(name, row.starts_at, row.duration_min, link, lang);
  return { text: text, url: shareUrl_(text), group_link: ctx.db.setting('group_link') };
}

// ---------- WhatsApp messages ----------
// The app never reads the WhatsApp group; the teacher posts from the app through Android's share sheet.

const TEXT_ = {
  class: {
    en: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} min)\n🔗 Join: {link}\n\nOpen the app to check in before class.',
    hi: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} मिनट)\n🔗 जुड़ें: {link}\n\nकक्षा से पहले ऐप में चेक-इन करें।',
    mr: '🧘 {studio} · {name}\n📅 {day}, {time} IST ({minutes} मिनिटे)\n🔗 सामील व्हा: {link}\n\nवर्गापूर्वी ॲपमध्ये चेक-इन करा.',
  },
  invite: {
    en: '🙏 Join {studio} in the app.\nSign up with your WhatsApp number and this group code: *{code}*',
    hi: '🙏 ऐप में {studio} से जुड़ें।\nअपने व्हाट्सऐप नंबर और इस ग्रुप कोड से साइन अप करें: *{code}*',
    mr: '🙏 ॲपमध्ये {studio} मध्ये सामील व्हा.\nतुमचा व्हॉट्सॲप नंबर आणि हा ग्रुप कोड वापरून साइन अप करा: *{code}*',
  },
};
const DAY_NAMES_ = {
  en: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
  hi: ['सोम', 'मंगल', 'बुध', 'गुरु', 'शुक्र', 'शनि', 'रवि'],
  mr: ['सोम', 'मंगळ', 'बुध', 'गुरु', 'शुक्र', 'शनि', 'रवि'],
};

function fill_(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, key) => (Object.prototype.hasOwnProperty.call(values, key) ? String(values[key]) : all));
}

function classMessage_(className, startsAt, minutes, link, lang) {
  const p = istParts_(startsAt);
  const day = DAY_NAMES_[lang][p.weekday] + ' ' + p.day + ' ' + MONTH_NAMES_[p.month];
  return fill_(pick_(TEXT_.class, lang), { studio: pick_(STUDIO.name, lang), name: className, day: day, time: istClock_(startsAt),
    minutes: minutes, link: link });
}

function inviteMessage_(code, lang) {
  return fill_(pick_(TEXT_.invite, lang), { studio: pick_(STUDIO.name, lang), code: code });
}

/** A wa.me link that opens WhatsApp with `text` ready to send: every character but letters, digits and _.-~/ escaped. */
function shareUrl_(text) {
  const quoted = encodeURIComponent(text)
    .replace(/[!'()*]/g, (c) => '%' + c.charCodeAt(0).toString(16).toUpperCase())
    .replace(/%2F/g, '/');
  return 'https://wa.me/?text=' + quoted;
}

// ---------- Practice: the curriculum, each class's plan, how each item went, and each student's history ----------
// The curriculum lives in three tabs (library, curricula, curriculum_items), so the owner can change it in the Sheet.
// The teacher picks one curriculum per class; students react to its items after class, one tap each, and practise
// on their own with a stopwatch; the teacher reads each student's history per item and can write feedback on an
// item, which the student sees with it.

/** The curriculum as the Sheet holds it: the library by key, the curricula in tab order, each one's items in order. */
function curriculum_(ctx) {
  const library = {};
  ctx.db.t('library').rows.forEach((r) => {
    if (r.key) library[r.key] = r;
  });
  const items = {};
  ctx.db.t('curriculum_items').rows
    .filter((r) => r.curriculum && library[r.item])
    .sort((a, b) => a.position - b.position)
    .forEach((r) => {
      (items[r.curriculum] || (items[r.curriculum] = [])).push(r);
    });
  return { library: library, curricula: ctx.db.t('curricula').rows.filter((r) => r.key), items: items };
}

/** Each session's curriculum by session id: its own, else its batch's, else the first in the curricula tab. */
function sessionCurricula_(ctx) {
  const known = {};
  const keys = ctx.db.t('curricula').rows.filter((r) => r.key).map((r) => r.key);
  keys.forEach((k) => {
    known[k] = true;
  });
  const batches = batches_(ctx);
  const out = {};
  ctx.db.t('class_sessions').rows.forEach((r) => {
    const batch = batches[r.batch];
    out[r.id] = (known[r.curriculum] && r.curriculum) || (batch && known[batch.curriculum] && batch.curriculum) || keys[0] || null;
  });
  return out;
}

/** The library and the curricula in the student's language (the Devanagari names serve Hindi and Marathi). */
function curricula_(ctx) {
  currentUser_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const local = (row, col) => (query.lang === 'en' ? row[col] : row[col + '_' + query.lang]) || row[col];
  const c = curriculum_(ctx);
  return {
    library: Object.keys(c.library).map((key) => {
      const r = c.library[key];
      return { key: r.key, type: r.type, level: r.level, sanskrit: r.sanskrit, name: r.name, english: r.english,
        aliases: r.aliases.split(',').map((a) => a.trim()).filter((a) => a) };
    }),
    curricula: c.curricula.map((r) => ({
      key: r.key, name: local(r, 'name'), level: r.level, about: local(r, 'about'),
      items: (c.items[r.key] || []).map((i) => ({ item: i.item, dose: i.dose, unit: i.unit, cue: local(i, 'cue') })),
    })),
  };
}

function setCurriculum_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.curriculum });
  const row = sessionRow_(ctx, path.session_id);
  if (!ctx.db.t('curricula').rows.some((r) => r.key === body.curriculum)) throw new HttpError_(400, 'no_curriculum');
  ctx.db.t('class_sessions').update(row, { curriculum: body.curriculum, updated_at: ctx.now });
  return { ok: true, curriculum: body.curriculum };
}

/** After class, how each item went for this student. Open while the "after" check-in is; a second send replaces the
 * first. Entries with no reaction, no pain and no note are not kept. */
function sessionPractice_(ctx) {
  const user = currentUser_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.practice });
  if (user.status !== 'approved') throw new HttpError_(403, 'pending');
  const row = sessionRow_(ctx, path.session_id);
  const joined = ctx.db.t('checkins').rows.some((c) => c.user_id === user.id && c.session_id === row.id && c.phase === 'before');
  if (!joined || !afterOpen_(row, ctx.now)) throw new HttpError_(400, 'checkin_closed');
  const library = curriculum_(ctx).library;
  const kept = saidEntries_(body.entries, library);
  const table = ctx.db.t('practice');
  table.remove(table.rows.filter((r) => r.user_id === user.id && r.session_id === row.id));
  let id = table.nextId();
  table.insert(kept.map((e) => ({ id: id++, user_id: user.id, session_id: row.id, item: e.item, reaction: e.reaction, pain: e.pain,
    note: e.note, created_at: ctx.now, item_name: library[e.item].name, week: mondayOf_(row.starts_at) })));
  return { ok: true, saved: kept.length };
}

/** Practice on the student's own: each item with the stopwatch's seconds, how it went, strain or pain and a note. The
 * server dates it: the session ends now and began `minutes` ago. Items with nothing timed or said are not kept. */
function soloPractice_(ctx) {
  const user = member_(ctx);
  const { body } = ctx.check({ body: BODY_.solo });
  const library = curriculum_(ctx).library;
  const kept = saidEntries_(body.entries, library);
  if (!kept.length) throw new HttpError_(400, 'nothing_said');
  const started = ctx.now - body.minutes * 60000;
  const solo = ctx.db.t('solo_sessions');
  const row = solo.insert([{ id: solo.nextId(), user_id: user.id, started_at: started, ended_at: ctx.now }])[0];
  const table = ctx.db.t('practice');
  let id = table.nextId();
  table.insert(kept.map((e) => ({ id: id++, user_id: user.id, solo_id: row.id, item: e.item, hold_s: e.hold_s || null,
    reaction: e.reaction, pain: e.pain, note: e.note, created_at: ctx.now, item_name: library[e.item].name, week: mondayOf_(started) })));
  return { ok: true, id: row.id, saved: kept.length };
}

/** The entries worth keeping, one per item (the last wins), notes trimmed: those with a reaction, strain or pain, a
 * note or a timed hold. An item outside the library is 400 unknown_item. */
function saidEntries_(entries, library) {
  const byItem = {};
  entries.forEach((e) => {
    if (!library[e.item]) throw new HttpError_(400, 'unknown_item');
    byItem[e.item] = e;
  });
  return Object.keys(byItem).map((k) => byItem[k])
    .map((e) => Object.assign({}, e, { note: e.note === null ? null : e.note.trim() || null }))
    .filter((e) => e.reaction !== null || e.pain === 1 || e.note !== null || Boolean(e.hold_s));
}

/** The Monday (midnight in India) of the week a moment falls in. */
function mondayOf_(ms) {
  const day = istDay_(ms);
  return istMidnight_(day - ((day + 3) % 7));
}

/** How a class went, item by item, for the teacher: the reactions counted (not yet, with effort, steady, at ease),
 * items with strain or pain first, each with who and what they wrote, then the other notes. */
function classReview_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: PATH_SESSION_ });
  const row = sessionRow_(ctx, path.session_id);
  const names = {};
  ctx.db.t('users').rows.forEach((u) => {
    names[u.id] = u.name;
  });
  const plan = sessionCurricula_(ctx)[row.id];
  const entries = ctx.db.t('practice').rows.filter((r) => r.session_id === row.id).sort((a, b) => a.id - b.id);
  const order = (curriculum_(ctx).items[plan] || []).map((i) => i.item);
  entries.forEach((e) => {
    if (order.indexOf(e.item) < 0) order.push(e.item);
  });
  const items = order.map((item) => {
    const mine = entries.filter((e) => e.item === item);
    return {
      item: item,
      reactions: [1, 2, 3, 4].map((n) => mine.filter((e) => e.reaction === n).length),
      pain: mine.filter((e) => e.pain === 1).map((e) => ({ name: names[e.user_id], note: e.note })),
      notes: mine.filter((e) => e.pain !== 1 && e.note).map((e) => ({ name: names[e.user_id], text: e.note })),
    };
  });
  const answered = {};
  entries.forEach((e) => {
    answered[e.user_id] = true;
  });
  return {
    id: row.id,
    starts_at: isoTime_(row.starts_at),
    curriculum: plan,
    joined: ctx.db.t('checkins').rows.filter((c) => c.session_id === row.id && c.phase === 'before').length,
    answered: Object.keys(answered).length,
    items: items.filter((i) => i.pain.length).concat(items.filter((i) => !i.pain.length)),
  };
}

// ---------- each student's history per item, and the teacher's feedback on it ----------

/** How one student's practice of one item has gone, worked out in code from its rows: the times in class and on their
 * own, the reaction trend (the first reactions against the latest, up to three of each), the holds timed on their own,
 * strain or pain, the teacher's latest feedback, the student's notes, and every entry and piece of feedback, newest
 * first. [when] gives a row's moment: its class's start, or its solo session's. */
function itemProgress_(item, rows, feedback, when) {
  const entries = rows
    .map((r) => ({ at: when(r), solo: r.solo_id !== null, hold: r.hold_s, reaction: r.reaction, pain: r.pain === 1, note: r.note }))
    .filter((e) => e.at !== null)
    .sort((a, b) => a.at - b.at);
  const holds = entries.filter((e) => e.hold).map((e) => e.hold);
  const said = feedback.slice().sort((a, b) => a.created_at - b.created_at || a.id - b.id);
  const reactions = entries.filter((e) => e.reaction !== null).map((e) => e.reaction);
  const k = Math.min(3, Math.floor(reactions.length / 2));
  const pains = entries.filter((e) => e.pain);
  const latest = said[said.length - 1];
  return {
    item: item,
    in_class: entries.filter((e) => !e.solo).length,
    solo: entries.filter((e) => e.solo).length,
    first: entries.length ? istDate_(entries[0].at) : null,
    last: entries.length ? istDate_(entries[entries.length - 1].at) : null,
    reaction_trend: k ? { early_average: average1_(reactions.slice(0, k)), recent_average: average1_(reactions.slice(-k)), each: k } : null,
    holds: holds.length ? { recent_seconds: holds[holds.length - 1], longest_seconds: Math.max.apply(null, holds) } : null,
    strain_or_pain: { times: pains.length, last: pains.length ? istDate_(pains[pains.length - 1].at) : null },
    teacher_said: latest ? { date: istDate_(latest.created_at), text: latest.text } : null,
    your_notes: entries.filter((e) => e.note).slice(-5).map((e) => ({ date: istDate_(e.at), text: e.note })),
    entries: entries.slice().reverse().map((e) => ({ date: istDate_(e.at), kind: e.solo ? 'solo' : 'class', hold_s: e.hold,
      reaction: e.reaction, pain: e.pain ? 1 : 0, note: e.note })),
    feedback: said.slice().reverse().map((f) => ({ date: istDate_(f.created_at), text: f.text })),
  };
}

/** Each item one student has practised or had feedback on: {item: progress}. */
function progressByItem_(ctx, userId) {
  const rows = {};
  const feedback = {};
  ctx.db.t('practice').rows.forEach((r) => {
    if (r.user_id === userId) (rows[r.item] || (rows[r.item] = [])).push(r);
  });
  ctx.db.t('asana_feedback').rows.forEach((f) => {
    if (f.student_id === userId) (feedback[f.item] || (feedback[f.item] = [])).push(f);
  });
  const sessions = sessionsById_(ctx);
  const solos = {};
  ctx.db.t('solo_sessions').rows.forEach((s) => {
    if (s.user_id === userId) solos[s.id] = s;
  });
  const when = (r) => {
    const at = r.solo_id !== null ? solos[r.solo_id] && solos[r.solo_id].started_at : sessions[r.session_id] && sessions[r.session_id].starts_at;
    return at === undefined ? null : at;
  };
  const out = {};
  Object.keys(rows).concat(Object.keys(feedback)).forEach((item) => {
    if (!out[item]) out[item] = itemProgress_(item, rows[item] || [], feedback[item] || [], when);
  });
  return out;
}

/** For the Practice tab: each item with its counts and trend. What needs attention comes first: items with strain or
 * pain, then those the teacher wrote on (the latest first), then the rest, the most practised first. */
function itemList_(ctx, userId) {
  const all = progressByItem_(ctx, userId);
  return {
    items: Object.keys(all).map((item) => {
      const p = all[item];
      return { item: item, in_class: p.in_class, solo: p.solo, last: p.last, reaction_trend: p.reaction_trend,
        pain_times: p.strain_or_pain.times, teacher_said: p.teacher_said ? p.teacher_said.date : null };
    }).sort((a, b) => (b.pain_times > 0) - (a.pain_times > 0) || (b.teacher_said || '').localeCompare(a.teacher_said || '') ||
      b.in_class + b.solo - a.in_class - a.solo || a.item.localeCompare(b.item)),
  };
}

function oneItem_(ctx, userId, item) {
  return progressByItem_(ctx, userId)[item] || itemProgress_(item, [], [], () => null);
}

/** The student the teacher asks about, or 404 no_student. */
function studentRow_(ctx, id) {
  const student = ctx.db.t('users').rows.filter((u) => u.id === id && u.role === 'student')[0];
  if (!student) throw new HttpError_(404, 'no_student');
  return student;
}

function myItems_(ctx) {
  return itemList_(ctx, member_(ctx).id);
}

function myItem_(ctx) {
  const user = member_(ctx);
  const { path } = ctx.check({ path: PATH_ITEM_ });
  return oneItem_(ctx, user.id, path.item);
}

function studentItems_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: PATH_USER_ });
  return itemList_(ctx, studentRow_(ctx, path.user_id).id);
}

function studentItem_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: Object.assign({}, PATH_USER_, PATH_ITEM_) });
  return oneItem_(ctx, studentRow_(ctx, path.user_id).id, path.item);
}

/** The teacher's word to one student about one item; the student sees it with that item's history. */
function itemFeedback_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.itemFeedback });
  const student = studentRow_(ctx, path.user_id);
  if (!curriculum_(ctx).library[body.item]) throw new HttpError_(400, 'unknown_item');
  const table = ctx.db.t('asana_feedback');
  const row = table.insert([{ id: table.nextId(), student_id: student.id, item: body.item, text: body.text.trim(), created_at: ctx.now }])[0];
  return { ok: true, id: row.id };
}

// ---------- Intake: a student's answers about themselves, for the teacher to place them in a batch ----------
// Age, height, weight, food habits, pain or conditions, and a self-assessment of a few asanas (in content/studio.json).
// Health data: only the student and the teacher read it, its tabs are hidden, and the Dashboard shows it only as
// counts.

const PAIN_AREAS_ = ['knee', 'back', 'neck', 'shoulder', 'hip', 'other'];

/** A student's intake for the app, with the batch it points to; null before they fill it. */
function intakeOf_(ctx, userId) {
  const row = ctx.db.t('intake').rows.filter((r) => r.user_id === userId)[0];
  if (!row) return null;
  const ratings = ctx.db.t('intake_ratings').rows.filter((r) => r.user_id === userId)
    .map((r) => ({ item: r.item, reaction: r.reaction, pain: r.pain }));
  const pain = painAreas_(row.pain);
  return {
    age: row.age, height_cm: row.height_cm, weight_kg: row.weight_kg, food: row.food, meals: row.meals, pain: pain, pain_note: row.pain_note,
    ratings: ratings, updated_at: isoTime_(row.updated_at), suggested_batch: suggestedBatch_(ctx, pain, ratings),
  };
}

function painAreas_(text) {
  return String(text || '').split(',').map((a) => a.trim().toLowerCase()).filter((a) => a);
}

/** The batch the answers point to, for the teacher to confirm: any pain, Pain management; most of the
 * self-assessment steady or at ease (four or more answered), Intermediate; else Beginner. Never Advanced, which is
 * the teacher's call. The first batch when the owner has renamed these. */
function suggestedBatch_(ctx, pain, ratings) {
  const batches = batches_(ctx);
  const said = ratings.filter((r) => r.reaction !== null);
  const easy = said.filter((r) => r.reaction >= 3).length;
  const key = pain.length || ratings.some((r) => r.pain === 1) ? 'pain_management'
    : said.length >= 4 && easy * 2 > said.length ? 'intermediate' : 'beginner';
  return batches[key] ? key : Object.keys(batches)[0] || null;
}

function myIntake_(ctx) {
  return { intake: intakeOf_(ctx, currentUser_(ctx).id) };
}

/** A student's intake, after sign-up (pending) or later from Me; a second send replaces the first. */
function saveIntake_(ctx) {
  const user = currentUser_(ctx);
  if (user.role !== 'student') throw new HttpError_(403, 'students_only');
  const { body } = ctx.check({ body: BODY_.intake });
  const pain = painAreas_(body.pain);
  if (pain.some((a) => PAIN_AREAS_.indexOf(a) < 0)) throw new HttpError_(400, 'bad_pain_area');
  const asked = STUDIO.intake.assessment.map((a) => a.item);
  const byItem = {};
  body.ratings.forEach((r) => {
    if (asked.indexOf(r.item) < 0) throw new HttpError_(400, 'unknown_item');
    byItem[r.item] = r;
  });
  const trimmed = (text) => (text === null ? null : text.trim() || null);
  const values = { age: body.age, height_cm: body.height_cm, weight_kg: body.weight_kg, food: body.food, meals: trimmed(body.meals),
    pain: pain.join(', ') || null, pain_note: trimmed(body.pain_note), updated_at: ctx.now };
  const table = ctx.db.t('intake');
  const row = table.rows.filter((r) => r.user_id === user.id)[0];
  if (row) table.update(row, values);
  else table.insert([Object.assign({ user_id: user.id }, values)]);
  const ratings = ctx.db.t('intake_ratings');
  ratings.remove(ratings.rows.filter((r) => r.user_id === user.id));
  ratings.insert(Object.keys(byItem).map((k) => byItem[k]).filter((r) => r.reaction !== null || r.pain === 1)
    .map((r) => ({ user_id: user.id, item: r.item, reaction: r.reaction, pain: r.pain })));
  return { intake: intakeOf_(ctx, user.id) };
}

// ---------- Routes: one function per route ----------
// Each checks who is asking first, then the inputs, then the rules: a signed-out request is a 401 whatever its inputs,
// and a bad input is a 422 before any rule is applied. Routes marked LOCK_ in routes_() run entirely under the script
// lock; the others take it only around their writes, so a slow password hash never holds up everyone else.

// ---------- public ----------

function health_() {
  // The assistant runs on the phone; this server has none.
  return { ok: true, assistant: 'off', model: null };
}

function studio_(ctx) {
  const { query } = ctx.check({ query: QUERY_LANG_ });
  return studioJson_(ctx, query.lang);
}

function signup_(ctx) {
  const { body } = ctx.check({ body: BODY_.signup });
  const phone = normalizePhone_(body.phone);
  const code = body.code.trim().toUpperCase();
  const hasTeacher = () => ctx.db.t('users').rows.some((u) => u.role === 'teacher');
  let status;
  // The quick refusals come first, before the slow password hash; the lock below checks again.
  if (body.role === 'teacher') {
    if (hasTeacher()) throw new HttpError_(409, 'teacher_exists'); // one teacher per studio: the code works once
    ctx.lock(() => {
      if (attemptsBlocked_('login:teacher-code')) throw new HttpError_(429, 'too_many_attempts');
      if (!codeMatches_(ctx, code, 'teacher_code')) {
        attemptsFail_('login:teacher-code');
        throw new HttpError_(400, 'bad_teacher_code');
      }
    }, true);
    status = 'approved';
  } else {
    // The group code, from the class's WhatsApp invite, keeps sign-ups to the class; the teacher then places each
    // student in a batch.
    const key = 'group-code:' + phone;
    if (attemptsBlocked_(key)) throw new HttpError_(429, 'too_many_attempts');
    if (!codeMatches_(ctx, code, 'group_code')) {
      attemptsFail_(key);
      throw new HttpError_(400, 'bad_group_code');
    }
    status = 'pending';
  }
  if (ctx.db.t('users').rows.some((u) => u.phone === phone)) throw new HttpError_(409, 'phone_taken');
  const pwHash = hashPassword_(body.password);
  return ctx.lock(() => {
    const users = ctx.db.t('users');
    if (body.role === 'teacher' && hasTeacher()) throw new HttpError_(409, 'teacher_exists');
    if (users.rows.some((u) => u.phone === phone)) throw new HttpError_(409, 'phone_taken');
    const user = users.insert([{
      id: users.nextId(), name: body.name.trim(), phone: phone, role: body.role, status: status, pw_hash: pwHash,
      lang: body.lang, created_at: ctx.now,
    }])[0];
    return signIn_(ctx, user);
  });
}

/** Teacher and group codes are compared in capitals, so "ramit2024" and "RAMIT2024" are the same code. */
function codeMatches_(ctx, code, key) {
  const want = (ctx.db.setting(key) || '').trim().toUpperCase();
  return want !== '' && code === want;
}

function login_(ctx) {
  const { body } = ctx.check({ body: BODY_.login });
  const phone = normalizePhone_(body.phone);
  const key = 'login:' + phone;
  // Counted as a failure until the password proves right, so parallel guesses cannot slip past the limit.
  ctx.lock(() => {
    if (attemptsBlocked_(key)) throw new HttpError_(429, 'too_many_attempts');
    attemptsFail_(key);
  }, true);
  const user = ctx.db.t('users').rows.filter((u) => u.phone === phone)[0];
  const ok = checkPassword_(body.password, user ? user.pw_hash : DUMMY_HASH_); // the same work for an unknown number
  if (!user || !ok) throw new HttpError_(401, 'bad_login');
  return ctx.lock(() => {
    attemptsClear_(key);
    return signIn_(ctx, user);
  });
}

// ---------- signed in ----------

function logout_(ctx) {
  if (ctx.token) {
    const hash = sha256Hex_(ctx.token);
    const mine = (table) => table.rows.filter((r) => r.token_hash === hash);
    if (mine(ctx.db.t('tokens')).length) {
      ctx.lock(() => {
        const tokens = ctx.db.t('tokens');
        tokens.remove(mine(tokens));
        ctx.db.changedCache = true;
      });
    }
  }
  return { ok: true };
}

function me_(ctx) {
  const user = currentUser_(ctx);
  return { user: userJson_(user), stats: practiceStats_(ctx, user.id) };
}

function updateMe_(ctx) {
  const user = currentUser_(ctx);
  const { body } = ctx.check({ body: BODY_.me });
  const changes = {};
  if (body.name !== null) changes.name = body.name.trim();
  if (body.lang !== null) changes.lang = body.lang;
  ctx.db.t('users').update(user, changes);
  return { user: userJson_(user) };
}

/** A pending student who later gets the group code from the WhatsApp group is approved at once. */
/** What the get_my_practice tool on the phone hands Gemma: this student's classes over the last `days` days. */
function myPractice_(ctx) {
  const user = member_(ctx);
  const { query } = ctx.check({ query: { days: F_.int({ def: 7 }), lang: QUERY_LANG_.lang } });
  return practiceSummary_(ctx, user.id, query.days, query.lang);
}

/** One note the student chose to share with the teacher. Sharing the same words again returns the same note. */
function shareNote_(ctx) {
  const user = member_(ctx);
  const { body } = ctx.check({ body: BODY_.shared });
  if (user.role !== 'student') throw new HttpError_(403, 'pending');
  const text = body.text.trim();
  if (!text) throw new HttpError_(422, 'empty_note');
  const notes = ctx.db.t('shared_notes');
  let row = notes.rows.filter((n) => n.user_id === user.id && n.text === text)[0];
  if (!row) row = notes.insert([{ id: notes.nextId(), user_id: user.id, text: text, created_at: ctx.now }])[0];
  return { ok: true, id: row.id };
}

/** Everything the student's Today screen needs in one call. */
function home_(ctx) {
  const user = currentUser_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const lang = query.lang;
  const member = user.status === 'approved';
  const batches = batches_(ctx);
  const checkins = ctx.db.t('checkins').rows.filter((c) => c.user_id === user.id);
  const joined = {};
  const answered = {};
  checkins.forEach((c) => {
    if (c.phase === 'before') joined[c.session_id] = true;
    else answered[c.session_id] = true;
  });
  ctx.db.t('practice').rows.forEach((p) => {
    if (p.user_id === user.id) answered[p.session_id] = true;
  });
  const plan = sessionCurricula_(ctx);
  // A student sees only their batch's classes, once placed.
  const sessions = (member && user.batch ? upcoming_(ctx, 7, user.batch) : []).map((r) => {
    const s = sessionJson_(r, lang, member, batches);
    s.checked_in = Boolean(joined[r.id]);
    s.curriculum = plan[r.id];
    return s;
  });
  // The last class this person joined whose after-class window is open, with what they have said about it so far
  // (null before they answer), so they can say it or change it.
  const byId = sessionsById_(ctx);
  const open = Object.keys(joined)
    .map((id) => byId[id])
    .filter((s) => s && afterOpen_(s, ctx.now))
    .sort((a, b) => b.starts_at - a.starts_at)[0];
  let after = null;
  if (open) {
    after = sessionJson_(open, lang, false, batches);
    after.curriculum = plan[open.id];
    const mood = checkins.filter((c) => c.session_id === open.id && c.phase === 'after').map((c) => c.mood)[0];
    after.said = !answered[open.id] ? null : {
      mood: mood === undefined ? null : mood,
      items: ctx.db.t('practice').rows.filter((p) => p.user_id === user.id && p.session_id === open.id)
        .map((p) => ({ item: p.item, reaction: p.reaction, pain: p.pain, note: p.note })),
    };
  }
  return {
    user: userJson_(user),
    batch: user.batch ? batchJson_(batches[user.batch], user.batch, lang) : null,
    studio: studioJson_(ctx, lang),
    sessions: sessions,
    after_checkin: after,
    group_link: member ? ctx.db.setting('group_link') : null,
  };
}

function checkin_(ctx) {
  const user = currentUser_(ctx);
  const { path, body } = ctx.check({ path: PATH_SESSION_, body: BODY_.checkin });
  if (user.status !== 'approved') throw new HttpError_(403, 'pending');
  const row = sessionRow_(ctx, path.session_id);
  if (user.role === 'student' && row.batch !== user.batch) throw new HttpError_(403, 'other_batch');
  const start = row.starts_at;
  const end = start + row.duration_min * 60000;
  const now = ctx.now;
  const checkins = ctx.db.t('checkins');
  const mine = (phase) => checkins.rows.filter((c) => c.user_id === user.id && c.session_id === row.id && c.phase === phase)[0];
  let open;
  if (body.phase === 'before') {
    open = start - CHECKIN_BEFORE_MIN_ * 60000 <= now && now <= end;
  } else {
    open = Boolean(mine('before')) && afterOpen_(row, now);
  }
  if (!open) throw new HttpError_(400, 'checkin_closed');
  const existing = mine(body.phase);
  if (existing) {
    checkins.update(existing, { mood: body.mood });
  } else {
    checkins.insert([{ user_id: user.id, session_id: row.id, phase: body.phase, mood: body.mood, created_at: now,
      class: batchJson_(batches_(ctx)[row.batch], row.batch, 'en').name, class_date: istMidnight_(istDay_(start)) }]);
  }
  return { ok: true, stats: practiceStats_(ctx, user.id) };
}

function feedback_(ctx) {
  const user = currentUser_(ctx);
  const { body } = ctx.check({ body: BODY_.feedback });
  const table = ctx.db.t('feedback');
  table.insert([{ id: table.nextId(), user_id: user.id, screen: body.screen, text: body.text.trim(), created_at: ctx.now }]);
  return { ok: true };
}

// ---------- teacher ----------

/** The teacher's day: the classes of the next day that has some left (today, or tomorrow once today's are over),
 * every batch's, each with its curriculum and link; the batches with their everyday links; the settings. */
function teacherHome_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const batches = batches_(ctx);
  const joined = {};
  ctx.db.t('checkins').rows.forEach((c) => {
    if (c.phase === 'before') joined[c.session_id] = (joined[c.session_id] || 0) + 1;
  });
  const plan = sessionCurricula_(ctx);
  const ahead = upcoming_(ctx, 100);
  const day = ahead.length ? istDay_(ahead[0].starts_at) : null;
  const sessions = ahead.filter((r) => istDay_(r.starts_at) === day).map((r) => {
    const s = sessionJson_(r, query.lang, true, batches);
    s.own_link = r.meet_link !== null && r.meet_link !== '';
    s.joined = joined[r.id] || 0;
    s.curriculum = plan[r.id];
    return s;
  });
  return {
    sessions: sessions,
    batches: Object.keys(batches).map((key) => Object.assign(batchJson_(batches[key], key, query.lang), { meet_link: batches[key].meet_link })),
    settings: { group_link: ctx.db.setting('group_link'), group_code: ctx.db.setting('group_code') },
    pending_students: ctx.db.t('users').rows.filter((u) => u.status === 'pending').length,
  };
}

/** A batch's everyday Meet link, for its classes without their own. */
function setBatchLink_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_BATCH_, body: BODY_.link });
  const row = ctx.db.t('batches').rows.filter((r) => r.key === path.key)[0];
  if (!row) throw new HttpError_(404, 'no_batch');
  ctx.db.t('batches').update(row, { meet_link: cleanMeetLink_(body.meet_link) });
  return { ok: true, meet_link: row.meet_link };
}

function setLink_(ctx) {
  teacher_(ctx);
  const { path, query, body } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_, body: BODY_.link });
  const row = sessionRow_(ctx, path.session_id);
  const link = cleanMeetLink_(body.meet_link);
  ctx.db.t('class_sessions').update(row, { meet_link: link, updated_at: ctx.now });
  return shareFor_(ctx, row, query.lang);
}

function share_(ctx) {
  teacher_(ctx);
  const { path, query } = ctx.check({ path: PATH_SESSION_, query: QUERY_LANG_ });
  return shareFor_(ctx, sessionRow_(ctx, path.session_id), query.lang);
}

function updateSettings_(ctx) {
  teacher_(ctx);
  const { body } = ctx.check({ body: BODY_.settings });
  // Check both before saving either, so a bad link never leaves the other half-saved.
  if (body.group_link !== null) ctx.db.setSetting('group_link', cleanGroupLink_(body.group_link));
  return { group_link: ctx.db.setting('group_link'), group_code: ctx.db.setting('group_code') };
}

function rotateGroupCode_(ctx) {
  teacher_(ctx);
  ctx.db.setSetting('group_code', newCode_());
  return { group_code: ctx.db.setting('group_code') };
}

function invite_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const text = inviteMessage_(ctx.db.setting('group_code'), query.lang);
  return { text: text, url: shareUrl_(text), group_link: ctx.db.setting('group_link') };
}

function students_(ctx) {
  teacher_(ctx);
  const joined = {};
  ctx.db.t('checkins').rows.forEach((c) => {
    if (c.phase === 'before') joined[c.user_id] = (joined[c.user_id] || 0) + 1;
  });
  const rows = ctx.db.t('users').rows
    .filter((u) => u.role === 'student')
    .sort((a, b) => (b.status === 'pending') - (a.status === 'pending') || b.created_at - a.created_at || a.id - b.id);
  return { students: rows.map((u) => Object.assign(userJson_(u), { joined: joined[u.id] || 0, created_at: isoTime_(u.created_at),
    intake: intakeOf_(ctx, u.id) })) };
}

/** Removes a student, or takes a removed one back into their batch; placing a new student is placeInBatch_. */
function setStatus_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.status });
  const student = studentRow_(ctx, path.user_id);
  if (body.status === 'approved' && !student.batch) throw new HttpError_(400, 'needs_batch');
  ctx.db.t('users').update(student, { status: body.status });
  return { ok: true };
}

/** Places a student in a batch: a new one ("Approve into a batch"), or one moving after a review. Each is logged in
 * batch_changes, with the teacher's note. */
function placeInBatch_(ctx) {
  teacher_(ctx);
  const { path, body } = ctx.check({ path: PATH_USER_, body: BODY_.place });
  const student = studentRow_(ctx, path.user_id);
  if (!batches_(ctx)[body.batch]) throw new HttpError_(400, 'no_batch');
  const changes = ctx.db.t('batch_changes');
  changes.insert([{ id: changes.nextId(), student_id: student.id, from: student.batch || null, to: body.batch,
    note: body.note === null ? null : body.note.trim() || null, created_at: ctx.now }]);
  ctx.db.t('users').update(student, { batch: body.batch, batch_since: ctx.now, status: 'approved' });
  return { ok: true, student: userJson_(student) };
}

/** A new temporary password for a student who forgot theirs; the teacher passes it on in person or on WhatsApp.
 * Signs the student out everywhere. */
function resetPassword_(ctx) {
  teacher_(ctx);
  const { path } = ctx.check({ path: PATH_USER_ });
  const isStudent = (u) => u.id === path.user_id && u.role === 'student';
  if (!ctx.db.t('users').rows.some(isStudent)) throw new HttpError_(404, 'no_student');
  const password = newCode_(8);
  const pwHash = hashPassword_(password);
  return ctx.lock(() => {
    const users = ctx.db.t('users');
    const student = users.rows.filter(isStudent)[0];
    if (!student) throw new HttpError_(404, 'no_student');
    users.update(student, { pw_hash: pwHash });
    const tokens = ctx.db.t('tokens');
    tokens.remove(tokens.rows.filter((r) => r.user_id === student.id));
    ctx.db.changedCache = true;
    return { password: password };
  });
}

/** How the last two weeks of classes went, from the students' one-tap check-ins and feedback. */
function insights_(ctx) {
  teacher_(ctx);
  const { query } = ctx.check({ query: QUERY_LANG_ });
  const batches = batches_(ctx);
  const now = ctx.now;
  const checkins = ctx.db.t('checkins').rows;
  const bySession = {};
  checkins.forEach((c) => {
    (bySession[c.session_id] || (bySession[c.session_id] = [])).push(c);
  });
  const mean = (values) => (values.length ? values.reduce((a, b) => a + b, 0) / values.length : null);
  const sessions = ctx.db.t('class_sessions').rows
    .filter((s) => s.starts_at >= now - 14 * DAY_MS_ && s.starts_at <= now)
    .sort((a, b) => b.starts_at - a.starts_at)
    .map((s) => {
      const list = bySession[s.id] || [];
      const before = list.filter((c) => c.phase === 'before').map((c) => c.mood);
      const after = list.filter((c) => c.phase === 'after').map((c) => c.mood);
      return { id: s.id, starts_at: isoTime_(s.starts_at), class: batchJson_(batches[s.batch], s.batch, query.lang).name, joined: before.length,
        mood_before: mean(before), mood_after: mean(after), answered_after: after.length };
    });
  const [change, pairs] = moodChange_(checkins);
  const users = ctx.db.t('users').rows;
  const count = (status) => users.filter((u) => u.role === 'student' && u.status === status).length;
  const names = {};
  users.forEach((u) => {
    names[u.id] = u.name;
  });
  const feedback = ctx.db.t('feedback').rows
    .filter((f) => Object.prototype.hasOwnProperty.call(names, f.user_id))
    .sort((a, b) => b.created_at - a.created_at || a.id - b.id) // equal times in the order written
    .slice(0, 20)
    .map((f) => ({ screen: f.screen, text: f.text, created_at: isoTime_(f.created_at), name: names[f.user_id] }));
  return {
    students: { approved: count('approved'), pending: count('pending') },
    mood_change: change,
    mood_pairs: pairs,
    sessions: sessions,
    questions: { count: 0, gemma_latency_s: null }, // the assistant runs on the phone; questions never reach the server
    feedback: feedback,
  };
}

/** The notes students chose to share, newest first (the last 50). */
function sharedNotes_(ctx) {
  teacher_(ctx);
  const names = {};
  ctx.db.t('users').rows.forEach((u) => {
    names[u.id] = u.name;
  });
  const shared = ctx.db.t('shared_notes').rows
    .filter((n) => Object.prototype.hasOwnProperty.call(names, n.user_id))
    .sort((a, b) => b.created_at - a.created_at || b.id - a.id)
    .slice(0, 50)
    .map((n) => ({ id: n.id, user_id: n.user_id, name: names[n.user_id], text: n.text, created_at: isoTime_(n.created_at) }));
  return { shared: shared };
}

// ---------- Setup: the tabs, the codes and the Dashboard ----------
// Run setup() once from the script editor (it asks for permission the first time). Running it again is safe: it adds
// what is missing and leaves the data, the codes, the batches, the curriculum and an existing Dashboard alone.

const DATA_TABS_ = ['users', 'class_sessions', 'checkins', 'practice', 'solo_sessions', 'asana_feedback', 'batch_changes', 'intake',
  'intake_ratings', 'feedback', 'shared_notes', 'tokens', 'settings'];
const CURRICULUM_TABS_ = ['library', 'curricula', 'curriculum_items'];
const OWNER_TABS_ = ['batches'].concat(CURRICULUM_TABS_); // the owner's to edit: no warning on hand edits
const HIDDEN_TABS_ = ['intake', 'intake_ratings', 'tokens', 'settings']; // health answers, login-token hashes, the codes
const SETTING_NOTES_ = [
  ['teacher_code', 'The one-time code the teacher signs up with. It stops working once the teacher has an account.'],
  ['group_code', 'Students sign up with this code, from the class\'s WhatsApp invite; the teacher then places them in a batch. The teacher can change it in the app.'],
  ['group_link', 'The WhatsApp group invite link, set by the teacher in the app.'],
];
const TIME_FORMAT_ = 'yyyy-mm-dd hh:mm:ss';
const DATE_FORMAT_ = 'yyyy-mm-dd';

function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  let codes;
  try {
    ss.setSpreadsheetTimeZone('Asia/Kolkata');
    DATA_TABS_.concat(OWNER_TABS_).forEach((name) => ensureTab_(ss, name));
    seedBatches_(ss);
    seedCurriculum_(ss);
    codes = ensureSettings_(ss);
    if (!ss.getSheetByName('Dashboard')) writeDashboard_(ss);
    arrangeTabs_(ss);
    SpreadsheetApp.flush();
    bumpCacheGeneration_();
  } finally {
    lock.releaseLock();
  }
  const message = 'Set up. Teacher sign-up code: ' + codes.teacher_code + ' (for ' + STUDIO.teacher.short.en + ', used once). Group code: ' +
    codes.group_code + '. Both are kept in the hidden "settings" tab (View > Hidden sheets). ' +
    'Next: Deploy > New deployment > Web app, Execute as Me, Who has access Anyone.';
  Logger.log(message);
  return message;
}

/** A tab with its header row; columns the code needs and the tab lacks are added at the end. */
function ensureTab_(ss, name) {
  const columns = TABLES_[name];
  let sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  const width = Math.max(sheet.getLastColumn(), 1);
  const header = sheet.getRange(1, 1, 1, width).getValues()[0].map((h) => String(h).trim());
  const empty = header.every((h) => h === '');
  const missing = columns.map(([c]) => c).filter((c) => header.indexOf(c) < 0);
  if (missing.length) {
    const at = empty ? 1 : width + 1;
    if (at + missing.length - 1 > sheet.getMaxColumns()) sheet.insertColumnsAfter(sheet.getMaxColumns(), at + missing.length - 1 - sheet.getMaxColumns());
    sheet.getRange(1, at, 1, missing.length).setValues([missing]);
  }
  const names = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map((h) => String(h).trim());
  sheet.getRange(1, 1, 1, names.length).setFontWeight('bold');
  sheet.setFrozenRows(1);
  columns.forEach(([col, type]) => {
    if (type !== 'time' && type !== 'date') return;
    const rows = sheet.getMaxRows() - 1;
    if (rows > 0) sheet.getRange(2, names.indexOf(col) + 1, rows, 1).setNumberFormat(type === 'time' ? TIME_FORMAT_ : DATE_FORMAT_);
  });
  return sheet;
}

/** The batches tab, filled from content/studio.json while it is empty; after that the Sheet's rows are the batches. */
function seedBatches_(ss) {
  const table = new Table_(ss.getSheetByName('batches'), 'batches');
  if (table.rows.length) return;
  table.insert(STUDIO.batches.map((b) => ({ key: b.key, name: b.name.en, name_hi: b.name.hi, name_mr: b.name.mr, curriculum: b.curriculum,
    days: b.days.join(', '), time: b.time, duration_min: b.duration_min, meet_link: null, about: b.about.en, about_hi: b.about.hi,
    about_mr: b.about.mr })));
}

/** The curriculum tabs, filled from content/curriculum.json while they are empty, with "{teacher}" in its text
 * written as the studio names the teacher; after that the Sheet's rows are the curriculum. The curricula tab's first
 * cell notes where the mock curriculum comes from. */
function seedCurriculum_(ss) {
  const pick = (text) => LANGS_.map((lang) => fill_(text[lang], { teacher: STUDIO.teacher.short[lang] }));
  const rows = {
    library: CURRICULUM.library.map((i) => ({ key: i.key, type: i.type, level: i.level, sanskrit: i.sanskrit, name: i.name,
      english: i.english, aliases: i.aliases.join(', '), source: i.source })),
    curricula: CURRICULUM.curricula.map((c) => {
      const [name, nameHi, nameMr] = pick(c.name);
      const [about, aboutHi, aboutMr] = pick(c.about);
      return { key: c.key, name: name, name_hi: nameHi, name_mr: nameMr, level: c.level, about: about, about_hi: aboutHi,
        about_mr: aboutMr, source: c.source };
    }),
    curriculum_items: CURRICULUM.curricula.reduce((all, c) => all.concat(c.items.map((it, i) => {
      const [cue, cueHi, cueMr] = pick(it.cue);
      return { curriculum: c.key, position: i + 1, item: it.item, dose: it.dose, unit: it.unit, cue: cue, cue_hi: cueHi, cue_mr: cueMr };
    })), []),
  };
  CURRICULUM_TABS_.forEach((name) => {
    const table = new Table_(ss.getSheetByName(name), name);
    if (!table.rows.length) table.insert(rows[name]);
  });
  ss.getSheetByName('curricula').getRange(1, 1).setNote(fill_(CURRICULUM.about, { teacher: STUDIO.teacher.short.en }));
}

/** The teacher and group codes, made once, and a row (with a note) for each setting. */
function ensureSettings_(ss) {
  const sheet = ss.getSheetByName('settings');
  if (sheet.getRange(1, 3).getValue() === '') sheet.getRange(1, 3).setValue('about').setFontWeight('bold');
  const table = new Table_(sheet, 'settings');
  const have = {};
  table.rows.forEach((r) => {
    have[r.key] = r;
  });
  if (!have.teacher_code || !have.teacher_code.value) setRow_(table, have, 'teacher_code', newCode_(8));
  if (!have.group_code || !have.group_code.value) setRow_(table, have, 'group_code', newCode_());
  SETTING_NOTES_.forEach(([key, note]) => {
    if (!have[key]) setRow_(table, have, key, null);
    sheet.getRange(have[key]._row, 3).setValue(encode_(note, 'text'));
  });
  return { teacher_code: have.teacher_code.value, group_code: have.group_code.value };
}

function setRow_(table, have, key, value) {
  if (have[key]) table.update(have[key], { value: value });
  else have[key] = table.insert([{ key: key, value: value }])[0];
}

function arrangeTabs_(ss) {
  const ours = { Dashboard: true };
  DATA_TABS_.concat(OWNER_TABS_).forEach((name) => {
    ours[name] = true;
  });
  const dashboard = ss.getSheetByName('Dashboard');
  ss.setActiveSheet(dashboard);
  ss.moveActiveSheet(1);
  DATA_TABS_.forEach((name) => {
    const sheet = ss.getSheetByName(name);
    if (HIDDEN_TABS_.indexOf(name) >= 0) sheet.hideSheet();
    if (sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET).length === 0) {
      sheet.protect().setDescription('Written by the app: Sheets asks before a hand edit').setWarningOnly(true);
    }
  });
  ss.getSheets().forEach((sheet) => {
    if (!ours[sheet.getName()] && sheet.getLastRow() === 0 && sheet.getLastColumn() === 0) ss.deleteSheet(sheet); // the empty Sheet1
  });
}

/** Column letters of a tab by header name, as the tab is now. */
function columnLetters_(ss, name) {
  const sheet = ss.getSheetByName(name);
  const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const out = {};
  header.forEach((h, i) => {
    out[String(h).trim()] = columnLetter_(i + 1);
  });
  out._last = columnLetter_(header.length);
  return out;
}

function columnLetter_(n) {
  let s = '';
  while (n > 0) {
    const m = (n - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    n = Math.floor((n - 1) / 26);
  }
  return s;
}

/** The Dashboard's blocks: [the cell its formula starts in (the title goes above), title, note, formula, number formats]. */
function dashboardBlocks_(ss) {
  const u = columnLetters_(ss, 'users');
  const c = columnLetters_(ss, 'checkins');
  const f = columnLetters_(ss, 'feedback');
  const n = columnLetters_(ss, 'shared_notes');
  const p = columnLetters_(ss, 'practice');
  const m = columnLetters_(ss, 'batch_changes');
  const k = columnLetters_(ss, 'intake');
  const users = 'users!A1:' + u._last;
  const checkins = 'checkins!A1:' + c._last;
  const col = (tab, letter) => tab + '!' + letter + '2:' + letter;
  const names = '{' + col('users', u.id) + ', ' + col('users', u.name) + '}';
  const nameOf = (tab, letter) => 'ARRAYFORMULA(IFERROR(VLOOKUP(' + col(tab, letter) + ', ' + names + ', 2, FALSE), ""))';
  return [
    ['A5', 'Students by status', 'Students only, not the teacher.',
      '=IFERROR(QUERY(' + users + ', "select ' + u.status + ', count(' + u.id + ') where ' + u.role + " = 'student' group by " +
        u.status + ' label ' + u.status + " 'status', count(" + u.id + ") 'students'\", 1), \"No students yet\")", {}],
    ['H5', 'Students per batch', 'Approved students in each batch.',
      '=IFERROR(QUERY(' + users + ', "select ' + u.batch + ', count(' + u.id + ') where ' + u.role + " = 'student' and " + u.status +
        " = 'approved' group by " + u.batch + ' label ' + u.batch + " 'batch', count(" + u.id + ") 'students'\", 1), \"No students yet\")", {}],
    ['K5', 'Batch changes', 'The latest 8 placements and moves, newest first; the batch_changes tab has them all.',
      '=IFERROR(QUERY({' + [col('batch_changes', m.created_at), nameOf('batch_changes', m.student_id), col('batch_changes', m.from),
        col('batch_changes', m.to), col('batch_changes', m.note)].join(', ') + "}, \"select Col1, Col2, Col3, Col4, Col5 where Col1 is not " +
        "null order by Col1 desc limit 8 label Col1 'when', Col2 'student', Col3 'from', Col4 'to', Col5 'note'\", 0), \"No batch changes yet\")",
      { 'K6:K13': 'yyyy-mm-dd' }],
    ['Q5', 'Pain areas', 'How many students named each in their intake. Counts only: the answers themselves stay in the hidden tabs.',
      '=IFERROR(QUERY({' + PAIN_AREAS_.map((a) => '"' + a + '", COUNTIF(' + col('intake', k.pain) + ', "*' + a + '*")').join('; ') +
        "}, \"select Col1, Col2 label Col1 'pain area', Col2 'students'\", 0), \"No intake yet\")", {}],
    ['D5', 'Mood per class', 'Average mood after and before class, all classes so far. 1 very low to 5 great.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class + ', avg(' + c.mood + ') where ' + c.user_id + ' is not null group by ' +
        c.class + ' pivot ' + c.phase + '", 1), "No check-ins yet")', { 'E6:F13': '0.0' }],
    ['A16', 'Students', 'Every student, newest first, with their batch and the number of classes they checked in to.',
      '=IFERROR(QUERY({' + [col('users', u.name), col('users', u.phone), col('users', u.status), col('users', u.batch), col('users', u.lang),
        'ARRAYFORMULA(IF(' + col('users', u.id) + ' = "", , COUNTIFS(' + col('checkins', c.user_id) + ', ' + col('users', u.id) + ', ' +
          col('checkins', c.phase) + ', "before")))', col('users', u.created_at), col('users', u.role)].join(', ') +
        "}, \"select Col1, Col2, Col3, Col4, Col5, Col6, Col7 where Col8 = 'student' order by Col7 desc label Col1 'name', Col2 'phone', " +
        "Col3 'status', Col4 'batch', Col5 'language', Col6 'classes joined', Col7 'signed up'\", 0), \"No students yet\")", { 'G17:G': DATE_FORMAT_ }],
    ['H16', 'Attendance per class', 'Students who checked in before each class, newest first.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class_date + ', ' + c.class + ', count(' + c.user_id + ') where ' + c.phase +
        " = 'before' group by " + c.class_date + ', ' + c.class + ' order by ' + c.class_date + ' desc label count(' + c.user_id +
        ") 'joined'\", 1), \"No check-ins yet\")", { 'H17:H': 'ddd d mmm yyyy' }],
    ['L16', 'Mood by class and date', 'Average mood after and before each class, newest first.',
      '=IFERROR(QUERY(' + checkins + ', "select ' + c.class_date + ', ' + c.class + ', avg(' + c.mood + ') where ' + c.user_id +
        ' is not null group by ' + c.class_date + ', ' + c.class + ' pivot ' + c.phase + ' order by ' + c.class_date +
        ' desc", 1), "No check-ins yet")', { 'L17:L': 'ddd d mmm yyyy', 'N17:O': '0.0' }],
    ['Q16', 'Feedback', 'What students wrote from the app, newest first.',
      '=IFERROR(QUERY({' + [col('feedback', f.created_at), nameOf('feedback', f.user_id), col('feedback', f.screen),
        col('feedback', f.text)].join(', ') + "}, \"select Col1, Col2, Col3, Col4 where Col1 is not null order by Col1 desc " +
        "label Col1 'when', Col2 'student', Col3 'screen', Col4 'feedback'\", 0), \"No feedback yet\")", { 'Q17:Q': 'yyyy-mm-dd hh:mm' }],
    ['V16', 'Shared notes', 'Notes students chose to share with the teacher from the companion, newest first.',
      '=IFERROR(QUERY({' + [col('shared_notes', n.created_at), nameOf('shared_notes', n.user_id), col('shared_notes', n.text)].join(', ') +
        "}, \"select Col1, Col2, Col3 where Col1 is not null order by Col1 desc label Col1 'when', Col2 'student', Col3 'note'\", 0), " +
        '"No shared notes yet")', { 'V17:V': 'yyyy-mm-dd hh:mm' }],
    ['Z16', 'Strain or pain, last 14 days', 'Items a student marked "felt strain or pain", after class or on their own, newest first.',
      '=IFERROR(QUERY({' + [col('practice', p.created_at), nameOf('practice', p.user_id), col('practice', p.item_name),
        col('practice', p.note), col('practice', p.pain)].join(', ') + "}, \"select Col1, Col2, Col3, Col4 where Col5 = 1 and Col1 >= " +
        "datetime '\" & TEXT(TODAY() - 14, \"yyyy-mm-dd hh:mm:ss\") & \"' order by Col1 desc label Col1 'when', Col2 'student', " +
        "Col3 'item', Col4 'note'\", 0), \"No strain or pain in the last 14 days\")", { 'Z17:Z': 'yyyy-mm-dd hh:mm' }],
    ['AE16', 'Reactions per item, week by week', 'Average reaction, after class or on their own: 1 not yet, 2 with effort, 3 steady, 4 at ease. ' +
      'One column per week, headed by its Monday.',
      '=IFERROR(QUERY(practice!A1:' + p._last + ', "select ' + p.item_name + ', avg(' + p.reaction + ') where ' + p.reaction +
        ' is not null group by ' + p.item_name + ' pivot ' + p.week + '", 1), "No reactions yet")', { 'AF17:CB': '0.0', 'AF16:CB16': 'd mmm' }],
  ];
}

function writeDashboard_(ss) {
  const sheet = ss.insertSheet('Dashboard');
  if (sheet.getMaxColumns() < 80) sheet.insertColumnsAfter(sheet.getMaxColumns(), 80 - sheet.getMaxColumns());
  sheet.getRange('A1').setValue('Satt Chitt Anand: the studio at a glance').setFontWeight('bold').setFontSize(14);
  sheet.getRange('A2').setValue('Each block is one formula over the tabs; click its first cell to read or change it. Times are ' +
    'India time. Add blocks of your own anywhere: setup() never rewrites this tab (delete it and run setup again for a fresh one).');
  dashboardBlocks_(ss).forEach(([cell, title, note, formula, formats]) => {
    const anchor = sheet.getRange(cell);
    const row = anchor.getRow();
    const column = anchor.getColumn();
    sheet.getRange(row - 1, column).setValue(title).setFontWeight('bold');
    sheet.getRange(row - 1, column).setNote(note);
    sheet.getRange(row, column).setFormula(formula);
    Object.keys(formats).forEach((range) => sheet.getRange(range).setNumberFormat(formats[range]));
  });
}
